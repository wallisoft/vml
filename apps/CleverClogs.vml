# ============================================================================
# Scripts. Start runs when the form opens and holds everything the others share.
# ============================================================================

@Script Start
Interpreter=lua
<<LUA
json = require("dkjson")

-- What a thing can be, and how it's spoken of.
KINDS = {
  { key = "car", as = "a car",        label = "Car",            icon = "🚗", left = "Parked",         with = "You're with the car",  none = "Not parked yet",          here = "I've parked here" },
  { key = "desk", as = "your desk",       label = "Desk",           icon = "🖥", left = "Left your desk",  with = "At your desk",         none = "Not at your desk yet",    here = "I'm at my desk" },
  { key = "headphones", as = "headphones", label = "Headphones",     icon = "🎧", left = "Left",           with = "With you",             none = "Not left anywhere yet",   here = "I've left them here" },
  { key = "keys", as = "keys or a tag",       label = "Keys or tag",    icon = "🔑", left = "Left",           with = "With you",             none = "Not left anywhere yet",   here = "I've left them here" },
  { key = "bike", as = "a bike",       label = "Bike",           icon = "🚲", left = "Left",           with = "With you",             none = "Not left anywhere yet",   here = "I've left it here" },
  { key = "other", as = "something else",      label = "Something else", icon = "📍", left = "Left",           with = "With you",             none = "Not left anywhere yet",   here = "I've left it here" },
}
KIND = {}
for i, k in ipairs(KINDS) do k.index = i; KIND[k.key] = k end

-- A guess at what a device is, from its name (it can be changed on the Things tab).
GUESS = {
  { "car", { "car", "sync", "uconnect", "mylink", "carplay", "android auto", "ford", "vw", "volkswagen", "audi", "bmw", "mercedes",
             "toyota", "kia", "mazda", "nissan", "peugeot", "renault", "skoda", "seat", "volvo", "honda", "hyundai", "tesla",
             "mini", "vauxhall", "citroen", "fiat", "jeep", "lexus", "subaru", "suzuki", "mitsubishi", "porsche" } },
  { "desk", { "keyboard", "mouse", "desk", "pc", "laptop", "macbook", "imac", "dell", "lenovo", "thinkpad", "keychron",
              "logitech", "mx ", "surface", "monitor", "dock" } },
  { "headphones", { "buds", "airpods", "headphone", "earbud", "earphone", "jabra", "bose", "beats", "sony wh", "sony wf",
                    "wh-", "wf-", "soundcore", "pods" } },
  { "keys", { "tile", "tag", "chipolo", "nut", "key" } },
  { "bike", { "bike", "garmin", "wahoo", "cycle" } },
}
function Guess(name)
  local low = " " .. (name or ""):lower() .. " "
  for _, g in ipairs(GUESS) do
    for _, word in ipairs(g[2]) do if low:find(word, 1, true) then return g[1] end end
  end
  return "other"
end

Things = {}             -- what the phone watches: { address, name, kind }, kept between visits
Paired = {}             -- what Find last listed (not yet chosen)
History = {}            -- every connect and disconnect seen, oldest first: { d = address, w = "c"/"d", t, lat, lon, acc, p, n }
Spots = {}              -- places saved by hand: address (or "" for a place with no Bluetooth) -> { time, lat, lon, within, pressure }
Which = ""              -- the thing the Where tab is about ("": a place saved by hand)
WhichList = {}          -- cmbWhich's lines: the address each stands for
Picked = nil            -- the thing chosen on the Things tab
Tab = "Where"
DayShift = 0            -- the Time tab's day: 0 today, -1 yesterday...
Spot = nil              -- what the Where tab shows: time, lat, lon, within, pressure, how
Filling = false         -- true while a list is filled, so filling it doesn't count as choosing
GAP = 300               -- a break shorter than this (seconds) isn't leaving, when chkBreaks is ticked
KEEP_DAYS = 62          -- how far back the history goes

function Status(text) Vml("SetProperty", "lblStatus", "Text", text) end
function Kept(key) return Vml("GetSetting", key) or "" end
function Keep(key, value) Vml("SetSetting", key, value) end
function Show(names, on) for _, n in ipairs(names) do Vml("SetProperty", n, "IsVisible", tostring(on)) end end
function Clean(s) return (tostring(s or ""):gsub("%s*,%s*", " ")) end

function ThingOf(address)
  for i, t in ipairs(Things) do if t.address == address then return t, i end end
end
function KindOf(address)
  local t = ThingOf(address)
  return KIND[t and t.kind or "car"] or KIND.other
end
function Label(t) return (KIND[t.kind] or KIND.other).icon .. " " .. t.name end
function KeepThings() Keep("things", json.encode(Things)) end
function KeepSpots() Keep("spots", json.encode(Spots)) end

-- ── time, said the way a person would ──
function Ago(seconds)
  if seconds < 90 then return "just now" end
  if seconds < 3600 then return math.floor(seconds / 60 + 0.5) .. " minutes ago" end
  if seconds < 5400 then return "an hour ago" end
  if seconds < 86400 then return math.floor(seconds / 3600 + 0.5) .. " hours ago" end
  local days = math.floor(seconds / 86400)
  return days == 1 and "yesterday" or (days .. " days ago")
end
function Dur(seconds)                                   -- "3h 20m", "45m", "under a minute"
  local m = math.floor(seconds / 60 + 0.5)
  if m < 1 then return "under a minute" end
  if m < 60 then return m .. "m" end
  return math.floor(m / 60) .. "h " .. string.format("%02d", m % 60) .. "m"
end
function DayStart(t)
  local d = os.date("*t", t)
  return os.time({ year = d.year, month = d.month, day = d.day, hour = 0, min = 0, sec = 0 })
end
function NextDay(t)                                     -- (days aren't always 24 hours long: the clocks change)
  local d = os.date("*t", t)
  return os.time({ year = d.year, month = d.month, day = d.day + 1, hour = 0, min = 0, sec = 0 })
end
function WeekStart(t)                                   -- the Monday the week began
  local d = os.date("*t", t)
  return os.time({ year = d.year, month = d.month, day = d.day - (d.wday + 5) % 7, hour = 0, min = 0, sec = 0 })
end
DAYS = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" }
MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }
function DayName(t, shift)
  if shift == 0 then return "Today" end
  if shift == -1 then return "Yesterday" end
  local d = os.date("*t", t)
  return DAYS[d.wday] .. " " .. d.day .. " " .. MONTHS[d.month]
end

-- ── the history: the phone keeps its last few hundred notes; this keeps two months of them ──
function Harvest()
  local log = json.decode(Vml("BluetoothLog") or "") or {}
  if #log == 0 then return false end
  local have = {}
  for _, h in ipairs(History) do have[h.d .. h.w .. h.t] = true end
  local added = false
  for _, n in ipairs(log) do
    local w = n.what == "connected" and "c" or n.what == "disconnected" and "d" or nil
    if w and n.device and n.time and not have[n.device .. w .. n.time] then
      History[#History + 1] = { d = n.device, w = w, t = n.time, lat = n.latitude, lon = n.longitude, acc = n.accuracy,
                                p = n.pressure, n = n.name }
      have[n.device .. w .. n.time] = true
      added = true
    end
  end
  if not added then return false end
  table.sort(History, function(a, b) return a.t < b.t end)
  local cut = os.time() - KEEP_DAYS * 86400
  while History[1] and History[1].t < cut do table.remove(History, 1) end
  Keep("history", json.encode(History))
  return true
end

-- Where a thing is: the newest of the place saved by hand and the place the phone noted when it went out of
-- range. And has it come back into range since? Then it's with you.
function Latest(address)
  local spot, back = nil, nil
  local hand = Spots[address]
  if hand and hand.time then
    spot = { time = hand.time, lat = hand.lat, lon = hand.lon, within = hand.within, pressure = hand.pressure, how = "You saved it" }
  end
  if address ~= "" then
    local connected = nil
    for i = #History, 1, -1 do                         -- newest first
      local h = History[i]
      if h.d == address then
        if h.w == "c" then
          connected = connected or h.t
        else
          if not spot or h.t > spot.time then
            local t = ThingOf(address)
            spot = { time = h.t, lat = h.lat, lon = h.lon, within = h.acc, pressure = h.p,
                     how = "You left " .. (t and t.name or h.n or "it") }
          end
          if connected and connected > h.t then back = connected end
          break
        end
      end
    end
    if connected and not back and (not spot or connected > spot.time) then back = connected end
  end
  return spot, back
end

-- ── time with things: in range to out of range ──
function Sessions(address, merge)
  local out, open = {}, nil
  for _, h in ipairs(History) do
    if h.d == address then
      if h.w == "c" then
        open = open or h.t
      elseif open then
        out[#out + 1] = { s = open, e = h.t }
        open = nil
      end
    end
  end
  if open then out[#out + 1] = { s = open, e = os.time(), live = true } end
  if merge then                                           -- a cuppa isn't leaving your desk
    local joined = {}
    for _, s in ipairs(out) do
      local last = joined[#joined]
      if last and s.s - last.e < GAP then
        last.e, last.live = s.e, s.live
      else
        joined[#joined + 1] = { s = s.s, e = s.e, live = s.live }
      end
    end
    out = joined
  end
  return out
end

function Within(sessions, from, to)                     -- the pieces inside [from, to), and their total
  local pieces, total = {}, 0
  for _, s in ipairs(sessions) do
    local a, b = math.max(s.s, from), math.min(s.e, to)
    if b > a then
      pieces[#pieces + 1] = { s = a, e = b, live = s.live and s.e == b }
      total = total + (b - a)
    end
  end
  return pieces, total
end

function Merging() return Kept("breaks") ~= "off" end

-- ── tabs ──
WHERE = { "cmbWhich", "rectCard", "lblIcon", "lblWhen", "lblDetail", "btnGo", "btnShare", "btnHere", "btnPhoto", "txtNote", "imgBay" }
THINGS = { "lblThings", "lstThings", "cmbKind", "btnRename", "btnRemove", "lblAdd", "cmbAdd", "btnFind" }
TIME = { "btnPrev", "lblDay", "btnNext", "rectTotals", "lblTotals", "lstDay", "lblWeek", "chkBreaks", "btnCsv", "btnShareDay" }
function ShowTab(t)
  Tab = t
  for _, n in ipairs({ "Where", "Things", "Time" }) do
    Vml("SetProperty", "btnTab" .. n, "Background", n == t and "#EA580C" or "#FFFFFF")
    Vml("SetProperty", "btnTab" .. n, "Foreground", n == t and "#FFFFFF" or "#7C2D12")
    Vml("SetProperty", "btnTab" .. n, "BorderThickness", n == t and "0" or "1.5")
  end
  Show(WHERE, t == "Where"); Show(THINGS, t == "Things"); Show(TIME, t == "Time")
  if t == "Where" and #Things == 0 then Vml("SetProperty", "cmbWhich", "IsVisible", "false") end
  Vml("SetProperty", "lblTip", "IsVisible", tostring(t == "Where" and #Things == 0))
  Status("")
  Refresh()
end

function Refresh()
  if Tab == "Where" then RefreshWhere() elseif Tab == "Things" then RefreshThings() else RefreshTime() end
end

-- ── Where ──
function FillWhich()
  local lines = {}
  WhichList = {}
  for _, t in ipairs(Things) do lines[#lines + 1] = Clean(Label(t)); WhichList[#WhichList + 1] = t.address end
  lines[#lines + 1] = "📌 A place saved by hand"; WhichList[#WhichList + 1] = ""
  Filling = true
  Vml("SetProperty", "cmbWhich", "Items", table.concat(lines, ","))
  local at = #WhichList
  for i, a in ipairs(WhichList) do if a == Which then at = i end end
  Vml("SetProperty", "cmbWhich", "SelectedIndex", tostring(at - 1))
  Filling = false
  Vml("SetProperty", "cmbWhich", "IsVisible", tostring(Tab == "Where" and #Things > 0))
  Vml("SetProperty", "lblTip", "IsVisible", tostring(Tab == "Where" and #Things == 0))
end

function RefreshWhere()
  local kind = KindOf(Which)
  local t = ThingOf(Which)
  Vml("SetProperty", "btnHere", "Content", kind.here)
  Vml("SetProperty", "lblIcon", "Text", Which == "" and #Things > 0 and "📌" or kind.icon)
  Vml("SetProperty", "txtNote", "Text", Kept("note_" .. Which))
  local photo = Kept("photo_" .. Which)
  Vml("SetProperty", "imgBay", "Source", photo)
  local back
  Spot, back = Latest(Which)
  local can = Spot ~= nil and Spot.lat ~= nil and not (back and back > Spot.time)
  Vml("SetProperty", "btnGo", "IsEnabled", tostring(can))
  Vml("SetProperty", "btnShare", "IsEnabled", tostring(can))
  -- (a styled button keeps its colours when it's off: fade it, so nobody taps at nothing)
  Vml("SetProperty", "btnGo", "Background", can and "#EA580C" or "#F6E2CC")
  Vml("SetProperty", "btnGo", "Foreground", can and "#FFFFFF" or "#B9A086")
  Vml("SetProperty", "btnShare", "BorderBrush", can and "#EA580C" or "#F0DCC4")
  Vml("SetProperty", "btnShare", "Foreground", can and "#C2410C" or "#B9A086")
  if back and (not Spot or back > Spot.time) then
    Vml("SetProperty", "lblWhen", "Text", kind.with)
    Vml("SetProperty", "lblDetail", "Text", "The phone has been connected to " .. (t and t.name or "it") .. " since "
        .. os.date("%H:%M", back) .. (kind.key == "desk" and (": " .. Dur(os.time() - back) .. " so far.") or "."))
    return
  end
  if not Spot then
    Vml("SetProperty", "lblWhen", "Text", kind.none)
    Vml("SetProperty", "lblDetail", "Text", #Things == 0
        and "Press " .. kind.here .. " when you park. Or add your car on the Things tab, and it's noted for you."
        or (t and ("The phone notes where " .. t.name .. " is each time it goes out of range.")
            or "Press the button below to save where you are now."))
    return
  end
  local age = os.time() - Spot.time
  Vml("SetProperty", "lblWhen", "Text", kind.left .. " " .. Ago(age))
  local detail = Spot.how .. " at " .. os.date("%H:%M", Spot.time)
  if Spot.lat then
    detail = detail .. (Spot.within and (", within " .. math.floor(Spot.within) .. " m.") or ".")
  else
    detail = detail .. ", but the phone couldn't tell where."
  end
  -- The air is thinner higher up: about 0.12 hPa a metre, so a floor is about 0.36. The weather moves it too,
  -- so this is only trusted for a few hours.
  local now = tonumber(Vml("Pressure"))
  if now and Spot.pressure and age < 3 * 3600 then
    local floors = math.floor((Spot.pressure - now) / 0.36 + 0.5)
    if floors == 0 then
      detail = detail .. " You are on about the same level as it."
    else
      local n = math.abs(floors)
      detail = detail .. " You are about " .. n .. (n == 1 and " floor " or " floors ") .. (floors > 0 and "above" or "below") .. " it."
    end
  end
  Vml("SetProperty", "lblDetail", "Text", detail)
end

-- ── Things ──
function StateOf(t)
  local spot, back = Latest(t.address)
  if back and (not spot or back > spot.time) then return "with you" end
  if spot then return "left " .. Ago(os.time() - spot.time) end
  return "not seen yet"
end

function RefreshThings()
  Vml("SetProperty", "lblThings", "Text", #Things == 0
      and "Nothing yet. Press Find, then choose your car, headphones, desk keyboard... anything Bluetooth."
      or "When one goes out of range, the phone notes where it was. Tap one to change what it is.")
  local rows = {}
  for _, t in ipairs(Things) do
    rows[#rows + 1] = Clean(Label(t) .. "  ·  " .. StateOf(t))
  end
  local keep = Vml("GetProperty", "lstThings", "SelectedIndex")
  Filling = true
  Vml("SetProperty", "lstThings", "Items", table.concat(rows, ","))
  if keep and keep ~= "" and keep ~= "-1" and tonumber(keep) < #rows then Vml("SetProperty", "lstThings", "SelectedIndex", keep) end
  Filling = false
  PickThing()
end

function PickThing()
  local i = tonumber(Vml("GetProperty", "lstThings", "SelectedIndex") or "-1") or -1
  Picked = Things[i + 1]
  for _, n in ipairs({ "cmbKind", "btnRename", "btnRemove" }) do Vml("SetProperty", n, "IsEnabled", tostring(Picked ~= nil)) end
  if Picked then
    Filling = true
    Vml("SetProperty", "cmbKind", "SelectedIndex", tostring(((KIND[Picked.kind] or KIND.other).index) - 1))
    Filling = false
  end
end

-- ── Time ──
function DayRows(from, to)
  local rows, totals = {}, {}
  for _, t in ipairs(Things) do
    local pieces, total = Within(Sessions(t.address, Merging()), from, to)
    for _, p in ipairs(pieces) do rows[#rows + 1] = { s = p.s, e = p.e, live = p.live, thing = t } end
    if total > 0 then totals[#totals + 1] = { thing = t, total = total } end
  end
  table.sort(rows, function(a, b) return a.s < b.s end)
  table.sort(totals, function(a, b) return a.total > b.total end)
  return rows, totals
end

function TotalsText(totals)
  local bits = {}
  for _, x in ipairs(totals) do bits[#bits + 1] = Label(x.thing) .. " " .. Dur(x.total) end
  return table.concat(bits, "  ·  ")
end

function RowText(r)
  return os.date("%H:%M", r.s) .. "–" .. (r.live and "now" or os.date("%H:%M", r.e)) .. "   " .. Label(r.thing) .. "   " .. Dur(r.e - r.s)
end

function RefreshTime()
  local today = DayStart(os.time())
  local from = today
  for _ = 1, -DayShift do from = DayStart(from - 3600) end
  local to = NextDay(from)
  Vml("SetProperty", "lblDay", "Text", DayName(from, DayShift))
  Vml("SetProperty", "btnNext", "IsEnabled", tostring(DayShift < 0))
  Vml("SetProperty", "chkBreaks", "IsChecked", tostring(Merging()))
  local rows, totals = DayRows(from, to)
  local lines = {}
  for _, r in ipairs(rows) do lines[#lines + 1] = Clean(RowText(r)) end
  Vml("SetProperty", "lstDay", "Items", table.concat(lines, ","))
  if #Things == 0 then
    Vml("SetProperty", "lblTotals", "Text", "Add your desk keyboard or your car on the Things tab, and the time you spend with them shows here.")
  elseif #rows == 0 then
    Vml("SetProperty", "lblTotals", "Text", "Nothing in range " .. (DayShift == 0 and "yet today." or "that day."))
  else
    Vml("SetProperty", "lblTotals", "Text", TotalsText(totals))
  end
  local _, week = DayRows(WeekStart(from), to)          -- the week so far, up to the end of the day shown
  local same = WeekStart(from) == WeekStart(os.time())
  local head = DayShift == 0 and "This week: " or ((same and "This week, to " or "That week, to ") .. DayName(from, DayShift):gsub("^%u", string.lower) .. ": ")
  Vml("SetProperty", "lblWeek", "Text", #week == 0 and "" or (head .. TotalsText(week)))
  DayText = DayName(from, DayShift) .. "\n" .. table.concat(lines, "\n") .. (#totals > 0 and ("\n\n" .. TotalsText(totals)) or "")
end

function Csv()
  local lines = { "thing,kind,start,end,minutes" }
  local rows = {}
  for _, t in ipairs(Things) do
    for _, s in ipairs(Sessions(t.address, Merging())) do rows[#rows + 1] = { s = s, thing = t } end
  end
  table.sort(rows, function(a, b) return a.s.s < b.s.s end)
  for _, r in ipairs(rows) do
    local name = '"' .. r.thing.name:gsub('"', '""') .. '"'
    lines[#lines + 1] = name .. "," .. (KIND[r.thing.kind] or KIND.other).label .. "," .. os.date("%Y-%m-%d %H:%M", r.s.s) .. ","
        .. (r.s.live and "" or os.date("%Y-%m-%d %H:%M", r.s.e)) .. "," .. math.floor((r.s.e - r.s.s) / 60 + 0.5)
  end
  return table.concat(lines, "\n") .. "\n", #rows
end

-- ── what was kept, including from Clever Clogs 1 (cars, and one place saved by hand) ──
Things = json.decode(Kept("things")) or nil
if not Things then
  Things = {}
  for _, car in ipairs(json.decode(Kept("cars")) or {}) do
    Things[#Things + 1] = { address = car.address, name = car.name, kind = "car" }
  end
  if #Things > 0 then KeepThings() end
end
History = json.decode(Kept("history")) or {}
Spots = json.decode(Kept("spots")) or nil
if not Spots then
  Spots = {}
  local was = Things[1] and Things[1].address or ""
  if tonumber(Kept("here_time")) then
    Spots[was] = { time = tonumber(Kept("here_time")), lat = tonumber(Kept("here_lat")), lon = tonumber(Kept("here_lon")),
                   within = tonumber(Kept("here_within")), pressure = tonumber(Kept("here_pressure")) }
    KeepSpots()
  end
  if Kept("note") ~= "" and Kept("note_" .. was) == "" then Keep("note_" .. was, Kept("note")) end
  if Kept("photo") ~= "" and Kept("photo_" .. was) == "" then Keep("photo_" .. was, Kept("photo")) end
end
Which = Kept("which")
if Which ~= "" and not ThingOf(Which) then Which = "" end
if Which == "" and Things[1] and not Spots[""] then Which = Things[1].address end

local kinds = {}
for _, k in ipairs(KINDS) do kinds[#kinds + 1] = k.icon .. " " .. k.label end
Vml("SetProperty", "cmbKind", "Items", table.concat(kinds, ","))
Vml("SetProperty", "cmbAdd", "Items", "Find first")
Vml("Pressure")           -- wakes the barometer, so there is a reading by the time it is wanted
Harvest()
FillWhich()
ShowTab("Where")
LUA

# Small scripts: one for each button, and one for each answer the phone sends back later.

@Script Tick
Interpreter=lua
<<LUA
Harvest()
Refresh()
LUA

@Script TabWhere
Interpreter=lua
<<LUA
ShowTab("Where")
LUA

@Script TabThings
Interpreter=lua
<<LUA
ShowTab("Things")
LUA

@Script TabTime
Interpreter=lua
<<LUA
Harvest()
ShowTab("Time")
LUA

@Script WhichChosen
Interpreter=lua
<<LUA
if Filling then return end
local i = tonumber(Vml("GetProperty", "cmbWhich", "SelectedIndex") or "-1") or -1
if WhichList[i + 1] == nil then return end
Which = WhichList[i + 1]
Keep("which", Which)
Status("")
RefreshWhere()
LUA

@Script DoGo
Interpreter=lua
<<LUA
-- Walking directions to the spot, in whatever maps app the phone has.
if not Spot or not Spot.lat then
  Status("There's no place saved to go back to yet.")
else
  Vml("OpenUrl", "https://www.google.com/maps/dir/?api=1&travelmode=walking&destination=" .. Spot.lat .. "," .. Spot.lon)
end
LUA

@Script DoShare
Interpreter=lua
<<LUA
-- A map link (and the note) handed to messages, email, or whatever the user picks.
if not Spot or not Spot.lat then
  Status("There's no place saved to share yet.")
else
  local t = ThingOf(Which)
  local what = t and (KindOf(Which).key == "car" and "The car" or t.name) or "The car"
  local note = Kept("note_" .. Which)
  Vml("Share", what .. " is here: https://maps.google.com/?q=" .. Spot.lat .. "," .. Spot.lon .. (note ~= "" and ("  (" .. note .. ")") or ""),
      "Where " .. what:gsub("^The ", "the ") .. " is")
end
LUA

@Script DoHere
Interpreter=lua
<<LUA
-- Saving by hand: ask where the phone is; the answer comes back to Here.
Status("Finding where you are...")
Vml("GetLocation", "Here")
LUA

@Script Here
Interpreter=lua
<<LUA
-- GetLocation's answer: the place, or what went wrong.
local lat, lon, within, problem = ...
if problem ~= "" then
  Status(problem)
  return
end
Spots[Which] = { time = os.time(), lat = tonumber(lat), lon = tonumber(lon), within = tonumber(within), pressure = tonumber(Vml("Pressure")) }
KeepSpots()
RefreshWhere()
Status("Saved. A photo of the spot or a note helps in a big car park.")
LUA

@Script DoPhoto
Interpreter=lua
<<LUA
Vml("TakePhoto", "imgBay", "Snapped")
LUA

@Script Snapped
Interpreter=lua
<<LUA
Keep("photo_" .. Which, Vml("GetProperty", "imgBay", "Source"))
Status("Photo kept.")
LUA

@Script SaveNote
Interpreter=lua
<<LUA
Keep("note_" .. Which, Vml("GetProperty", "txtNote", "Text"))
LUA

@Script ThingPicked
Interpreter=lua
<<LUA
if Filling then return end
PickThing()
LUA

@Script KindChosen
Interpreter=lua
<<LUA
-- What the chosen thing is: it changes how it's spoken of, and the Time tab's icons.
if Filling or not Picked then return end
local k = KINDS[(tonumber(Vml("GetProperty", "cmbKind", "SelectedIndex")) or 0) + 1]
if not k or k.key == Picked.kind then return end
Picked.kind = k.key
KeepThings()
FillWhich()
RefreshThings()
Status(Picked.name .. " counts as " .. k.as .. " now.")
LUA

@Script DoRename
Interpreter=lua
<<LUA
if not Picked then return end
local name = (Vml("PromptDialog", "Rename", "What to call " .. Picked.name .. ":", Picked.name) or ""):match("^%s*(.-)%s*$")
if name == "" or name == Picked.name then return end
Picked.name = name
KeepThings()
FillWhich()
RefreshThings()
LUA

@Script DoRemove
Interpreter=lua
<<LUA
-- Stop watching one thing. Its time already noted stays out of the totals from now on.
if not Picked then return end
local sure = tostring(Vml("ConfirmDialog", "Stop watching " .. Picked.name .. "? The phone won't note where it's left, or the time with it, from now on.", "Remove") or "")
if sure:lower() ~= "true" then return end
Vml("WatchBluetooth", Picked.address, "false")
local _, i = ThingOf(Picked.address)
local name = Picked.name
table.remove(Things, i)
KeepThings()
if Which == Picked.address then Which = Things[1] and Things[1].address or ""; Keep("which", Which) end
Picked = nil
FillWhich()
RefreshThings()
Status("Removed " .. name .. ".")
LUA

@Script DoFind
Interpreter=lua
<<LUA
-- Ask the phone which Bluetooth devices it is paired with; the answer comes back to Found.
Status("Looking for the devices this phone is paired with...")
Vml("BluetoothDevices", "Found")
LUA

@Script Found
Interpreter=lua
<<LUA
-- BluetoothDevices' answer: the list as JSON, or what went wrong.
local list, problem = ...
if problem ~= "" then
  Status(problem)
  return
end
Paired = {}
for _, d in ipairs(json.decode(list) or {}) do
  if not ThingOf(d.address) then Paired[#Paired + 1] = d end
end
local names = { #Paired == 0 and "Nothing new to add" or "Add a device..." }
for _, d in ipairs(Paired) do names[#names + 1] = Clean(d.name) end
Filling = true
Vml("SetProperty", "cmbAdd", "Items", table.concat(names, ","))
Vml("SetProperty", "cmbAdd", "SelectedIndex", "0")
Filling = false
if #Paired == 0 then
  Status(#Things == 0 and "This phone isn't paired with anything yet. Pair it in the phone's Bluetooth settings, then come back."
         or "Everything this phone is paired with is already here.")
else
  Status("Choose one from the list to add it.")
end
LUA

@Script AddChosen
Interpreter=lua
<<LUA
-- A device was picked from the list: it is one of your things from now on, with a guess at what it is.
if Filling then return end
local d = Paired[tonumber(Vml("GetProperty", "cmbAdd", "SelectedIndex")) or 0]      -- the first line is a heading
if not d or ThingOf(d.address) then return end
local t = { address = d.address, name = d.name, kind = Guess(d.name) }
Things[#Things + 1] = t
KeepThings()
for i, p in ipairs(Paired) do if p.address == d.address then table.remove(Paired, i) break end end
local names = { #Paired == 0 and "Nothing new to add" or "Add a device..." }
for _, p in ipairs(Paired) do names[#names + 1] = Clean(p.name) end
Filling = true
Vml("SetProperty", "cmbAdd", "Items", table.concat(names, ","))
Vml("SetProperty", "cmbAdd", "SelectedIndex", "0")
Filling = false
if #Things == 1 or Which == "" and not Spots[""] then Which = t.address; Keep("which", Which) end
FillWhich()
RefreshThings()
Vml("SetProperty", "lstThings", "SelectedIndex", tostring(#Things - 1))
PickThing()
Adding = t
Vml("WatchBluetooth", t.address, "true", "Watched")
LUA

@Script Watched
Interpreter=lua
<<LUA
-- The phone's answer to being asked to watch a thing: "watching", or why it can't fully.
local state, problem = ...
if state == "watching" then
  local t = Adding or {}
  Status("Added " .. (t.name or "it") .. " as " .. (KIND[t.kind] or KIND.other).as
         .. " (change it above if that's wrong). The phone notes where it is each time it goes out of range, even with this app shut.")
else
  Status(problem)
end
Refresh()
LUA

@Script DayBack
Interpreter=lua
<<LUA
DayShift = DayShift - 1
RefreshTime()
LUA

@Script DayOn
Interpreter=lua
<<LUA
if DayShift < 0 then DayShift = DayShift + 1 end
RefreshTime()
LUA

@Script BreaksChanged
Interpreter=lua
<<LUA
Keep("breaks", Vml("GetProperty", "chkBreaks", "IsChecked") == "true" and "on" or "off")
RefreshTime()
LUA

@Script DoCsv
Interpreter=lua
<<LUA
-- Every stretch with every thing, for a timesheet or a spreadsheet.
local text, n = Csv()
if n == 0 then return Status("There's no time noted yet to save.") end
local where = Vml("SaveFile", "clever-clogs-time.csv", text) or ""
Status(where ~= "" and ("Saved " .. n .. " stretches to " .. where .. ".") or ("Saved " .. n .. " stretches."))
LUA

@Script DoShareDay
Interpreter=lua
<<LUA
if not DayText or DayText:find("\n$") then return Status("Nothing to share for that day.") end
Vml("Share", "Clever Clogs, " .. DayText, "My day")
LUA
