@Script ToggleHead
Interpreter=lua
<<LUA
if headOn then
  headOn = false
  Vml("SetProperty", "tmrHead", "IsEnabled", "false")
  Vml("HeadMouse", "stop")
  clearHi()
  Vml("SetProperty", "btnHead", "Content", "Look to talk")
  Vml("SetProperty", "lblBanner", "Text", "Choose a tile to talk")
  return
end
-- events mode: the tracker runs and detects clicks, but drives no OS cursor
local r = Vml("HeadMouse", "start", "events")
if r == "needs-pack:headmouse" then
  Vml("SetControlVisible", "pPack", "true")
  return
end
headOn = true
hTile, hStill = 0, 0
Vml("SetProperty", "tmrHead", "IsEnabled", "true")
Vml("SetProperty", "btnHead", "Content", "Stop")
Vml("SetProperty", "lblBanner", "Text", "Look at a tile and rest on it")
LUA

@Script HeadTick
Interpreter=lua
<<LUA
if not headOn then return end
local f = json.decode(Vml("HeadMouse", "read") or "") or {}
if (f.face or 0) == 0 then return end
local function cl(v) if v < 0 then return 0 elseif v > 0.999 then return 0.999 else return v end end
local col = math.floor(cl(f.x) * 3)
local row = math.floor(cl(f.y) * 4)
local tile = row * 3 + col + 1
if tile ~= hTile then
  clearHi()
  Vml("SetProperty", "Tap" .. tile, "Style", HI)
  hTile = tile ; hStill = 0
end
-- the engine detects the click (dwell/mouth/blink); speak the lit tile
if f.click then
  say(hTile)
end
LUA

@Script InstallPack
Interpreter=lua
<<LUA
Vml("SetProperty", "lblPackBody", "Content", "Downloading the head-mouse pack… this runs once.")
local r = Vml("Pack", "install", "headmouse")
if r == "" or r == "ok" then
  Vml("SetControlVisible", "pPack", "false")
  Vml("SetProperty", "btnHead", "Content", "Look to talk")
elseif r == "locked" then
  Vml("SetProperty", "lblPackBody", "Content", "This is a Pro capability — free with an AAC pass. Get one at tiny-host.uk, then press Install again. You can touch the tiles meanwhile.")
else
  Vml("SetProperty", "lblPackBody", "Content", "Couldn't install: " .. r .. "\nCheck the connection and try again.")
end
LUA

@Script PackClose
Interpreter=lua
<<LUA
Vml("SetControlVisible", "pPack", "false")
LUA
