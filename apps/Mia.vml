# ============================================================================

@Script Start
Interpreter=lua
<<LUA
json = require("dkjson")
phrases = {"Yes","No","Hello","Thank you","Please","Help me",
           "Hungry","Thirsty","Toilet","It hurts","More","All done"}
headOn = false
hTile, hStill = 0, 0
HI   = "background:#7C3AED;color:#fff;border:3px solid #DDD6FE;border-radius:16px;font-weight:700"
BASE = "background:#312E51;color:#fff;border:2px solid #4C4870;border-radius:16px;font-weight:700"

function clearHi()
  for i = 1, 12 do Vml("SetProperty", "Tap" .. i, "Style", BASE) end
end

function say(n)
  local t = phrases[n]
  if t and t ~= "" then
    Vml("SetProperty", "lblSpoken", "Text", t)
    Vml("Speak", t)
  end
end
LUA

@Script Say1
Interpreter=lua
<<LUA
say(1)
LUA

