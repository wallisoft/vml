Content=Save and close
OnClick=SaveSettings
Style=background:#0F766E;color:#FFFFFF;border:0;border-radius:14px;font-weight:700

# ============================================================================
# Scripts. Opened runs when the form opens and defines what the taps share.
# ============================================================================

@Script Opened
Interpreter=lua
<<LUA
default = {"Yes", "No", "Please", "Thank you", "I'm in pain", "I need the toilet",
           "I'm thirsty", "I'm hungry", "I'm too hot", "I'm too cold", "I'm tired", "Help please"}
phrases = {}
last = ""

function wrap(t, w)
  local out, line = {}, ""
  for word in t:gmatch("%S+") do
    if line == "" then line = word
    elseif #line + 1 + #word <= w then line = line .. " " .. word
    else out[#out + 1] = line; line = word end
  end
  if line ~= "" then out[#out + 1] = line end
  return table.concat(out, "\n")
end

local saved = Vml("GetSetting", "talker_phrases") or ""
local list = {}
if saved ~= "" then
  for line in (saved .. "\n"):gmatch("(.-)\n") do list[#list + 1] = line end
else
  list = default
end

for i = 1, 12 do
  local t = list[i] or ""
  phrases[i] = t
  Vml("SetProperty", "btn" .. i, "Content", wrap(t, 8))
  Vml("SetProperty", "btn" .. i, "IsVisible", t ~= "" and "true" or "false")
end

function Say(i)
  local t = phrases[i] or ""
  if t == "" then return end
  last = t
  Vml("SetProperty", "btnBanner", "Content", t)
  Vml("Speak", t)
end
LUA

@Script Repeat
Interpreter=lua
<<LUA
if last and last ~= "" then Vml("Speak", last) end
LUA

@Script Tap1
Interpreter=lua
<<LUA
Say(1)
LUA

@Script Tap2
Interpreter=lua
<<LUA
Say(2)
LUA

@Script Tap3
Interpreter=lua
<<LUA
Say(3)
LUA

@Script Tap4
Interpreter=lua
<<LUA
Say(4)
LUA

@Script Tap5
Interpreter=lua
<<LUA
Say(5)
LUA

@Script Tap6
Interpreter=lua
<<LUA
Say(6)
LUA

@Script Tap7
Interpreter=lua
<<LUA
Say(7)
LUA

@Script Tap8
Interpreter=lua
<<LUA
Say(8)
LUA

@Script Tap9
Interpreter=lua
<<LUA
Say(9)
LUA

@Script Tap10
Interpreter=lua
<<LUA
Say(10)
LUA

@Script Tap11
Interpreter=lua
<<LUA
Say(11)
LUA

@Script Tap12
Interpreter=lua
<<LUA
Say(12)
LUA

@Script OpenSettings
Interpreter=lua
<<LUA
local t = {}
for i = 1, 12 do t[i] = phrases[i] or "" end
while #t > 0 and (t[#t] == nil or t[#t] == "") do t[#t] = nil end
Vml("SetProperty", "txtPhrases", "Text", table.concat(t, "\n"))
Vml("SetProperty", "pSet", "IsVisible", "true")
LUA

@Script SaveSettings
Interpreter=lua
<<LUA
local txt = Vml("GetProperty", "txtPhrases", "Text") or ""
Vml("SetSetting", "talker_phrases", txt)
local list = {}
for line in (txt .. "\n"):gmatch("(.-)\n") do list[#list + 1] = line end
for i = 1, 12 do
  local s = list[i] or ""
  phrases[i] = s
  Vml("SetProperty", "btn" .. i, "Content", wrap(s, 8))
  Vml("SetProperty", "btn" .. i, "IsVisible", s ~= "" and "true" or "false")
end
Vml("SetProperty", "pSet", "IsVisible", "false")
LUA
