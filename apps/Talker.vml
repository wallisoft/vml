# ============================================================================
# Shinewater Talker - a simple talking board.
#
#   Big tiles; tap one and the tablet says it out loud. Made for care-home
#   residents with little motor function and no interest in fiddly tech:
#   nothing to read, nothing to set up, just tap and be heard. A carer edits
#   the tiles to the person's own words behind the gear button.
#
#   Runs on a Windows/Linux desktop and as an Android app. Made with
#   Visualised by Wallisoft.
# ============================================================================

@Window Talker
Title=Shinewater Talker
Version=0.1.0
Width=360
Height=652
AppBar=true
About=A simple talking board: tap a tile and it speaks aloud. Made with Visualised by Wallisoft.
OnOpened=Opened

@Canvas c
Parent=Talker
Background=#EEF2F2

@Button btnBanner
Parent=c
Canvas.Left=12
Canvas.Top=12
Width=336
Height=92
FontSize=28
Content=Choose a tile to talk
OnClick=Repeat
Style=background:#0F766E;color:#FFFFFF;border:0;border-radius:18px;font-weight:700;padding:10px;box-shadow:0 3px 10px rgba(15,118,110,.30)

