LUA

@Script Tap7
Interpreter=lua
<<LUA
Say(7)
LUA

@Script Tap8
Interpreter=lua
<<LUA
Say(8)
LUA

@Script Tap9
Interpreter=lua
<<LUA
Say(9)
LUA

@Script Tap10
Interpreter=lua
<<LUA
Say(10)
LUA

@Script Tap11
Interpreter=lua
<<LUA
Say(11)
LUA

@Script Tap12
Interpreter=lua
<<LUA
Say(12)
LUA

@Script OpenSettings
Interpreter=lua
<<LUA
local t = {}
for i = 1, 12 do t[i] = lines[i] or "" end
while #t > 0 and (t[#t] == nil or t[#t] == "") do t[#t] = nil end
Vml("SetProperty", "txtPhrases", "Text", table.concat(t, "\n"))
Vml("SetProperty", "pSet", "IsVisible", "true")
LUA

@Script SaveSettings
Interpreter=lua
<<LUA
local txt = Vml("GetProperty", "txtPhrases", "Text") or ""
Vml("SetSetting", "talker_phrases", txt)
local list = {}
for line in (txt .. "\n"):gmatch("(.-)\n") do list[#list + 1] = line end
for i = 1, 12 do applyLine(i, list[i] or "") end
Vml("SetProperty", "pSet", "IsVisible", "false")
LUA
