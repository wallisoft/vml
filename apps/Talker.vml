# ============================================================================
# Scripts. Opened runs when the form opens and defines what the taps share.
# ============================================================================

@Script Opened
Interpreter=lua
<<LUA
-- Each tile is one line:  <emoji> <short label shown> = <words spoken>
-- A line with no "=" speaks its label; a line with no leading emoji shows just the word.
default = {
  "\240\159\145\141 Yes",
  "\240\159\145\142 No",
  "\240\159\153\143 Please",
  "\240\159\152\138 Thanks = Thank you",
  "\240\159\164\149 Pain = I'm in pain",
  "\240\159\154\189 Toilet = I need the toilet",
  "\240\159\165\164 Drink = I'm thirsty",
  "\240\159\141\189 Food = I'm hungry",
  "\240\159\165\181 Hot = I'm too hot",
  "\240\159\165\182 Cold = I'm too cold",
  "\240\159\152\180 Tired = I'm tired",
  "\240\159\134\152 Help = Help please",
}
lines = {}
spoken = {}
last = ""

function wrap(t, w)
  local out, line = {}, ""
  for word in t:gmatch("%S+") do
    if line == "" then line = word
    elseif #line + 1 + #word <= w then line = line .. " " .. word
    else out[#out + 1] = line; line = word end
  end
  if line ~= "" then out[#out + 1] = line end
  return table.concat(out, "\n")
end

function parse(s)
  local emoji = ""
  local first, remain = s:match("^(%S+)%s+(.*)$")
  if first and first:byte(1) and first:byte(1) >= 240 then    -- a leading 4-byte char is the emoji
    emoji = first; s = remain
  end
  local label, say = s:match("^(.-)%s*=%s*(.*)$")
  if not label then label, say = s, s end
  if say == nil or say == "" then say = label end
  return emoji, label, say
end

function applyLine(i, line)
  line = line or ""
  lines[i] = line
  if line:match("^%s*$") then
    spoken[i] = ""
    Vml("SetProperty", "btn" .. i, "Content", "")
    Vml("SetProperty", "btn" .. i, "IsVisible", "false")
    return
  end
  local e, l, say = parse(line)
  spoken[i] = say
  Vml("SetProperty", "btn" .. i, "Content", (e ~= "" and (e .. "\n") or "") .. wrap(l, 10))
  Vml("SetProperty", "btn" .. i, "IsVisible", "true")
end

local saved = Vml("GetSetting", "talker_phrases") or ""
local list = {}
if saved ~= "" then
  for line in (saved .. "\n"):gmatch("(.-)\n") do list[#list + 1] = line end
else
  list = default
end
for i = 1, 12 do applyLine(i, list[i] or "") end

function Log(text)
  local line = os.date("%d %b  %H:%M") .. "   " .. text
  local log = Vml("GetSetting", "talker_log") or ""
  log = line .. "\n" .. log
  local kept, n = {}, 0
  for ln in (log .. "\n"):gmatch("(.-)\n") do
    n = n + 1
    if n <= 800 then kept[#kept + 1] = ln else break end
  end
  Vml("SetSetting", "talker_log", table.concat(kept, "\n"))
end

function Say(i)
  local t = spoken[i] or ""
  if t == "" then return end
  last = t
  Vml("SetProperty", "btnBanner", "Content", t)
  Vml("Speak", t)
  Log(t)
end

-- scan mode: one switch, tiles light up in turn, the switch picks the lit one
scanning = false
scanPos = 0

function visibleTiles()
  local v = {}
  for i = 1, 12 do if spoken[i] and spoken[i] ~= "" then v[#v + 1] = i end end
  return v
end

function clearHi()
  for i = 1, 12 do Vml("SetProperty", "rHi" .. i, "IsVisible", "false") end
end

function ScanStep()
  local v = visibleTiles()
  if #v == 0 then return end
  scanPos = scanPos % #v + 1
  clearHi()
  Vml("SetProperty", "rHi" .. v[scanPos], "IsVisible", "true")
end

function ScanSelect()
  local v = visibleTiles()
  if #v == 0 or scanPos < 1 then return end
  Say(v[((scanPos - 1) % #v) + 1])
end

function startScan(on)
  scanning = on
  Vml("SetProperty", "btnScan", "Content", on and "Scan mode: ON" or "Scan mode: off")
  if on then
    scanPos = 0
    Vml("SetProperty", "btnBanner", "Content", "Press your switch to choose")
    Vml("SetProperty", "tmrScan", "IsEnabled", "true")
  else
    Vml("SetProperty", "tmrScan", "IsEnabled", "false")
    clearHi()
    Vml("SetProperty", "btnBanner", "Content", "Choose a tile to talk")
  end
end

if (Vml("GetSetting", "talker_scan") or "") == "1" then startScan(true) end
LUA

@Script Repeat
Interpreter=lua
<<LUA
if last and last ~= "" then Vml("Speak", last) end
LUA

@Script Tap1
Interpreter=lua
<<LUA
Say(1)
LUA

