@Script OpenSettings
Interpreter=lua
<<LUA
local t = {}
for i = 1, 12 do t[i] = lines[i] or "" end
while #t > 0 and (t[#t] == nil or t[#t] == "") do t[#t] = nil end
Vml("SetProperty", "txtPhrases", "Text", table.concat(t, "\n"))
Vml("SetProperty", "pSet", "IsVisible", "true")
LUA

@Script SaveSettings
Interpreter=lua
<<LUA
local txt = Vml("GetProperty", "txtPhrases", "Text") or ""
Vml("SetSetting", "talker_phrases", txt)
local list = {}
for line in (txt .. "\n"):gmatch("(.-)\n") do list[#list + 1] = line end
for i = 1, 12 do applyLine(i, list[i] or "") end
Vml("SetProperty", "pSet", "IsVisible", "false")
LUA

@Script OpenLog
Interpreter=lua
<<LUA
Vml("SetProperty", "txtLog", "Text", Vml("GetSetting", "talker_log") or "")
Vml("SetProperty", "pSet", "IsVisible", "false")
Vml("SetProperty", "pLog", "IsVisible", "true")
LUA

@Script SaveLog
Interpreter=lua
<<LUA
local log = Vml("GetSetting", "talker_log") or ""
if log == "" then log = "(nothing said yet)" end
Vml("SaveFile", "shinewater-talker-log.txt", log)
LUA

@Script ClearLog
Interpreter=lua
<<LUA
Vml("SetSetting", "talker_log", "")
Vml("SetProperty", "txtLog", "Text", "")
LUA

@Script CloseLog
Interpreter=lua
<<LUA
Vml("SetProperty", "pLog", "IsVisible", "false")
LUA

@Script ScanTick
Interpreter=lua
<<LUA
ScanStep()
LUA

@Script BannerTap
Interpreter=lua
<<LUA
if scanning then
  ScanSelect()
else
  if last and last ~= "" then Vml("Speak", last) end
end
LUA

@Script ToggleScan
Interpreter=lua
<<LUA
local now = not scanning
startScan(now)
Vml("SetSetting", "talker_scan", now and "1" or "")
LUA
