Canvas.Left=12
Canvas.Top=104
IsVisible=false
Width=336
Height=40
Watermark=Username or email

@TextBox txtPass
Parent=c
Canvas.Left=12
Canvas.Top=152
IsVisible=false
Width=336
Height=40
IsPassword=true
Watermark=Password

@Button btnSignIn
Parent=c
Canvas.Left=12
Canvas.Top=202
IsVisible=false
Width=336
Height=44
Content=Sign in and start
OnClick=DoSignIn

@TextBlock lblHelp
Parent=c
Canvas.Left=12
Canvas.Top=258
IsVisible=false
Width=336
Height=200
TextWrapping=Wrap
Foreground=#4B5563
Text=Your tiny-web account: no account yet? Sign up at tiny-web.uk, then come back. The phone will ask to send and receive texts: say yes to both, or it can't do its job. Your password goes to tiny-web.uk once and isn't kept on the phone.

# --- working: what it has done, and the buttons to stop it ------------------

@TextBlock lblCounts
Parent=c
Canvas.Left=12
Canvas.Top=104
IsVisible=false
Width=336
Height=24
Foreground=#0F766E
FontWeight=Bold
Text=

@TextBlock lblLog
Parent=c
Canvas.Left=12
Canvas.Top=134
IsVisible=false
Width=336
Height=380
TextWrapping=Wrap
FontSize=14
Foreground=#374151
Text=

@Button btnPause
Parent=c
Canvas.Left=12
Canvas.Top=524
IsVisible=false
Width=164
Height=44
Content=Pause sending
OnClick=DoPause

@Button btnSignOut
Parent=c
Canvas.Left=184
Canvas.Top=524
IsVisible=false
Width=164
Height=44
Content=Sign out
OnClick=DoSignOut

# --- the console (computer or browser): conversations, one thread, and a text to send

@ListBox lstConv
Parent=c
Canvas.Left=12
Canvas.Top=104
IsVisible=false
Width=336
Height=120
SelectionChanged=PickConv

@TextBlock lblThread
Parent=c
Canvas.Left=12
Canvas.Top=232
IsVisible=false
Width=336
Height=250
TextWrapping=Wrap
FontSize=14
Foreground=#374151
Text=

@TextBox txtTo
Parent=c
Canvas.Left=12
Canvas.Top=490
IsVisible=false
Width=252
Height=36
Watermark=Number, or a name from your phone

@Button btnName
Parent=c
Canvas.Left=272
Canvas.Top=490
IsVisible=false
Width=76
Height=36
Content=Name
OnClick=DoName

@TextBox txtMsg
Parent=c
Canvas.Left=12
Canvas.Top=532
IsVisible=false
Width=252
Height=40
Watermark=Message

@Button btnSend
Parent=c
Canvas.Left=272
Canvas.Top=532
IsVisible=false
Width=76
Height=40
Content=Send
OnClick=DoSend

@Button btnConsoleOut
Parent=c
Canvas.Left=12
Canvas.Top=584
IsVisible=false
Width=336
Height=36
Content=Sign out of this computer
OnClick=DoConsoleOut

# --- every minute (or what the server says) it asks for anything waiting -----

@Timer tmr
Parent=c
Interval=60000
IsEnabled=false
OnTick=Poll

# ============================================================================
# Scripts. Start runs when the form opens and holds everything the others share.
# ============================================================================

@Script Start
Interpreter=lua
<<LUA
json = require("dkjson")
API = "https://tiny-web.uk/api/device.php"
VERSION = "2.7"          -- keep with the Window's Version above: shown at the top, and told to the server
CONSOLE = "https://tiny-web.uk/api/console.php"
Role = "gateway"         -- or "console": a computer or a browser, which sends through the gateway and never is one
Current = nil           -- the console: the number whose conversation is showing
CurrentName = ""        -- and the name it has, if any
Convs = ""              -- the console: the list as last shown (only redrawn when it changes, so a choice isn't lost)
-- TinySMS's Firebase project: public values (they are in every Firebase app), not secrets.
FIREBASE = json.encode({ project = "tinysms-2929e", app = "1:36897486791:android:65271ea33d3c08b9da4be2", key = "AIzaSyAuXb7Q0K9qaLc1T2TIqkl8YgzRmXYzSbc", sender = "36897486791" })
Busy = false            -- a question to the server, or a text, is on its way: don't start another
Paused = false
Sending = nil           -- the message being sent: { id, to, text, more }
Lines = {}              -- what it has done, newest first
Sent, Replies, Failed = 0, 0, 0
HeardQ = {}             -- texts that arrived, waiting for their sender's name to be looked up
Asked = 0               -- when RunInBackground was last asked (it lasts six hours from then)

function Kept(key) return Vml("GetSetting", key) end
function KeptTable(key) local t = json.decode(Kept(key) or ""); return type(t) == "table" and t or {} end
function LastNumbers() return KeptTable("last_numbers") end
function State(text) Vml("SetProperty", "lblState", "Text", text) end
function Now() return os.date("%H:%M") end

function Note(text)
  table.insert(Lines, 1, Now() .. "  " .. text)
  while #Lines > 14 do table.remove(Lines) end
  Vml("SetProperty", "lblLog", "Text", table.concat(Lines, "\n"))
end

function Counts()
  Vml("SetProperty", "lblCounts", "Text", "Sent " .. Sent .. "  ·  replies " .. Replies .. (Failed > 0 and ("  ·  failed " .. Failed) or ""))
end

-- 07700 900123 -> ***0123: the log shows enough to recognise a number, not the whole of it
function Masked(number)
  local digits = tostring(number or ""):gsub("%D", "")
  return "***" .. digits:sub(-4)
end

-- The two pages: the sign-in fields, and the working log with its buttons. Shown by turning their controls on or off.
PAGES = { signin = { "txtUser", "txtPass", "btnSignIn", "lblHelp" }, work = { "lblCounts", "lblLog", "btnPause", "btnSignOut" },
          console = { "lstConv", "lblThread", "txtTo", "btnName", "txtMsg", "btnSend", "btnConsoleOut" } }
function Page(name)
  for page, controls in pairs(PAGES) do
    for _, c in ipairs(controls) do Vml("SetProperty", c, "IsVisible", tostring(page == name)) end
  end
end

-- One question to the server: the device's own fields go with every one.
function Server(event, extra, handler)
  local q = { event = event, android_id = Kept("device_id"), device_key = Kept("device_key"), version = "vml-" .. VERSION }
  local info = json.decode(Vml("DeviceInfo")) or {}
  q.battery = info.battery
  for k, v in pairs(extra or {}) do q[k] = v end
  Vml("Fetch", API, json.encode(q), handler or "")
end

-- What the server said: the decoded answer, or nil and why not.
function Answer(text, problem)
  local d = json.decode(text or "")
  if type(d) ~= "table" then return nil, problem ~= "" and problem or "The server's answer didn't make sense." end
  if d.ok == false or (problem ~= "" and not d.ok) then return nil, d.error or problem, d end
  return d
end

-- How often the phone asks the server: rarely when the server can wake it by push (a heartbeat; every text,
-- name request and contact change wakes it at once), often when it can't.
function PollEvery()
  local poll = math.max(10, tonumber(Kept("poll")) or 10)
  if Kept("push_ok") == "1" then poll = 300 end
  Vml("SetProperty", "tmr", "Interval", tostring(poll * 1000))
  return poll
end

function Begin()
  Page("work")
  Counts()
  local poll = PollEvery()
  Vml("SetProperty", "tmr", "IsEnabled", "true")
  Vml("OnSms", "Heard")
  Vml("OnMessages", "Heard")          -- replies that came by chat (RCS): the phone asks once for notification access
  Vml("ReadContacts", "GotNameList")   -- the names (not numbers) for texting by name: the phone asks once
  Vml("OnPush", "Pushed", FIREBASE)
  Vml("RunInBackground", "true")
  Asked = os.time()
  State("Working: texts sent by email go out from this phone.")
  Note("Started, asking every " .. poll .. " seconds.")
  Vml("RunScript", "Poll")
end

-- The console's questions to the server: its key goes with every one.
function Console(action, extra, handler)
  local q = { action = action, key = Kept("console_key") }
  for k, v in pairs(extra or {}) do q[k] = v end
  Vml("Fetch", CONSOLE, json.encode(q), handler or "")
end

function BeginConsole()
  Page("console")
  Vml("SetProperty", "tmr", "Interval", "10000")
  Vml("SetProperty", "tmr", "IsEnabled", "true")
  LastChanges = nil
  State("Signed in as " .. (Kept("console_who") ~= "" and Kept("console_who") or "you") .. ". Looking for your gateway phone...")
  Vml("RunScript", "Refresh")
end

Vml("SetProperty", "lblTitle", "Text", "TinySMS " .. VERSION)

-- The first time: a name for this phone that stays the same (the server knows it by this).
if Kept("device_id") == "" then
  math.randomseed(os.time() + math.floor((os.clock() * 1000000) % 1000000))
  local id = {}
  for i = 1, 16 do id[i] = string.format("%x", math.random(0, 15)) end
  Vml("SetSetting", "device_id", table.concat(id))
end

local info = json.decode(Vml("DeviceInfo")) or {}
if info.platform ~= "android-app" then
  Role = "console"
  Vml("SetProperty", "btnSignIn", "Content", "Sign in")
  Vml("SetProperty", "lblHelp", "Text", "Your tiny-web account, the same one your TinySMS phone uses. Texts you write here go out from that phone, and its conversations show here. This computer keeps a key of its own, not your password.")
  if Kept("console_key") ~= "" then
    BeginConsole()
  else
    Page("signin")
    State("Send texts from this computer through your TinySMS phone.")
  end
elseif Kept("device_key") ~= "" then
  Begin()
else
  Page("signin")
  State("Sign in to make this phone your TinySMS gateway.")
end
LUA

# --- signing in --------------------------------------------------------------

@Script DoSignIn
Interpreter=lua
<<LUA
local user = Vml("GetProperty", "txtUser", "Text")
local pass = Vml("GetProperty", "txtPass", "Text")
if user == "" or pass == "" then return State("Your username (or email) and password, please.") end
local info = json.decode(Vml("DeviceInfo")) or {}
State("Signing in...")
if Role == "console" then              -- a computer or a browser: a console key, never a gateway's
  return Console("login", { username = user, password = pass, label = info.platform or "computer" }, "ConsoleIn")
end
Server("register", { username = user, password = pass, want_key = true, model = info.model, android_ver = info.android }, "SignedIn")
LUA

@Script SignedIn
Interpreter=lua
<<LUA
Vml("SetProperty", "txtPass", "Text", "")
local d, why = Answer(args[1], args[2])
if not d then return State("Not signed in: " .. tostring(why)) end
if not d.device_key then
  return State(d.linked == false and "That account wasn't found." or "Signed in, but the server gave this phone no key. Try again.")
end
Vml("SetSetting", "device_key", d.device_key)
Vml("SetSetting", "poll", tostring(d.poll or 10))
Vml("SetSetting", "who", d.username or "")
Note("Signed in as " .. (d.username or "you") .. " (" .. (d.plan or "free") .. ").")
Begin()
LUA

@Script DoSignOut
Interpreter=lua
<<LUA
if Vml("ConfirmDialog", "Sign this phone out of TinySMS?\n\nTexts emailed to you will wait until a phone signs in again.") ~= "true" then return end
Vml("RunScript", "SignOutNow")
LUA

@Script SignOutNow
Interpreter=lua
<<LUA
Server("unregister")
Vml("SetProperty", "tmr", "IsEnabled", "false")
Vml("OnSms", "")
Vml("OnMessages", "")
Vml("OnPush", "")
Vml("RunInBackground", "false")
Vml("SetSetting", "device_key", "")
Lines = {}
Vml("SetProperty", "lblLog", "Text", "")
Page("signin")
State("Signed out. Texts emailed to you will wait until a phone signs in.")
LUA

@Script DoPause
Interpreter=lua
<<LUA
Paused = not Paused
Vml("SetProperty", "btnPause", "Content", Paused and "Carry on sending" or "Pause sending")
State(Paused and "Paused: texts wait on the server. Replies still come through." or "Working: texts sent by email go out from this phone.")
Note(Paused and "Paused." or "Carrying on.")
if not Paused then Vml("RunScript", "Poll") end
LUA

# --- the round: ask, send, say how it went, and again if more are waiting ----

@Script Poll
Interpreter=lua
<<LUA
if Role == "console" then return Vml("RunScript", "Refresh") end
if Busy or Paused or Kept("device_key") == "" then return end
if os.time() - Asked > 3600 then Vml("RunInBackground", "true"); Asked = os.time() end   -- six more hours
Busy = true
Server("next", nil, "Got")
LUA

@Script Got
Interpreter=lua
<<LUA
local d, why, said = Answer(args[1], args[2])
if d and type(d.wanted) == "table" and #d.wanted > 0 then
  Vml("LookupNames", json.encode(d.wanted), "NamesFound")       -- just these numbers, nothing else from the address book
end
if d and type(d.edits) == "table" and #d.edits > 0 then        -- contacts added or renamed on a web page or computer
  local start = not Edits
  Edits = Edits or {}
  for _, e in ipairs(d.edits) do table.insert(Edits, e) end
  if start then Vml("RunScript", "SaveNext") end
elseif d and d.share_names and not Edits then                  -- a page has opened: it gets the names (no numbers)
  Vml("ReadContacts", "GotNameList")
end
if not d then
  Busy = false
  if said and tostring(said.error or ""):find("device key") then
    Vml("RunScript", "SignOutNow")
    return State("The server doesn't know this phone any more: sign in again.")
  end
  return State("Can't reach the server just now (" .. tostring(why) .. "). Trying again shortly.")
end
if not d.id or d.id == 0 then
  Busy = false
  return State(Paused and "Paused." or ("Working: nothing waiting (" .. Now() .. ")."))
end
Sending = { id = d.id, to = d.to, text = d.text, more = d.more or 0, name = (d.to_name ~= "" and d.to_name) or nil }
local exact = Sending.name and KeptTable("labelled_numbers")[Sending.name]
if (d.to or "") == "" and type(exact) == "string" then Sending.to = exact; d.to = exact end   -- "Sue · work": that very number
if (d.to or "") == "" and Sending.name then               -- written to a name: this phone finds the number
  State("Finding " .. Sending.name .. "'s number...")
  local who = Sending.name:gsub(" · [^·]*$", "")         -- "Sue · work" not known here yet: Sue, at least
  return Vml("LookupNumber", who, LastNumbers()[Sending.name] or "", "NumberFound")
end
State("Sending to " .. Masked(d.to) .. "...")
Vml("SmsSend", d.to, d.text, "Sent")
LUA

@Script Sent
Interpreter=lua
<<LUA
local m = Sending
Sending = nil
if not m then Busy = false; return end
local ok = args[1] == "sent"
if ok and m.name then                                      -- remember which number a name was sent to, for next time
  local last = LastNumbers(); last[m.name] = m.to; Vml("SetSetting", "last_numbers", json.encode(last))
end
if ok then Sent = Sent + 1; Note("Sent to " .. (m.name or Masked(m.to)) .. ".")
else Failed = Failed + 1; Note("Not sent to " .. Masked(m.to) .. ": " .. tostring(args[2])) end
Counts()
Server("sms_status", { message_id = m.id, status = ok and "sent" or "failed", error = ok and "" or args[2], number = m.name and m.to or nil },
    m.more > 0 and "Again" or "Done")
LUA

@Script Again
Interpreter=lua
<<LUA
Busy = false
Vml("RunScript", "Poll")
LUA

@Script Done
Interpreter=lua
<<LUA
Busy = false
State(Paused and "Paused." or ("Working: all sent (" .. Now() .. ")."))
LUA

# --- texts that arrive: passed to the server, which emails them on ----------

@Script Heard
Interpreter=lua
<<LUA
local from, text = args[1], args[2]
if from == "" then return Note(text) end                  -- it couldn't listen: text says why
Replies = Replies + 1
Counts()
Note("Text from " .. Masked(from) .. ".")
HeardQ[#HeardQ + 1] = { from = from, body = text }
Vml("LookupNames", json.encode({ from }), "HeardNamed")
LUA

@Script Forwarded
Interpreter=lua
<<LUA
local d, why = Answer(args[1], args[2])
if not d then Note("That text didn't reach the server: " .. tostring(why)) end
LUA

# --- pushes: the server's "a text is waiting", so it goes now, not at the next ask ---

@Script Pushed
Interpreter=lua
<<LUA
local kind, what = args[1], args[2]
if kind == "token" then                                  -- this phone's push address: the server keeps it
  Server("push_token", { push_token = what }, "PushNoted")
elseif kind == "message" then
  Vml("RunScript", "Poll")
else
  Vml("SetSetting", "push_ok", "")
  PollEvery()
  Note("Pushes aren't working (" .. tostring(what) .. "): asking every few seconds instead.")
end
LUA

@Script PushNoted
Interpreter=lua
<<LUA
local d, why = Answer(args[1], args[2])
if d then
  Vml("SetSetting", "push_ok", "1")
  Note("Pushes on: the server wakes this phone for each text, so it asks only every " .. PollEvery() .. " seconds.")
else
  Vml("SetSetting", "push_ok", "")
  PollEvery()
  Note("The server didn't take this phone's push address: " .. tostring(why))
end
LUA

# ============================================================================
# The console: a computer or a browser, sending through the gateway phone.
# ============================================================================

@Script ConsoleIn
Interpreter=lua
<<LUA
Vml("SetProperty", "txtPass", "Text", "")
local d, why = Answer(args[1], args[2])
if not d or not d.key then return State("Not signed in: " .. tostring(why or "the server gave this computer no key")) end
Vml("SetSetting", "console_key", d.key)
Vml("SetSetting", "console_who", d.username or "")
BeginConsole()
LUA

@Script Refresh
Interpreter=lua
<<LUA
if Kept("console_key") == "" then return end
Console("status", nil, "GotStatus")      -- light: the rest is fetched only when it says something changed
LUA

@Script GotStatus
Interpreter=lua
<<LUA
local d, why, said = Answer(args[1], args[2])
if not d then
  if said and tostring(said.error or ""):find("sign in") then return Vml("RunScript", "ConsoleOut") end
  return State("Can't reach tiny-web.uk just now: trying again shortly.")
end
local g = d.gateway
if not g then return State("No gateway phone yet: install TinySMS on an Android phone and sign in there.") end
local waiting = (d.waiting or 0) > 0 and ("  ·  " .. d.waiting .. " waiting") or ""
if not g.online and g.push then
  State("Gateway " .. (g.model or "phone") .. " is resting: it wakes for each text" .. waiting)
elseif g.online then
  State("Gateway " .. (g.model or "phone") .. " is awake" .. (g.battery and ("  ·  " .. g.battery .. "%") or "") .. waiting)
else
  State("Gateway " .. (g.model or "phone") .. " last seen " .. (g.seen or "a while ago") .. ": texts wait until it's back" .. waiting)
end
-- Something new (a text in or out, a status, a name)? Only then the heavier lists are fetched again.
if d.changes == nil or d.changes ~= LastChanges then
  LastChanges = d.changes
  Console("conversations", nil, "GotConvs")
  if Current then Console("thread", { number = Current }, "GotThread") end
end
LUA

@Script GotConvs
Interpreter=lua
<<LUA
local d = Answer(args[1], args[2])
if not d then return end
local rows = {}
for _, c in ipairs(d.items or {}) do
  rows[#rows + 1] = ((c.name or "") ~= "" and (c.name .. "  ") or "") .. c.number .. "  ·  " .. c.count .. (c.replies > 0 and (" (" .. c.replies .. " in)") or "") .. "  ·  " .. c.last
end
local items = table.concat(rows, ",")
if items ~= Convs then
  Convs = items
  Vml("SetProperty", "lstConv", "Items", items)
end
LUA

@Script PickConv
Interpreter=lua
<<LUA
local item = Vml("GetProperty", "lstConv", "SelectedItem")
local number = item:match("(%+?%d%d%d%d%d%d+)")
if not number or number == Current then return end
Current = number
Vml("SetProperty", "txtTo", "Text", number)
Vml("SetProperty", "lblThread", "Text", "")
Console("thread", { number = number }, "GotThread")
LUA

@Script GotThread
Interpreter=lua
<<LUA
local d = Answer(args[1], args[2])
if not d or d.number ~= Current then return end
CurrentName = d.name or ""
local lines = {}
if CurrentName ~= "" then lines[1] = CurrentName .. "   (" .. d.number .. ")" end
-- The box holds about twelve lines and a long text wraps onto more, so fill it from the newest back:
-- the latest always shows, at the bottom, and the oldest that don't fit drop off the top.
local items, shown, room = d.items or {}, {}, 12 - #lines
for i = #items, 1, -1 do
  local m = items[i]
  local mark = m.direction == "inbound" and "←  " or "→  "
  local note = (m.status == "failed" and "  (not sent)") or ((m.status == "pending" or m.status == "sending") and "  (waiting)") or ""
  local line = mark .. m.at .. "   " .. m.body .. note
  local tall = math.max(1, math.ceil((utf8.len(line) or #line) / 52))
  if tall > room and #shown > 0 then break end
  room = room - tall
  table.insert(shown, 1, line)
end
for _, line in ipairs(shown) do lines[#lines + 1] = line end
Vml("SetProperty", "lblThread", "Text", #lines > 0 and table.concat(lines, "\n") or "Nothing yet with this number.")
LUA

@Script DoSend
Interpreter=lua
<<LUA
local to = Vml("GetProperty", "txtTo", "Text")
local text = Vml("GetProperty", "txtMsg", "Text")
local digits = to:gsub("%D", "")
to = to:match("^%s*(.-)%s*$")
if to == "" then return State("Who to? A number, or a name from your phone.") end
if not to:match("%a") and (#digits < 10 or #digits > 15) then return State("That number doesn't look right: " .. #digits .. " digits.") end
if text:match("^%s*$") then return State("Write the message first.") end
State("Sending...")
Vml("SetProperty", "btnSend", "IsEnabled", "false")
Console("send", { to = to, text = text }, "ConsoleSent")
LUA

@Script ConsoleSent
Interpreter=lua
<<LUA
Vml("SetProperty", "btnSend", "IsEnabled", "true")
local d, why = Answer(args[1], args[2])
if not d then return State("Not sent: " .. tostring(why)) end
Vml("SetProperty", "txtMsg", "Text", "")
if (d.number or "") ~= "" then Current = d.number end
State(d.woke and "On its way: the phone was woken." or "Queued: it goes when the phone next checks in.")
Vml("RunScript", "Refresh")
LUA

@Script DoConsoleOut
Interpreter=lua
<<LUA
Console("signout")
Vml("RunScript", "ConsoleOut")
LUA

@Script ConsoleOut
Interpreter=lua
<<LUA
Vml("SetSetting", "console_key", "")
Vml("SetProperty", "tmr", "IsEnabled", "false")
Current, Convs = nil, ""
Vml("SetProperty", "lstConv", "Items", "")
Vml("SetProperty", "lblThread", "Text", "")
Page("signin")
State("Signed out of this computer. Your phone carries on as before.")
LUA

# --- the address book: names for numbers ---------------------------------------


@Script DoName
Interpreter=lua
<<LUA
local number = Current or Vml("GetProperty", "txtTo", "Text")
if #(number:gsub("%D", "")) < 6 then return State("Pick a conversation, or type a number, first.") end
local name = Vml("PromptDialog", "Name this number", "A name for " .. number .. ":", CurrentName)
if name == "" or name == CurrentName then return end
Console("name", { number = number, name = name }, "Named")
LUA

@Script Named
Interpreter=lua
<<LUA
local d, why = Answer(args[1], args[2])
if not d then return State("Not named: " .. tostring(why)) end
CurrentName, Convs, LastChanges = d.name, "", nil
Vml("RunScript", "Refresh")
LUA

# --- names, looked up on this phone: for a number on a screen, or a reply's sender ---

@Script NamesFound
Interpreter=lua
<<LUA
local names = json.decode(args[1] or "")
if type(names) ~= "table" then return Note("Names not looked up: " .. tostring(args[2])) end
Server("names", { names = names })
LUA

@Script HeardNamed
Interpreter=lua
<<LUA
local m = table.remove(HeardQ, 1)
if not m then return end
local names = json.decode(args[1] or "") or {}
Server("sms_received", { from_number = m.from, body = m.body, from_name = (type(names) == "table" and names[m.from]) or "" }, "Forwarded")
LUA

# --- texting by name: the names go to the account, the numbers stay here -------

@Script GotNameList
Interpreter=lua
<<LUA
local list = json.decode(args[1] or "")
if type(list) ~= "table" then return Note("Contact names not shared: " .. tostring(args[2])) end
-- A name only, for someone with one number. Someone with more gets one entry per number, told apart by its
-- label ("Sue Hargreaves · work"), and which number each label means stays here on the phone.
local numbers, order = {}, {}
for _, c in ipairs(list) do
  if c.name and c.name ~= "" then
    if not numbers[c.name] then numbers[c.name] = {}; order[#order + 1] = c.name end
    table.insert(numbers[c.name], c)
  end
end
local names, labelled = {}, {}
for _, name in ipairs(order) do
  local mine = numbers[name]
  if #mine == 1 then
    names[#names + 1] = name
  else
    local used = {}
    for _, c in ipairs(mine) do
      local label = (c.label or "") ~= "" and c.label or "other"
      used[label] = (used[label] or 0) + 1
      if used[label] > 1 then label = label .. " " .. used[label] end
      local shown = name .. " · " .. label
      names[#names + 1] = shown
      labelled[shown] = c.number
    end
  end
end
Vml("SetSetting", "labelled_numbers", json.encode(labelled))
Server("name_list", { names = names }, "NameListShared")
LUA

@Script NameListShared
Interpreter=lua
<<LUA
local d = Answer(args[1], args[2])
if d then Note("Shared " .. (d.saved or 0) .. " contact names (not numbers), for texting by name.") end
LUA

@Script NumberFound
Interpreter=lua
<<LUA
local m = Sending
if not m then Busy = false; return end
if (args[1] or "") == "" then                             -- no number for that name on this phone
  Sending = nil
  Failed = Failed + 1
  Note("Not sent to " .. m.name .. ": " .. tostring(args[2]))
  Counts()
  return Server("sms_status", { message_id = m.id, status = "failed", error = tostring(args[2]) }, m.more > 0 and "Again" or "Done")
end
m.to = args[1]
State("Sending to " .. m.name .. "...")
Vml("SmsSend", m.to, m.text, "Sent")
LUA

@Script SaveNext
Interpreter=lua
<<LUA
-- One change at a time into the address book; when they are all done, the pages get the names afresh
local e = Edits and table.remove(Edits, 1)
if not e then
  Edits = nil
  return Vml("ReadContacts", "GotNameList")
end
local function plain(n) return (tostring(n or ""):gsub(" · [^·]*$", "")) end   -- "Sue · work" is Sue
e.name, e.old = plain(e.name), plain(e.old)
State("Saving " .. tostring(e.name) .. " to your contacts...")
Vml("SaveContact", e.name or "", e.number or "", e.old or "", "ContactDone")
LUA

@Script ContactDone
Interpreter=lua
<<LUA
if (args[1] or "") ~= "" then State("Saved " .. args[1] .. " to your contacts.") else Note("Contact not saved: " .. tostring(args[2])) end
Vml("RunScript", "SaveNext")
LUA
