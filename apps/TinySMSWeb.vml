@Timer tmr
Parent=c
Interval=5000
IsEnabled=false
OnTick=Refresh

# ============================================================================
# Scripts. Start runs when the page opens and holds everything the others share.
# ============================================================================

@Script Start
Interpreter=lua
<<LUA
json = require("dkjson")
CONSOLE = "https://tiny-web.uk/api/console.php"
VERSION = "2.1"          -- keep with the Window's Version above
Current = nil           -- the number whose conversation is open
Convs = ""              -- the list as last shown (only redrawn when it changes, so a choice isn't lost)

function Kept(key) return Vml("GetSetting", key) end
function Set(name, prop, value) Vml("SetProperty", name, prop, tostring(value)) end

function Answer(text, problem)
  local d = json.decode(text or "")
  if type(d) ~= "table" then return nil, problem ~= "" and problem or "The server's answer didn't make sense." end
  if d.ok == false or (problem ~= "" and not d.ok) then return nil, d.error or problem, d end
  return d
end

function Console(action, extra, handler)
  local q = { action = action, key = Kept("web_key") }
  for k, v in pairs(extra or {}) do q[k] = v end
  Vml("Fetch", CONSOLE, json.encode(q), handler or "")
end

function SignInPage(say)
  Set("pgMain", "IsVisible", false)
  Set("pgSignIn", "IsVisible", true)
  Set("lblSignState", "Text", say or "Your phone's texts, in this browser.")
  Set("tmr", "IsEnabled", false)
end

function MainPage()
  Set("pgSignIn", "IsVisible", false)
  Set("pgMain", "IsVisible", true)
  Set("tmr", "IsEnabled", true)
  Vml("RunScript", "Refresh")
end

-- 07700 900123 or +447700900123: the digits, to compare numbers however they were written
function Digits(n) return (tostring(n or ""):gsub("%D", "")) end

Set("lblTitle", "Text", "TinySMS Web " .. VERSION)
Set("lblBrand", "Text", "TinySMS Web " .. VERSION)
if Kept("web_key") ~= "" then MainPage() else SignInPage() end
LUA

@Script DoSignIn
Interpreter=lua
<<LUA
local user = Vml("GetProperty", "txtUser", "Text")
local pass = Vml("GetProperty", "txtPass", "Text")
if user == "" or pass == "" then return Set("lblSignState", "Text", "Your username (or email) and password, please.") end
Set("lblSignState", "Text", "Signing in...")
Console("login", { username = user, password = pass, label = "web" }, "SignedIn")
LUA

@Script SignedIn
Interpreter=lua
<<LUA
Set("txtPass", "Text", "")
local d, why = Answer(args[1], args[2])
if not d or not d.key then return Set("lblSignState", "Text", "Not signed in: " .. tostring(why or "no key came back")) end
Vml("SetSetting", "web_key", d.key)
MainPage()
LUA

@Script DoSignOut
Interpreter=lua
<<LUA
Console("signout")
Vml("SetSetting", "web_key", "")
Current, Convs = nil, ""
Set("lstConv", "Items", "")
Set("lblThread", "Text", "")
SignInPage("Signed out of this browser. Your phone carries on as before.")
LUA

@Script Refresh
Interpreter=lua
<<LUA
if Kept("web_key") == "" then return end
Console("status", nil, "GotStatus")
Console("conversations", nil, "GotConvs")
if Current then Console("thread", { number = Current }, "GotThread") end
LUA

@Script GotStatus
Interpreter=lua
<<LUA
local d, why, said = Answer(args[1], args[2])
if not d then
  if said and tostring(said.error or ""):find("sign in") then
    Vml("SetSetting", "web_key", "")
    return SignInPage("Please sign in again.")
  end
  return Set("lblGate", "Text", "Can't reach tiny-web.uk just now...")
end
local g = d.gateway
local waiting = (d.waiting or 0) > 0 and ("  ·  " .. d.waiting .. " waiting") or ""
if not g then
  Set("lblGate", "Text", "No gateway phone yet: sign in to TinySMS on one")
elseif g.online then
  Set("lblGate", "Text", "● Phone awake" .. (g.battery and ("  ·  " .. g.battery .. "%") or "") .. waiting)
elseif g.push then
  Set("lblGate", "Text", "● Phone resting: wakes for each text" .. waiting)
else
  Set("lblGate", "Text", "○ Phone last seen " .. (g.seen or "a while ago") .. waiting)
end
LUA

@Script GotConvs
Interpreter=lua
<<LUA
local d = Answer(args[1], args[2])
if not d then return end
local rows = {}
for _, c in ipairs(d.items or {}) do
  rows[#rows + 1] = c.number .. "     " .. c.last .. (c.replies > 0 and ("  ·  " .. c.replies .. " in") or "")
end
local items = table.concat(rows, ",")
if items ~= Convs then
  Convs = items
  Set("lstConv", "Items", items)
end
LUA

@Script PickConv
Interpreter=lua
<<LUA
local number = (Vml("GetProperty", "lstConv", "SelectedItem") or ""):match("^(%S+)")
if number then Vml("RunScript", "Open", number) end
LUA

@Script DoNew
Interpreter=lua
<<LUA
local number = Vml("GetProperty", "txtNew", "Text")
local n = #Digits(number)
if n < 10 or n > 15 then return Set("lblWithInfo", "Text", "That number doesn't look right: " .. n .. " digits.") end
Set("txtNew", "Text", "")
Vml("RunScript", "Open", number)
LUA

@Script Open
Interpreter=lua
<<LUA
local number = args[1]
if not number or number == "" then return end
Current = number
Set("lblWith", "Text", number)
Set("lblWithInfo", "Text", "Texts go out from your TinySMS phone")
Set("lblThread", "Text", "")
Set("txtMsg", "IsEnabled", true)
Set("btnSend", "IsEnabled", true)
Console("thread", { number = number }, "GotThread")
LUA

@Script GotThread
Interpreter=lua
<<LUA
local d = Answer(args[1], args[2])
if not d or not Current or Digits(d.number):sub(-10) ~= Digits(Current):sub(-10) then return end
Current = d.number
Set("lblWith", "Text", d.number)
local items, lines = d.items or {}, {}
for i = math.max(1, #items - 19), #items do      -- the newest that fit, oldest at the top
  local m = items[i]
  local note = (m.status == "failed" and "   (not sent)") or ((m.status == "pending" or m.status == "sending") and "   (waiting)") or ""
  lines[#lines + 1] = m.at .. "     " .. (m.direction == "inbound" and "←  Them:  " or "→  You:  ") .. m.body .. note
end
Set("lblThread", "Text", #lines > 0 and table.concat(lines, "\n") or "Nothing yet with this number: say hello.")
LUA

@Script DoSend
Interpreter=lua
<<LUA
local text = Vml("GetProperty", "txtMsg", "Text")
if not Current or text:match("^%s*$") then return end
Set("btnSend", "IsEnabled", false)
Set("lblWithInfo", "Text", "Sending...")
Console("send", { to = Current, text = text }, "Sent")
LUA

@Script Sent
Interpreter=lua
<<LUA
Set("btnSend", "IsEnabled", true)
local d, why = Answer(args[1], args[2])
if not d then return Set("lblWithInfo", "Text", "Not sent: " .. tostring(why)) end
Set("txtMsg", "Text", "")
Set("lblWithInfo", "Text", d.woke and "On its way: your phone was woken" or "Queued: it goes when your phone next checks in")
Vml("RunScript", "Refresh")
LUA
