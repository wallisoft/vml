# --- shared styles (Class=...): web pages and phones get all of it; the desktop all but the shadows' softness ---

@Style tab
<<CSS
background: rgba(255,255,255,0.16); color: #FFFFFF; border: none; border-radius: 17px
:hover { background: rgba(255,255,255,0.26) }
:pressed { background: rgba(255,255,255,0.34) }
CSS

@Style on
<<CSS
background: #FFFFFF; color: #4F46E5; box-shadow: 0 2px 10px rgba(30,27,75,0.28)
:hover { background: #FFFFFF }
CSS

@Style chip
<<CSS
background: #FFFFFF; color: #1F2937; border: 1.5px solid #DDD6FE; border-radius: 14px; box-shadow: 0 1px 3px rgba(79,70,229,0.10); transition: background .15s, border-color .15s
:hover { background: #F5F3FF; border-color: #C4B5FD }
:pressed { background: #EDE9FE }
CSS

@Style primary
<<CSS
background: linear-gradient(135deg, #6366F1, #4F46E5); color: #FFFFFF; border: none; border-radius: 22px; box-shadow: 0 4px 12px rgba(79,70,229,0.35)
:hover { background: linear-gradient(135deg, #4F46E5, #4338CA) }
:pressed { background: #4338CA }
CSS

@Style round
<<CSS
border-radius: 21px
CSS

@Style field
<<CSS
background: #FFFFFF; border: 1.5px solid #DDD6FE; border-radius: 21px; padding: 0 12px; outline: none; transition: border-color .15s, box-shadow .15s
:focus { border-color: #6366F1; box-shadow: 0 0 0 3px rgba(99,102,241,0.18); outline: none }
CSS

@Style box
<<CSS
background: #FFFFFF; border: 1.5px solid #DDD6FE; border-radius: 12px
:focus { border-color: #A5B4FC; outline: none }
CSS

@Script Opened
Interpreter=lua
<<LUA
-- Every word: its BCI number, its pictures, the numbers of the words it is built from, then its words in each language (a tab between languages, ';' between words).
DICT = [==[
8497	1️⃣		one (digit);1;modifier (first person)	ett;1	en;1	1	yksi;1	einn;1	eins;1	één;1	een;1	un (chiffre);1	uno (dígito);1	um;1	uno;una;1	jeden (cyfra);1	egy;1	vienas;1	viens;(cipars);1	один;1	unu (cifero);1;modifilo (unua persono)
8498	2️⃣		two (digit);2;modifier (second person)	två;2	to;2	2	kaksi;2	tveir;2	zwei;2	twee;2	twee;2	deux (chiffre);2	dos (dígito);2	dois;2	due;2	dwa (cyfra);2	kettő;2	du;2	divi;(cipars);2	два;2	du (cifero);2;modifilo (dua persono)
8499	3️⃣		three (digit);3;modifier (third person)	tre;3	tre;3	3	kolme;3	þrír;3	drei;3	drie;3	drie;3	trois (chiffre);3	tres (dígito);3	três;3	tre;3	trzy (cyfra);3	három;3	trys;3	trīs;(cipars);3	три;3	tri (cifero);3;modifilo (tria persono)
8500	4️⃣		four (digit);4	fyra;4	fire;4	4	neljä;4	fjórir;4	vier;4	vier;4	vier;4	quatre (chiffre);4	cuatro (dígito);4	quatro;4	quattro;4	cztery (cyfra);4	négy;4	keturi;4	četri;(cipars);4	четыре;4	kvar (cifero);4
8501	5️⃣		five (digit);5	fem;5	fem;5	5	viisi;5	fimm;5	fünf;5	vijf;5	vyf;5	cinq (chiffre);5	cinco (dígito);5	cinco;5	cinque;5	pięć (cyfra);5	öt;5	penki;5	pieci;(cipars);5	пять;5	kvin (cifero);5
8503	7️⃣		seven (digit);7	sju;7	syv;7	7	seitsemän;7	sjö;7	sieben;7	zeven;7	sewe;7	sept (chiffre);7	siete (dígito);7	sete;7	sette;7	siedem (cyfra);7	hét;7	septyni;7	septiņi;(cipars);7	семь;7	sep (cifero);7
8993	▶️		indicator (action)	operator (handling, infinitiv)	indikator (infinitiv, handling)		toiminnan merkki	vísir (verknaður)	Indikator (Handlung, Infinitiv, Gegenwart)	indicator tegenwoordige tijd	aanwyser (teenwoordige tyd, infinitief) (aksie)	indicateur de verbe (action)	indicador (acción)			wyznacznik czasownika	cselekvésjel (igét jelző nyelvtani indikátor)	rodiklis (veiksmažodio)	indikators (darbības vārds)	индикатор (неопр.ф.гл.)	indikilo (ago)
8996	🔖	8998 13867	indicator (description after fact)	operator (värdering efter faktum)	indikator (vurdering etter fakta)		kuvailu tilanteen jälkeen -merkki	vísir (lýsing á eftir staðreynd)	Indikator (Beschreibung nach Tatsache, Partizip II)	indicator beschrijving na feit	aanwyser (na die feit)	indicateur d'évaluation après le fait	indicador (descripción posterior al hecho)			wyznacznik przymiotnika o zakończonym wartościowaniu (np. śmierć z tym wyznacznikem utworzy symbol „zmarły)	múlt idejű melléknévi igenév jele	rodiklis (po fakto)	indikators (pagātnes forma)	индикатор (описание после факта)	indikilo (priskribo post fakto)
8997	🔮	13867 8998	indicator (description before fact)	operator (värdering före faktum)	indikator (vurdering før fakta)		kuvailu ennen tilannetta -merkki	vísir (lýsing á undan staðreynd)	Indikator (Beschreibung vor der Tatsache)	indictor beschrijving voor het feit	aanwyser (voor die feit)	indicateur d'évaluation avant le fait	indicador (descripción anterior al hecho)			wyznacznik przymiotnika o niezakończonym wartościowaniu (śmierć--> umierający)	jelen idejű melléknévi igenév jele	rodiklis (prieš faktą)	indikators (līdz faktam)	индикатор (описание до факта)	indikilo (priskribo antaŭ fakto)
8998	🏷️		indicator (description)	operator (värdering, adjektiv, adverb)	indikator (vurdering)		kuvailun merkki	vísir (lýsing, lýsingarorð)	Indikator (Beschreibung, Adjektive, Adverbien)	indicator beschrijving	aanwyser (beskrywing)	indicateur de description	indicador (descripción)			wyznacznik przymiotnika	minősítő jel (melléknevet jelző nyelvtani indikátor)	rodiklis (ateities veiksmo)	indikators (aprakstoša forma)	индикатор (имя прилаг.,описание)	indikilo (priskribo)
9009	🔳		indicator (thing)	operator (konkretisering)	indikator (konkretisering)		esineen merkki	vísir (hlutur)	Indikator (Ding)	dingindicator	aanwyser (iets ding goed)	indicateur d'objet (signification concrète)	indicador (cosa)			wyznacznik rzeczownika	konkrét tárgy jele	rodiklis	indikators (konkrētā forma)	индикатор (конкретная форма)	indikilo (aĵo)
9010	🔳⁠✳️	9009 9011	indicator (thing plural)	operator (konkretisering i plural)	indikator (konkretisering i pluralis, flertall)		esineen ja monikon merkki	vísir (hlutir)	Indikator (Ding Plural)	dingindicator meervoud	aanwyser (dinge goedere voorwerpe meervoud)	indicateur d'objet pluriel	indicador (cosas)			wyznacznik rzeczownika w liczbie mnogiej	konkrét tárgyak jele (tbsz.)	rodiklis	indikators (konrtētē forma, daudz)	индикатор (конкретная форма, мн.ч.)	indikilo (aĵo pluralo)
9011	✳️		indicator (plural)	operator (flertal, plural)	indikator (plural, flertall)		monikon merkki	vísir (fleirtala)	Indikator (Plural)	indicator meervoud	aanwyser (meervoud)	indicateur du pluriel	indicador (plural)			wyznacznik liczby mnogiej	többes szám jele	rodiklis	indikators (daudz)	индикатор (мн.ч.)	indikilo (pluralo)
12322	🦸	13867 13949	ability;capability;capacity;potential	förmåga;kapacitet	evne;kapasitet	evne;duelighed	kyky	geta;möguleiki	Fähigkeit;Können;Eignung	vaardigheid;kunde	vermoë;kundigheid;kapasiteit;moontlikheid	capacité;aptitude;compétence	capacidad;habilidad;potencial	habilidade;capacidade	capacità;abilità	zdolność;możliwość	képesség;kapacitás;potenciál	įgūdis;gebėjimas	spēja;spējas;potenciāls	способность;потенциал	kapablo;kapableco;kapacito;potencialo
