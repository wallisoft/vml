function Show()
  Vml("SetProperty", "lblMsg", "Text", table.concat(Msg, "  "))
end

function ReadOut(text)
  text = text:gsub(WJ, "")
  -- Pictures back into words: each group (separated by spaces) is looked up whole; a group that isn't a
  -- word on its own is read picture by picture, longest known run first.
  local out = {}
  for group in text:gmatch("%S+") do
    if Read[group] then
      out[#out + 1] = Read[group]
    else
      local i, parts = 1, {}
      while i <= #group do
        local found
        for j = #group, i, -1 do
          local bit = group:sub(i, j)
          if Read[bit] then found = j; parts[#parts + 1] = Read[bit]; break end
        end
        if not found then
          -- skip one character (a UTF-8 lead byte and its continuation bytes)
          local c = group:byte(i)
          local n = c >= 0xF0 and 4 or c >= 0xE0 and 3 or c >= 0xC0 and 2 or 1
          i = i + n
        else
          i = found + 1
        end
      end
      out[#out + 1] = #parts > 0 and "(" .. table.concat(parts, " + ") .. ")" or "?"
    end
  end
  return table.concat(out, " ")
end

-- The dictionary: one word to a line, word=pictures. Read once, into a list (for looking up) and a
-- reverse table (for reading pictures back).
WJ = "\226\129\160"          -- the word joiner between a word's pictures (U+2060), invisible
Words, Read, Msg, Shown = {}, {}, {}, {}
for word, pic in DICT:gmatch("([^\n=]+)=([^\n]+)") do
  Words[#Words + 1] = { word, word:lower(), pic }
  local bare = pic:gsub(WJ, "")
  if not Read[bare] then Read[bare] = word end
end
Vml("SetProperty", "lblMeaning", "Text", #Words .. " words. Type one, then tap it to add its pictures.")
LUA

@Script Find
Interpreter=lua
<<LUA
local q = Vml("GetProperty", "txtWord", "Text") or ""
q = q:gsub("^%s+", ""):gsub("%s+$", "")
if q == "" then
  Shown = {}
  Vml("SetProperty", "lstFound", "Items", "")
  return
end
if q:find("[\128-\255]") and not q:find("[%a]") then
  -- pictures pasted in: read them
  local words = ReadOut(q)
  Vml("SetProperty", "lblMeaning", "Text", "It says: " .. (words or ""))
  return
end
-- words: the exact ones first, then those starting with it, then those containing it
local lq = q:lower()
local exact, starts, inside = {}, {}, {}
for _, w in ipairs(Words) do
  local name = w[2]
  if name == lq or name == "to " .. lq then exact[#exact + 1] = w
  elseif name:sub(1, #lq) == lq or name:sub(1, #lq + 3) == "to " .. lq then starts[#starts + 1] = w
  elseif #lq > 2 and name:find(lq, 1, true) then inside[#inside + 1] = w end
end
Shown = {}
local items = {}
for _, list in ipairs({ exact, starts, inside }) do
  for _, w in ipairs(list) do
    if #Shown >= 40 then break end
    Shown[#Shown + 1] = w
    items[#items + 1] = (w[3] .. "   " .. w[1]):gsub(",", " ")
  end
end
Vml("SetProperty", "lstFound", "Items", table.concat(items, ","))
Vml("SetProperty", "lblMeaning", "Text", #Shown == 0 and "No word like that yet." or "Tap one to add it.")
LUA

@Script Pick
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "lstFound", "SelectedIndex")) or -1
local w = Shown and Shown[i + 1]
if not w then return end
Msg[#Msg + 1] = w[3]
Show()
Vml("SetProperty", "lblMeaning", "Text", "Added: " .. w[1])
Vml("SetProperty", "txtWord", "Text", "")
LUA

@Script DoBack
Interpreter=lua
<<LUA
table.remove(Msg)
Show()
LUA

@Script DoClear
Interpreter=lua
<<LUA
Msg = {}
Show()
LUA

@Script DoCopy
Interpreter=lua
<<LUA
Vml("ClipboardSet", table.concat(Msg, " "))
Vml("SetProperty", "lblMeaning", "Text", "Copied. Paste it anywhere: anyone can read pictures.")
LUA

@Script DoShare
Interpreter=lua
<<LUA
Vml("Share", table.concat(Msg, " "))
LUA

