-- The lessons: a title, then the BCI numbers of the words it teaches.
LESSONS = [==[
🧩|14676 16702 14702 14454 17750 18295 17513 16734 15154 15662 14401 15981 13618 13875 16455
🧑|16161 15416 18269 13166 12603 14401 12888 14439
❤️|14164 17983 13869 14676 16702 15399 12377 13416 12615
▶️|13906 13881 17008 17718 15161 16465 18285 13618 13875 15184
👄|15666 14390 12613 14702 14454 17210 16728 16445 12393 17533
📅|13639 17212 15975 14417 15719 17462 15651 17750 18295 17744 15656 13950 18217
🍴|14377 18209 14405 12895 14183 14912 17719 12898 15154 13408 18258
🏠|14905 16687 16193 13423 13900 14885 23198 14899 23223 13351 14422
🛡️|16420 8498 8499 15662 14157 16994 12909 14629 14626 13427 15968
🐾|12378 12837 14188 17775 14205 16196 12383 12380 14897 14943 17189 14386
❓|16445 18229 16482 18236 18234 14906 18238
]==]

WJ = "\226\129\160"          -- the word joiner between a word's pictures (U+2060), invisible
Said, Shown, Words, Read, Index, ById, Lesson, Quiz = {}, {}, {}, {}, {}, {}, {}, nil
PicId = {}           -- pictures -> the BCI number of their word (for its Blissymbol)
LogShown = true
Linked = false
if math.randomseed then pcall(function() math.randomseed(os and os.time and os.time() or 7) end) end

-- lower case for the scripts the dictionary uses: Latin (with accents), Cyrillic, Greek-free
function Lower(s)
  s = s:lower()
  s = s:gsub("\195([\128-\158])", function(c) local b = c:byte(); if b ~= 151 then return "\195" .. string.char(b + 32) end end)
  s = s:gsub("\208([\144-\159])", function(c) return "\208" .. string.char(c:byte() + 32) end)
  s = s:gsub("\208([\160-\175])", function(c) return "\209" .. string.char(c:byte() - 32) end)
  s = s:gsub("\208([\128-\143])", function(c) return "\209" .. string.char(c:byte() + 16) end)
  return s
end

function Bare(p) return (p:gsub(WJ, "")) end

-- one language (column n): the word list, the reverse table for reading, and the index for typing
function UseLanguage(n)
  Words, Read, Index, ById = {}, {}, {}, {}
  for line in DICT:gmatch("[^\n]+") do
    local col, id, pic, parts, cell = 0, nil, nil, nil, nil
    for field in (line .. "\t"):gmatch("([^\t]*)\t") do
      if col == 0 then id = field elseif col == 1 then pic = field elseif col == 2 then parts = field elseif col == n + 2 then cell = field break end
      col = col + 1
    end
    if pic and id and not PicId[Bare(pic)] then PicId[Bare(pic)] = id end
    if pic and cell and cell ~= "" then
      local bare, first = Bare(pic), nil
      for word in cell:gmatch("[^;]+") do
        first = first or word
        Words[#Words + 1] = { word, Lower(word), pic, id }
        local key = Lower(word):gsub("%s*%(.-%)", "")
        if not Index[key] or #Index[key] > #pic then Index[key] = pic end
        -- an entry with punctuation inside ("hei! Terve!") is found without it too
        local plain = key:gsub("[!?¡¿.,;:]", ""):gsub("%s+", " "):gsub("^ ", ""):gsub(" $", "")
        if plain ~= key and plain ~= "" and not Index[plain] then Index[plain] = pic end
        local bare_verb = key:match("^to (.+)$")
        if bare_verb and not Index[bare_verb] then Index[bare_verb] = pic end
      end
      if not Read[bare] then Read[bare] = first end
      ById[id] = { pic, first, parts }
    end
  end
end

-- "hello friend" in the chosen language: ready in the message box on every new chat, the first thing anyone sees
-- and the first thing they send. (Of each word's names in that language, the first that reads back as its picture.)
function Greeting()
  local function say(id)
    local one, first
    for _, w in ipairs(Words) do
      if w[4] == id then
        local plain = w[1]:gsub("%s*%(.-%)", "")
        local pics = ToPictures(plain)
        if #pics == 1 and pics[1] == w[3] then return plain end           -- reads back as exactly this word
        if #pics == 1 and not one then one = plain end                    -- reads back as one picture
        first = first or plain:match("^[^%s%p]+")                         -- (its first word, at the least)
      end
    end
    return one or first
  end
  local hello, friend = say("14702"), say("14401")
  return hello and friend and (hello .. " " .. friend) or ""
end
function OfferGreeting()
  local now = Vml("GetProperty", "txtSay", "Text") or ""
  if now == "" or now == Greeted then          -- (never over what someone has typed)
    Greeted = Greeting()
    Vml("SetProperty", "txtSay", "Text", Greeted)
    Vml("RunScript", "Convert")
  end
end

-- pictures back into words: a group whole if it is a word, else the longest known runs
function ReadOut(text)
  text = text:gsub(WJ, "")
  local out = {}
  for group in text:gmatch("%S+") do
    if Read[group] then out[#out + 1] = Read[group]
    else
      local i, parts = 1, {}
      while i <= #group do
        local found
        for j = #group, i, -1 do
          local bit = group:sub(i, j)
          if Read[bit] then found = j; parts[#parts + 1] = Read[bit]; break end
        end
        if found then i = found + 1 else
          local c = group:byte(i)
          i = i + (c >= 0xF0 and 4 or c >= 0xE0 and 3 or c >= 0xC0 and 2 or 1)
        end
      end
      out[#out + 1] = #parts > 0 and "(" .. table.concat(parts, " + ") .. ")" or "?"
    end
  end
  return table.concat(out, " ")
end

function HasLetters(t)
  local rest = t:gsub(WJ, ""):gsub("[\240-\247][\128-\191][\128-\191][\128-\191]", ""):gsub("\239\184\143", "")
    :gsub("\226[\128-\191][\128-\191]", ""):gsub("[%s%p%d]", "")
  return rest ~= ""
end

-- what you typed, in your language, into pictures: the longest phrase it knows first (up to three words);
-- pictures typed or picked pass straight through; words it doesn't know are left out and listed
function ToPictures(text)
  local toks = {}
  for t in text:gmatch("%S+") do
    if HasLetters(t) then
      t = Lower(t):gsub("^[%p]+", ""):gsub("[%p]+$", "")
      if t ~= "" then toks[#toks + 1] = { t, false } end
    else toks[#toks + 1] = { t, true } end
  end
  local pics, skipped, i = {}, {}, 1
  while i <= #toks do
    if toks[i][2] then pics[#pics + 1] = toks[i][1]; i = i + 1
    else
      local done = false
      for n = 3, 1, -1 do
        if i + n - 1 <= #toks then
          local words, ok = {}, true
          for k = i, i + n - 1 do if toks[k][2] then ok = false break end words[#words + 1] = toks[k][1] end
          if ok then
            local key = table.concat(words, " ")
            local pic = Index[key]
            if not pic and n == 1 and #key > 4 then pic = Index[key:sub(1, -2)] or Index[key:sub(1, -3)] end
            if pic then pics[#pics + 1] = pic; i = i + n; done = true break end
          end
        end
      end
      if not done then skipped[#skipped + 1] = toks[i][1]; i = i + 1 end
    end
  end
  return pics, skipped
end

-- how a word is built: each of its roots with its meaning (a grammar marker shows as its picture alone)
-- a part as it appears inside a word: without its own grammar marker (Bliss drops those inside words)
local function inside(p)
  local pic = Bare(ById[p][1])
  if MARKERS[p] then return pic end
  for m in pairs(MARKERS) do
    local mp = ById[m] and Bare(ById[m][1])
    if mp and mp ~= "" and #pic > #mp and pic:sub(-#mp) == mp then pic = pic:sub(1, -#mp - 1) end
  end
  return pic
end

function Roots(id, deep)
  local w = ById[id]
  if not w or not w[3] or w[3] == "" then return "" end
  local out, n = {}, 0
  for p in w[3]:gmatch("%S+") do
    n = n + 1
    local r = ById[p]
    if r then
      local sub = (deep ~= false and not MARKERS[p]) and Roots(p, false) or ""
      out[#out + 1] = inside(p) .. (MARKERS[p] and "" or " " .. r[2]) .. (sub ~= "" and " (" .. sub .. ")" or "")
    end
  end
  if n < 2 and #out < 2 then return "" end
  return table.concat(out, "  +  ")
end

function Explain(id)
  local w = ById[id]
  if not w then return "" end
  local roots = Roots(id)
  return Bare(w[1]) .. "  " .. w[2] .. (roots ~= "" and ("\n=  " .. roots) or "")
end

-- ---------------------------------------------------------------- Blissymbols
INK = "#1F2937"
-- the words of a message, as BCI numbers: { number, starts a new word }
function BlissIds(text)
  local ids = {}
  for group in Bare(text):gmatch("%S+") do
    if PicId[group] then ids[#ids + 1] = { PicId[group], true }
    else
      local i, first = 1, true
      while i <= #group do
        local found
        for j = #group, i, -1 do
          local id = PicId[group:sub(i, j)]
          if id then ids[#ids + 1] = { id, first }; first = false; found = j; break end
        end
        if found then i = found + 1 else
          local c = group:byte(i)
          i = i + (c >= 0xF0 and 4 or c >= 0xE0 and 3 or c >= 0xC0 and 2 or 1)
        end
      end
    end
  end
  return ids
end

local function esc(t) return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
-- one word's strokes as SVG
function BlissStrokes(d)
  local out = {}
  for it in d:gmatch("[^;]+") do
    local fill = "none"
    if it:sub(1, 1) == "!" then fill = INK; it = it:sub(2) end
    local k, r = it:sub(1, 1), it:sub(2)
    local K = k:upper()
    local extra = (k ~= K and ' stroke-width="1"' or "") .. (fill ~= "none" and (' fill="' .. fill .. '"') or "")
    if K == "L" then
      local a, b, c, e = r:match("^([^,]+),([^,]+),([^,]+),([^,]+)$")
      if a then out[#out + 1] = '<line x1="' .. a .. '" y1="' .. b .. '" x2="' .. c .. '" y2="' .. e .. '"' .. extra .. '/>' end
    elseif K == "C" then
      local a, b, c = r:match("^([^,]+),([^,]+),([^,]+)$")
      if a then out[#out + 1] = '<circle cx="' .. a .. '" cy="' .. b .. '" r="' .. c .. '"' .. extra .. '/>' end
    elseif K == "E" then
      local a, b, c, e = r:match("^([^,]+),([^,]+),([^,]+),([^,]+)$")
      if a then out[#out + 1] = '<ellipse cx="' .. a .. '" cy="' .. b .. '" rx="' .. c .. '" ry="' .. e .. '"' .. extra .. '/>' end
    elseif K == "P" then
      out[#out + 1] = '<path d="' .. r .. '"' .. extra .. '/>'
    elseif K == "T" then
      local x, y, t = r:match("^([^|]*)|([^|]*)|(.*)$")
      if x then out[#out + 1] = '<text x="' .. x .. '" y="' .. y .. '" font-size="100" font-family="sans-serif" stroke="none" fill="' .. INK .. '">' .. esc(t) .. '</text>' end
    end
  end
  return table.concat(out)
end

function BlissWord(id)
  local at = BLISS:find("\n" .. id .. "\t", 1, true)
  if not at then return nil end
  local stop = BLISS:find("\n", at + 1, true) or (#BLISS + 1)
  local w, y0, h, d = BLISS:sub(at + 1, stop - 1):match("^%d+\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
  return tonumber(w), tonumber(y0) or 0, tonumber(h) or 324, d or ""
end

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
function Base64(s)
  local out = {}
  for i = 1, #s, 3 do
    local a, b, c = s:byte(i, i + 2)
    local n = a * 65536 + (b or 0) * 256 + (c or 0)
    local q1, q2, q3, q4 = math.floor(n / 262144) % 64, math.floor(n / 4096) % 64, math.floor(n / 64) % 64, n % 64
    out[#out + 1] = B64:sub(q1 + 1, q1 + 1) .. B64:sub(q2 + 1, q2 + 1) ..
      (b and B64:sub(q3 + 1, q3 + 1) or "=") .. (c and B64:sub(q4 + 1, q4 + 1) or "=")
  end
  return table.concat(out)
end

-- a message (or a word: pictures, or a BCI number) in Blissymbols: a picture's address and how wide it is at px tall
function BlissPicture(text, px)
  local list = text:match("^%d+$") and { { text, true } } or BlissIds(text)
  local parts, x = {}, 0
  for _, e in ipairs(list) do
    local w, y0, h, d = BlissWord(e[1])
    if w then
      local k = 324 / h
      if #parts > 0 then x = x + (e[2] and 72 or 20) end
      parts[#parts + 1] = string.format('<g transform="translate(%.1f,%.1f) scale(%g)">%s</g>', x, -y0 * k, k, BlissStrokes(d))
      x = x + w * k
    end
  end
  if #parts == 0 then return "", 0 end
  local vw, vh = x + 16, 280
  local width = px * vw / vh
  local svg = string.format('<svg xmlns="http://www.w3.org/2000/svg" viewBox="-8 44 %.1f %d" width="%d" height="%d" fill="none" stroke="%s" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">%s</svg>',
    vw, vh, math.floor(width * 2 + 0.5), px * 2, INK, table.concat(parts))
  return "data:image/svg+xml;base64," .. Base64(svg), width
end

-- show it in an Image (no wider than maxw; centred in that space if centre is given)
function ShowBliss(img, text, px, maxw, left, centre)
  local src, w = "", 0
  if text and text ~= "" then src, w = BlissPicture(text, px) end
  if src == "" then Vml("SetProperty", img, "IsVisible", "false") return end
  w = math.max(1, math.min(maxw, math.floor(w + 0.5)))
  Vml("SetProperty", img, "Source", src)
  Vml("SetProperty", img, "Width", tostring(w))
  if left then Vml("SetProperty", img, "Canvas.Left", tostring(centre and math.floor(left + (maxw - w) / 2) or left)) end
  Vml("SetProperty", img, "IsVisible", "true")
end

-- the conversation: the newest four messages
function ShowLog()
  local first = math.max(1, #Said - 3)
  for k = 1, 4 do
    local m, r = LogShown and Said[first + k - 1], tostring(k)
    Vml("SetProperty", "lblM" .. r, "Text", m and ((m[1] == "me" and "🙂 " or "👤 ") .. m[2]) or "")
    Vml("SetProperty", "lblR" .. r, "Text", m and ReadOut(m[2]) or "")
    ShowBliss("imgM" .. r, m and m[2] or "", 29, 284)
  end
end
function LogVisible(on)
  LogShown = on
  ShowLog()
end

function Tab(which)
  for _, t in ipairs({ "Chat", "Dict", "Learn" }) do
    Vml("SetProperty", "p" .. t, "IsVisible", t == which and "true" or "false")
    Vml("SetProperty", "btnTab" .. t, "Class", t == which and "tab on" or "tab")
  end
end

-- ---- lessons
function ShowLesson(n)
  local k, line = 0, nil
  for l in LESSONS:gmatch("[^\n]+") do k = k + 1; if k == n then line = l end end
  if not line then return end
  Lesson = {}
  for id in line:match("|(.*)$"):gmatch("%S+") do if ById[id] then Lesson[#Lesson + 1] = id end end
  local rows = {}
  for _, id in ipairs(Lesson) do rows[#rows + 1] = (Bare(ById[id][1]) .. "   " .. ById[id][2]):gsub(",", " ") end
  Vml("SetProperty", "lstLesson", "Items", table.concat(rows, ","))
  Vml("SetProperty", "lblRoots", "Text", Lesson[1] and Explain(Lesson[1]) or "")
  ShowBliss("imgLesson", Lesson[1] or "", 26, 336)
  Right, Asked = 0, 0
  NextQ()
end

function NextQ()
  if not Lesson or #Lesson < 2 then return end
  local id = Lesson[math.random(#Lesson)]
  local choices, seen = { id }, { [id] = true }
  while #choices < math.min(4, #Lesson) do
    local o = Lesson[math.random(#Lesson)]
    if not seen[o] then seen[o] = true; choices[#choices + 1] = o end
  end
  for i = #choices, 2, -1 do local j = math.random(i); choices[i], choices[j] = choices[j], choices[i] end
  Quiz = { id = id, choices = choices, answered = false }
  Vml("SetProperty", "lblQ", "Text", Bare(ById[id][1]))
  ShowBliss("imgQ", id, 26, 336, 12, true)
  for i = 1, 4 do
    local c = choices[i]
    Vml("SetProperty", "btnA" .. i, "Content", c and ById[c][2] or "")
    Vml("SetProperty", "btnA" .. i, "IsVisible", c and "true" or "false")
  end
  Vml("SetProperty", "lblScore", "Text", Asked > 0 and ("✅ " .. Right .. " / " .. Asked) or "❔")
end

function Answer(i)
  if not Quiz or Quiz.answered then return end
  Quiz.answered = true
  Asked = Asked + 1
  local good = Quiz.choices[i] == Quiz.id
  if good then Right = Right + 1 end
  Vml("SetProperty", "lblScore", "Text", (good and "✅ " or "❌ ") .. Right .. " / " .. Asked)
  Vml("SetProperty", "lblRoots", "Text", Explain(Quiz.id))
  if not good then Vml("Vibrate", "80") end
end

local saved = tonumber(Vml("GetSetting", "language") or "") or 0
Vml("SetProperty", "cboLang", "SelectedIndex", tostring(saved))
UseLanguage(saved + 1)
Vml("SetProperty", "cboLesson", "SelectedIndex", "0")
ShowLesson(1)
OfferGreeting()

-- opened from someone's code by a phone's camera: join their link straight away
local code = Vml("LinkInvite")
if code ~= "" and Vml("Link", "Got", code) ~= "" then Vml("SetProperty", "lblState", "Text", "⏳") end
LUA

