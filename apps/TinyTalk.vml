-- The lessons: a title, then the BCI numbers of the words it teaches.
LESSONS = [==[
🧑|16161 15416 18269 13166 12603 14401 12888 14439
❤️|14164 17983 13869 14676 16702 15399 12377 13416 12615
▶️|13906 13881 17008 17718 15161 16465 18285 13618 13875 15184
👄|15666 14390 12613 14702 14454 17210 16728 16445 12393 17533
📅|13639 17212 15975 14417 15719 17462 15651 17750 18295 17744 15656 13950 18217
🍴|14377 18209 14405 12895 14183 14912 17719 12898 15154 13408 18258
🏠|14905 16687 16193 13423 13900 14885 23198 14899 23223 13351 14422
🛡️|16420 8498 8499 15662 14157 16994 12909 14629 14626 13427 15968
🐾|12378 12837 14188 17775 14205 16196 12383 12380 14897 14943 17189 14386
❓|16445 18229 16482 18236 18234 14906 18238
]==]

WJ = "\226\129\160"          -- the word joiner between a word's pictures (U+2060), invisible
Said, Shown, Words, Read, Index, ById, Lesson, Quiz = {}, {}, {}, {}, {}, {}, {}, nil
Linked = false
if math.randomseed then pcall(function() math.randomseed(os and os.time and os.time() or 7) end) end

-- lower case for the scripts the dictionary uses: Latin (with accents), Cyrillic, Greek-free
function Lower(s)
  s = s:lower()
  s = s:gsub("\195([\128-\158])", function(c) local b = c:byte(); if b ~= 151 then return "\195" .. string.char(b + 32) end end)
  s = s:gsub("\208([\144-\159])", function(c) return "\208" .. string.char(c:byte() + 32) end)
  s = s:gsub("\208([\160-\175])", function(c) return "\209" .. string.char(c:byte() - 32) end)
  s = s:gsub("\208([\128-\143])", function(c) return "\209" .. string.char(c:byte() + 16) end)
  return s
end

function Bare(p) return (p:gsub(WJ, "")) end

-- one language (column n): the word list, the reverse table for reading, and the index for typing
function UseLanguage(n)
  Words, Read, Index, ById = {}, {}, {}, {}
  for line in DICT:gmatch("[^\n]+") do
    local col, id, pic, cell = 0, nil, nil, nil
    for field in (line .. "\t"):gmatch("([^\t]*)\t") do
      if col == 0 then id = field elseif col == 1 then pic = field elseif col == n + 1 then cell = field break end
      col = col + 1
    end
    if pic and cell and cell ~= "" then
      local bare, first = Bare(pic), nil
      for word in cell:gmatch("[^;]+") do
        first = first or word
        Words[#Words + 1] = { word, Lower(word), pic }
        local key = Lower(word):gsub("%s*%(.-%)", "")
        if not Index[key] or #Index[key] > #pic then Index[key] = pic end
        local bare_verb = key:match("^to (.+)$")
        if bare_verb and not Index[bare_verb] then Index[bare_verb] = pic end
      end
      if not Read[bare] then Read[bare] = first end
      ById[id] = { pic, first }
    end
  end
end

-- pictures back into words: a group whole if it is a word, else the longest known runs
function ReadOut(text)
  text = text:gsub(WJ, "")
  local out = {}
  for group in text:gmatch("%S+") do
    if Read[group] then out[#out + 1] = Read[group]
    else
      local i, parts = 1, {}
      while i <= #group do
        local found
        for j = #group, i, -1 do
          local bit = group:sub(i, j)
          if Read[bit] then found = j; parts[#parts + 1] = Read[bit]; break end
        end
        if found then i = found + 1 else
          local c = group:byte(i)
          i = i + (c >= 0xF0 and 4 or c >= 0xE0 and 3 or c >= 0xC0 and 2 or 1)
        end
      end
      out[#out + 1] = #parts > 0 and "(" .. table.concat(parts, " + ") .. ")" or "?"
    end
  end
  return table.concat(out, " ")
end

function HasLetters(t)
  local rest = t:gsub(WJ, ""):gsub("[\240-\247][\128-\191][\128-\191][\128-\191]", ""):gsub("\239\184\143", "")
    :gsub("\226[\128-\191][\128-\191]", ""):gsub("[%s%p%d]", "")
  return rest ~= ""
end

-- what you typed, in your language, into pictures: the longest phrase it knows first (up to three words);
-- pictures typed or picked pass straight through; words it doesn't know are left out and listed
function ToPictures(text)
  local toks = {}
  for t in text:gmatch("%S+") do
    if HasLetters(t) then
      t = Lower(t):gsub("^[%p]+", ""):gsub("[%p]+$", "")
      if t ~= "" then toks[#toks + 1] = { t, false } end
    else toks[#toks + 1] = { t, true } end
  end
  local pics, skipped, i = {}, {}, 1
  while i <= #toks do
    if toks[i][2] then pics[#pics + 1] = toks[i][1]; i = i + 1
    else
      local done = false
      for n = 3, 1, -1 do
        if i + n - 1 <= #toks then
          local words, ok = {}, true
          for k = i, i + n - 1 do if toks[k][2] then ok = false break end words[#words + 1] = toks[k][1] end
          if ok then
            local key = table.concat(words, " ")
            local pic = Index[key]
            if not pic and n == 1 and #key > 4 then pic = Index[key:sub(1, -2)] or Index[key:sub(1, -3)] end
            if pic then pics[#pics + 1] = pic; i = i + n; done = true break end
          end
        end
      end
      if not done then skipped[#skipped + 1] = toks[i][1]; i = i + 1 end
    end
  end
  return pics, skipped
end

function ShowLog()
  local lines = {}
  for _, m in ipairs(Said) do
    lines[#lines + 1] = (m[1] == "me" and "🙂 " or "👤 ") .. m[2] .. "\n      " .. ReadOut(m[2])
  end
  Vml("SetProperty", "lblLog", "Text", table.concat(lines, "\n"))
end

function Tab(which)
  for _, t in ipairs({ "Chat", "Dict", "Learn" }) do
    Vml("SetProperty", "p" .. t, "IsVisible", t == which and "true" or "false")
  end
end

-- ---- lessons
function ShowLesson(n)
  local k, line = 0, nil
  for l in LESSONS:gmatch("[^\n]+") do k = k + 1; if k == n then line = l end end
  if not line then return end
  Lesson = {}
  for id in line:match("|(.*)$"):gmatch("%S+") do if ById[id] then Lesson[#Lesson + 1] = id end end
  local rows = {}
  for _, id in ipairs(Lesson) do rows[#rows + 1] = Bare(ById[id][1]) .. "   " .. ById[id][2] end
  Vml("SetProperty", "lblLesson", "Text", table.concat(rows, "\n"))
  Right, Asked = 0, 0
  NextQ()
end

function NextQ()
  if not Lesson or #Lesson < 2 then return end
  local id = Lesson[math.random(#Lesson)]
  local choices, seen = { id }, { [id] = true }
  while #choices < math.min(4, #Lesson) do
    local o = Lesson[math.random(#Lesson)]
    if not seen[o] then seen[o] = true; choices[#choices + 1] = o end
  end
  for i = #choices, 2, -1 do local j = math.random(i); choices[i], choices[j] = choices[j], choices[i] end
  Quiz = { id = id, choices = choices, answered = false }
  Vml("SetProperty", "lblQ", "Text", Bare(ById[id][1]))
  for i = 1, 4 do
    local c = choices[i]
    Vml("SetProperty", "btnA" .. i, "Content", c and ById[c][2] or "")
    Vml("SetProperty", "btnA" .. i, "IsVisible", c and "true" or "false")
  end
  Vml("SetProperty", "lblScore", "Text", Asked > 0 and ("✅ " .. Right .. " / " .. Asked) or "❔")
end

function Answer(i)
  if not Quiz or Quiz.answered then return end
  Quiz.answered = true
  Asked = Asked + 1
  local good = Quiz.choices[i] == Quiz.id
  if good then Right = Right + 1 end
  Vml("SetProperty", "lblScore", "Text", (good and "✅ " or "❌ " .. Bare(ById[Quiz.id][1]) .. " = " .. ById[Quiz.id][2] .. "   ") .. Right .. " / " .. Asked)
  if not good then Vml("Vibrate", "80") end
end

local saved = tonumber(Vml("GetSetting", "language") or "") or 0
Vml("SetProperty", "cboLang", "SelectedIndex", tostring(saved))
UseLanguage(saved + 1)
Vml("SetProperty", "cboLesson", "SelectedIndex", "0")
ShowLesson(1)

-- opened from someone's code by a phone's camera: join their link straight away
local code = Vml("LinkInvite")
if code ~= "" and Vml("Link", "Got", code) ~= "" then Vml("SetProperty", "lblState", "Text", "⏳") end
LUA

@Script PickLang
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "cboLang", "SelectedIndex")) or 0
if i < 0 then return end
Vml("SetSetting", "language", tostring(i))
UseLanguage(i + 1)
ShowLog()
Vml("RunScript", "Convert")
ShowLesson((tonumber(Vml("GetProperty", "cboLesson", "SelectedIndex")) or 0) + 1)
if (Vml("GetProperty", "txtWord", "Text") or "") ~= "" then Vml("RunScript", "Find") end
LUA

@Script TabChat
Interpreter=lua
<<LUA
Tab("Chat")
LUA

@Script TabDict
Interpreter=lua
<<LUA
Tab("Dict")
LUA

@Script TabLearn
Interpreter=lua
<<LUA
Tab("Learn")
LUA

@Script Convert
Interpreter=lua
<<LUA
local text = Vml("GetProperty", "txtSay", "Text") or ""
local pics, skipped = ToPictures(text)
Vml("SetProperty", "lblPreview", "Text", table.concat(pics, "  "))
Vml("SetProperty", "lblSkip", "Text", #skipped > 0 and ("🚫 " .. table.concat(skipped, ", ") .. "   📖") or "")
LUA

@Script DoSend
Interpreter=lua
<<LUA
local pics = ToPictures(Vml("GetProperty", "txtSay", "Text") or "")
if #pics == 0 then return end
local msg = table.concat(pics, " ")
if not Linked then
  Vml("SetProperty", "lblState", "Text", "🔗❔  🔗 📷 🤝")
  return
end
if Vml("LinkSend", msg) == "true" then
  Said[#Said + 1] = { "me", msg }
  ShowLog()
  Vml("SetProperty", "txtSay", "Text", "")
  Vml("RunScript", "Convert")
end
LUA

@Script DoStart
Interpreter=lua
<<LUA
-- start a link: its code goes on show, as a picture any phone's camera can open and as text to copy
local code = Vml("Link", "Got")
if code == "" then return end
Linked = false
Vml("SetProperty", "imgCode", "Source", Vml("QrCode", Vml("LinkAddress", code), "4"))
Vml("SetProperty", "txtCode", "Text", code)
Vml("SetProperty", "imgCode", "IsVisible", "true")
Vml("SetProperty", "txtCode", "IsVisible", "true")
Vml("SetProperty", "lblLog", "IsVisible", "false")
Vml("SetProperty", "lblState", "Text", "⏳ 📷")
LUA

@Script DoJoin
Interpreter=lua
<<LUA
Vml("ScanCode", "Scanned", "📷")
LUA

@Script Scanned
Interpreter=lua
<<LUA
local text, problem = ...
if text == "" then Vml("SetProperty", "lblState", "Text", problem) return end
Linked = false
if Vml("Link", "Got", text) ~= "" then Vml("SetProperty", "lblState", "Text", "⏳") end
LUA

@Script DoPair
Interpreter=lua
<<LUA
-- both press within a few seconds of each other: no code to show or scan
Linked = false
Vml("SetProperty", "imgCode", "IsVisible", "false")
Vml("SetProperty", "txtCode", "IsVisible", "false")
if Vml("LinkPair", "Got") ~= "" then Vml("SetProperty", "lblState", "Text", "🤝 ⏳") end
LUA

@Script Got
Interpreter=lua
<<LUA
-- everything the link says: who came and went, what they said, what went wrong
local what, text = ...
local function state(t) Vml("SetProperty", "lblState", "Text", t) end
if what == "words" then
  state("🤝 " .. text)
  local same = Vml("ConfirmDialog", "🤝\n\n" .. text .. "\n\n= ❔", "tiny-talk")
  if same == true or same == "true" then Vml("LinkAccept"); state("⏳") else Vml("LinkClose"); state("🤝 ❌") end
elseif what == "joined" then
  Linked = true
  Vml("SetProperty", "imgCode", "IsVisible", "false")
  Vml("SetProperty", "txtCode", "IsVisible", "false")
  Vml("SetProperty", "lblLog", "IsVisible", "true")
  state("🔗 ✅ 🔒")
elseif what == "message" then
  Said[#Said + 1] = { "them", text }
  ShowLog()
  Vml("Vibrate", "60")
elseif what == "left" then
  Linked = false
  state("🔗 ❌")
elseif what == "error" then
  state(text)
end
LUA

@Script Find
Interpreter=lua
<<LUA
local q = Vml("GetProperty", "txtWord", "Text") or ""
q = q:gsub("^%s+", ""):gsub("%s+$", "")
if q == "" then
  Shown = {}
  Vml("SetProperty", "lstFound", "Items", "")
  Vml("SetProperty", "lblMeaning", "Text", "📖 " .. #Words)
  return
end
local lq = Lower(q)
if not HasLetters(q) then
  Vml("SetProperty", "lblMeaning", "Text", "👁️ " .. ReadOut(q))
  return
end
local exact, starts, inside = {}, {}, {}
for _, w in ipairs(Words) do
  local name = w[2]
  if name == lq or name == "to " .. lq then exact[#exact + 1] = w
  elseif name:sub(1, #lq) == lq or name:sub(1, #lq + 3) == "to " .. lq then starts[#starts + 1] = w
  elseif #lq > 3 and name:find(lq, 1, true) then inside[#inside + 1] = w end
end
Shown = {}
local items = {}
for _, list in ipairs({ exact, starts, inside }) do
  for _, w in ipairs(list) do
    if #Shown >= 40 then break end
    Shown[#Shown + 1] = w
    items[#items + 1] = (w[3] .. "   " .. w[1]):gsub(",", " ")
  end
end
Vml("SetProperty", "lstFound", "Items", table.concat(items, ","))
Vml("SetProperty", "lblMeaning", "Text", #Shown == 0 and "🤷" or "👇 ➕ 💬")
LUA

@Script Pick
Interpreter=lua
<<LUA
-- a word picked from the dictionary goes into the message being written
local i = tonumber(Vml("GetProperty", "lstFound", "SelectedIndex")) or -1
local w = Shown and Shown[i + 1]
if not w then return end
local now = Vml("GetProperty", "txtSay", "Text") or ""
Vml("SetProperty", "txtSay", "Text", (now ~= "" and now .. " " or "") .. Bare(w[3]))
Vml("RunScript", "Convert")
Vml("SetProperty", "lblMeaning", "Text", "➕ 💬  " .. w[1])
LUA

@Script PickLesson
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "cboLesson", "SelectedIndex")) or 0
if i >= 0 then ShowLesson(i + 1) end
LUA

@Script NextQuestion
Interpreter=lua
<<LUA
NextQ()
LUA

