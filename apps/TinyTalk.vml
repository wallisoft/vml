# ============================================================================
# tiny-talk: say it in pictures anyone can read.
#
#   Type a word in your own language and tap the pictures it is written with:
#   they are added to your message. Copy the message and send it anywhere.
#   Paste pictures someone sent you into the same box and it reads them back.
#
#   The pictures write the words of Blissymbolics, a language made of meanings
#   rather than sounds, built from a few hundred basic characters. Each basic
#   character has one emoji, so every word follows from Bliss's own recipe:
#   teacher = person + giving + knowledge = 🧑🎁🎓.
#
#   Bliss words and recipes: BCI Authorized Vocabulary 2026-09-12, CC BY-SA 4.0,
#   Blissymbolics Communication International (blissymbolics.org). The
#   dictionary in this app shares that licence. The app's own code: MIT.
#
#   Made with Visualised.
# ============================================================================

@Window TinyTalk
Title=tiny-talk
Version=0.1
Width=360
Height=640
OnOpened=Opened
AndroidPackage=io.visualised.made.tinytalk.k7b1ce6cd
AndroidKey=7b1ce6cd

@Canvas c
Parent=TinyTalk
Background=#FFFFFF

@TextBlock lblTitle
Parent=c
Canvas.Left=12
Canvas.Top=8
Width=200
Height=30
FontSize=22
FontWeight=Bold
Text=tiny-talk

@TextBlock lblHello
Parent=c
Canvas.Left=212
Canvas.Top=12
Width=136
Height=26
FontSize=18
TextAlignment=Right
Text=👄➡️⬅️

# the message being written, a word to each group of pictures
@TextBlock lblMsg
Parent=c
Canvas.Left=12
Canvas.Top=44
Width=336
Height=118
FontSize=30
TextWrapping=Wrap
Background=#F3F4F6
Text=

@Button btnBack
Parent=c
Canvas.Left=12
Canvas.Top=170
Width=78
Height=40
Content=⌫ Back
OnClick=DoBack

@Button btnCopy
Parent=c
Canvas.Left=98
Canvas.Top=170
Width=78
Height=40
Content=Copy
OnClick=DoCopy

@Button btnShare
Parent=c
Canvas.Left=184
Canvas.Top=170
Width=78
Height=40
Content=Share
OnClick=DoShare

@Button btnClear
Parent=c
Canvas.Left=270
Canvas.Top=170
Width=78
Height=40
Content=Clear
OnClick=DoClear

# one box for both ways: words to look up, or pictures to read
@TextBox txtWord
Parent=c
Canvas.Left=12
Canvas.Top=220
Width=336
Height=42
FontSize=18
Watermark=Type a word, or paste pictures to read
TextChanged=Find

@TextBlock lblMeaning
Parent=c
Canvas.Left=12
Canvas.Top=268
Width=336
Height=52
TextWrapping=Wrap
Foreground=#4B5563
Text=Tap a word below to add its pictures to your message.

@ListBox lstFound
Parent=c
Canvas.Left=12
Canvas.Top=324
Width=336
Height=284
FontSize=20
SelectionChanged=Pick

@TextBlock lblCredit
Parent=c
Canvas.Left=12
Canvas.Top=612
Width=336
Height=22
FontSize=10
Foreground=#9CA3AF
Text=Words: Blissymbolics (BCI, CC BY-SA 4.0). Pictures: tiny-talk core 0.2.

