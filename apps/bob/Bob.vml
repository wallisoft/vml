@Script Minutes
Interpreter=lua
<<LUA
-- 45 -> "45m", 65 -> "1h 05m"
local m = math.floor(tonumber((...)) or 0)
return m < 60 and (m .. "m") or string.format("%dh %02dm", math.floor(m / 60), m % 60)
LUA

@Script Away
Interpreter=lua
<<LUA
-- Away from desk: lock the Windows machines and this computer, and time it till the screen is unlocked again
Vml("SetSetting", "bob_away_start", tostring(os.time()))
Vml("SetSetting", "bob_away_seen", "")
Vml("SetProperty", "StatusBar", "Text", "Away from desk since " .. os.date("%H:%M"))
for name, m in pairs(require("dkjson").decode(Vml("Shell", Vml("RunScript", "Bob", "--machines") .. " 2>/dev/null") or "") or {}) do
    if (m.os or ""):lower() == "windows" and (m.host or "") ~= "" then   -- each Windows machine: back to its lock screen
        Vml("Shell", "ssh -o BatchMode=yes -o ConnectTimeout=4 '" .. m.host .. "' 'tsdiscon console' >/dev/null 2>&1 &")
    end
end
Vml("SetProperty", "tmrDesk", "IsEnabled", "true")
Vml("Shell", "(loginctl lock-session 2>/dev/null || xdg-screensaver lock 2>/dev/null) &")
LUA

@Script DeskCheck
Interpreter=lua
<<LUA
-- Locked still? Once it has been locked and isn't any more, you're back: log it
local out = Vml("Shell", [[gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2>/dev/null || loginctl show-session "$XDG_SESSION_ID" -p LockedHint --value 2>/dev/null]]) or ""
local locked = out:find("true") ~= nil or out:find("yes") ~= nil
local start = tonumber(Vml("GetSetting", "bob_away_start")) or os.time()
if locked then
    Vml("SetSetting", "bob_away_seen", "1")
    return
end
if Vml("GetSetting", "bob_away_seen") ~= "1" then
    if os.time() - start > 30 then                   -- it never locked: say so, log nothing
        Vml("SetProperty", "tmrDesk", "IsEnabled", "false")
        Vml("SetProperty", "StatusBar", "Text", "Couldn't lock this screen (loginctl lock-session didn't)")
    end
    return
end
Vml("SetProperty", "tmrDesk", "IsEnabled", "false")
local mins = math.floor((os.time() - start) / 60 + 0.5)
Vml("Shell", string.format([[f="$HOME/.local/share/bob/away.csv"; mkdir -p "$(dirname "$f")"; [ -s "$f" ] || echo "date,away,back,minutes" > "$f"; echo "%s,%s,%s,%d" >> "$f"]],
    os.date("%Y-%m-%d", start), os.date("%H:%M", start), os.date("%H:%M"), mins))
Vml("SetProperty", "StatusBar", "Text", "Welcome back: away " .. Vml("RunScript", "Minutes", mins) .. ", " .. os.date("%H:%M", start) .. " to " .. os.date("%H:%M"))
LUA

@Script GhPoll
Interpreter=lua
<<LUA
-- Ask GitHub (gh, in the repo) for the latest Actions runs; GhListed sets them out when it answers
local since = tonumber(Vml("GetSetting", "bob_gh_busy")) or 0
if since > 0 and os.time() - since < 90 then return end        -- (still asking; after 90s it's stuck: ask again)
Vml("SetSetting", "bob_gh_busy", tostring(os.time()))
Vml("SetProperty", "txtGhRaw", "Text", "")
local repo = Vml("RunScript", "Repo")
local pid = Vml("RunProcess", 'cd "' .. repo .. '" && gh run list --limit 8 --json databaseId,status,conclusion,workflowName,headBranch,createdAt,displayTitle --template \'{{range .}}{{.databaseId}}|{{.status}}|{{.conclusion}}|{{.workflowName}}|{{.headBranch}}|{{timeago .createdAt}}|{{.displayTitle}}{{"\\n"}}{{end}}\' 2>&1',
    "txtGhRaw", "GhListed")
if not pid or pid == "" then
    Vml("SetSetting", "bob_gh_busy", "")
    Vml("SetProperty", "txtGitHub", "Text", "Couldn't ask GitHub (the gh command didn't start) at " .. os.date("%H:%M:%S"))
end
LUA

@Script GhListed
Interpreter=lua
<<LUA
-- The runs, set out; anything new or just finished brings Bob to the front and says so
Vml("SetSetting", "bob_gh_busy", "")
local raw = Vml("GetProperty", "txtGhRaw", "Text") or ""
if Vml("GetSetting", "exit_code") ~= "0" then
    local why = raw:gsub("%s+$", "")
    Vml("SetProperty", "txtGitHub", "Text", "GitHub isn't answering Bob:\n\n" .. why ..
        "\n\nBob asks with the gh command: install it (sudo apt install gh) and sign in (gh auth login).")
    return
end
local runs, prev, state = {}, {}, {}
for pair in (Vml("GetSetting", "bob_gh_state") or ""):gmatch("[^;]+") do
    local id, st = pair:match("^(%d+)=(.*)$")
    if id then prev[id] = st end
end
local first = next(prev) == nil
local mark = { success = "✓", failure = "✗", cancelled = "–", skipped = "–", timed_out = "✗" }
local lines, active, news = {}, nil, {}
for line in raw:gmatch("[^\n]+") do
    local id, st, co, wf, br, ago, title = line:match("^(%d+)|([^|]*)|([^|]*)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
    if id then
        local now = st == "completed" and ("done:" .. co) or st
        state[#state + 1] = id .. "=" .. now
        local sign = st == "completed" and (mark[co] or "?") or (st == "in_progress" and "●" or "○")
        local what = st == "completed" and (co == "success" and "green" or co) or (st == "in_progress" and "running" or st)
        if #title > 44 then title = title:sub(1, 42) .. "…" end
        lines[#lines + 1] = string.format("%s  %-22s %-16s %-10s %-15s %s", sign, wf, br, what, ago, title)
        if st ~= "completed" and not active then active = id end
        if not first then
            local was = prev[id]
            if was == nil then
                news[#news + 1] = wf .. " " .. br .. " started"
            elseif was:sub(1, 5) ~= "done:" and st == "completed" then
                news[#news + 1] = wf .. " " .. br .. (co == "success" and " is green" or (" " .. co))
            end
        end
    end
end
Vml("SetSetting", "bob_gh_state", table.concat(state, ";"))
local head = "GitHub Actions, checked " .. os.date("%H:%M:%S") .. "   (✓ green  ✗ failed  ● running  ○ waiting)\n\n"
Vml("SetSetting", "bob_gh_list", head .. table.concat(lines, "\n"))
if active then
    Vml("SetProperty", "txtGhRun", "Text", "")
    Vml("RunProcess", 'cd "' .. Vml("RunScript", "Repo") .. '" && gh run view ' .. active .. ' 2>&1', "txtGhRun", "GhViewed")
else
    Vml("SetProperty", "txtGitHub", "Text", head .. table.concat(lines, "\n"))
end
if #news > 0 then                                    -- Bob pops up: to the front, on the GitHub tab, with a notification
    local said = table.concat(news, ", ")
    Vml("SetProperty", "logs", "SelectedIndex", "0")
    Vml("SetProperty", "StatusBar", "Text", "GitHub: " .. said .. " (" .. os.date("%H:%M") .. ")")
    Vml("ShowForm", "Bob")
    Vml("Shell", 'notify-send -a Bob "Bob" "GitHub: ' .. said:gsub('"', "'") .. '" >/dev/null 2>&1 &')
end
-- quicker while something's running, slower when it's all quiet
Vml("SetProperty", "tmrGh", "Interval", active and "10000" or "30000")
LUA

@Script GhViewed
Interpreter=lua
<<LUA
-- The run going now: its jobs and where each has got to, under the list
local run = (Vml("GetProperty", "txtGhRun", "Text") or ""):gsub("%s+$", "")
Vml("SetProperty", "txtGitHub", "Text", Vml("GetSetting", "bob_gh_list") .. "\n\n──── running now ────\n" .. run)
LUA
