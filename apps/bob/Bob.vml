local home = Vml("RunScript", "Repo") .. "/apps/bob/help/Home.md"
if Vml("Shell", '[ -f "' .. home .. '" ] && echo yes') ~= "" then
    Vml("ShowMarkdown", home, "Bob's help")
else
    Vml("ShowMarkdown", "https://bob.vml.onl/help/Home.txt", "Bob's help")     -- (the same pages, online)
end
LUA

