# once a second while a build runs: its stage and how long it has taken
@Timer tmr
Parent=c
Interval=1000
IsEnabled=false
OnTick=Tick

# --- scripts ------------------------------------------------------------------------

@Script Repo
Interpreter=lua
<<LUA
-- Where the repo is: BOB_REPO, else the preference, else ~/projects/vml-github
local pref = Vml("GetPreference", "bob_repo", "")
local r = Vml("Shell", 'printf %s "${BOB_REPO:-' .. (pref ~= "" and pref or "$HOME/projects/vml-github") .. '}"')
return ((r or ""):gsub("%s+$", ""))
LUA

@Script Bob
Interpreter=lua
<<LUA
-- The runner, with what to do: run.py in the repo (Python 3 unbuffered, so each line shows as it comes)
return 'cd "' .. Vml("RunScript", "Repo") .. '" && python3 -u tools/bob/run.py ' .. ((...) or "")
LUA

@Script Opened
Interpreter=lua
<<LUA
-- Up at once with the splash; the reading and asking happen a moment later, with the window already showing
Vml("SetProperty", "tmrStart", "IsEnabled", "true")
LUA

@Script SplashDone
Interpreter=lua
<<LUA
Vml("SetProperty", "tmrSplash", "IsEnabled", "false")
if Vml("ControlExists", "splash") == "true" then Vml("SetProperty", "splash", "IsVisible", "false") end
LUA

@Script StartUp
Interpreter=lua
<<LUA
Vml("SetProperty", "tmrStart", "IsEnabled", "false")
Vml("SetSetting", "bob_gh_state", "")
Vml("SetSetting", "bob_gh_busy", "")
Vml("SetSetting", "bob_stopping", "")
local repo = Vml("RunScript", "Repo")
local list = Vml("Shell", Vml("RunScript", "Bob", "--projects") .. " 2>/dev/null") or ""
local projects = require("dkjson").decode(list) or {}
if #projects == 0 then
    Vml("SetProperty", "lblWhat", "Text", "no projects at " .. (repo:gsub("^" .. (os.getenv("HOME") or "~"), "~")))
    Vml("SetProperty", "StatusBar", "Text", "No recipes found in " .. repo .. " (or no tools/bob/run.py): Set up… to say where the repo is")
else
    local want, pick = (Vml("GetPreference", "bob_project", ""):gsub("bob%.json$", "recipe.vml")), 1
    for i, p in ipairs(projects) do
        if p.config == want or (want == "" and p.name == "Visualised") then pick = i end
    end
    Vml("SetSetting", "bob_projects", list)
    Vml("RunScript", "ShowProject", tostring(pick))
end
Vml("RunScript", "GhPoll")
-- the machines are asked in the background (ShowProject's Ping): say so, then out of the way
local hosts = {}
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    local m = Vml("GetSetting", "bob_machine_" .. i)
    if Vml("GetSetting", "bob_host_" .. i) ~= "" and m ~= "" then hosts[#hosts + 1] = m end
end
Vml("SetProperty", "splashSays", "Text", #hosts > 0 and ("Testing connections: " .. table.concat(hosts, ", ") .. "…") or "Ready")
Vml("SetProperty", "tmrSplash", "IsEnabled", "true")
LUA

@Script ShowProjects
Interpreter=lua
<<LUA
-- The project button's menu: the projects (this one ticked), then New project, the recipe, machines, set up
local json = require("dkjson")
for k = 1, tonumber(Vml("GetSetting", "bob_menu_n")) or 0 do
    if Vml("ControlExists", "pm" .. k) == "true" then Vml("DeleteControl", "pm" .. k) end
end
local k = 0
local function item(text, onclick, parent, enabled)
    k = k + 1
    Vml("CreateControl", "MenuItem", "pm" .. k, parent or "ProjMenu")
    if text == "-" then
        Vml("SetProperty", "pm" .. k, "IsSeparator", "true")
    else
        Vml("SetProperty", "pm" .. k, "Text", text)
        if onclick then Vml("SetEvent", "pm" .. k, "OnClick", onclick) end
        if enabled == false then Vml("SetProperty", "pm" .. k, "IsEnabled", "false") end
    end
    return "pm" .. k
end
local current = Vml("GetSetting", "bob_config")
for i, p in ipairs(json.decode(Vml("GetSetting", "bob_projects")) or {}) do
    item((p.config == current and "✓  " or "     ") .. p.name .. "  " .. (p.version or ""), "PickProject(" .. i .. ")")
end
item("-")
local new = item("New project")
local cands = json.decode(Vml("Shell", Vml("RunScript", "Bob", "--candidates") .. " 2>/dev/null") or "") or {}
Vml("SetSetting", "bob_cands", json.encode(cands))
for i, c in ipairs(cands) do item(c.name .. "   (" .. c.where .. ")", "NewProject(" .. i .. ")", new) end
if #cands == 0 then item("Every project and app has a recipe", nil, new, false) end
item("Edit this recipe…", "EditRecipe")
item("-")
item("Machines…", "Machines")
item("Set up…", "SetUp")
item("-")
item("Help", "Help")
Vml("SetSetting", "bob_menu_n", tostring(k))
Vml("ShowContextMenu", "ProjMenu")
LUA

@Script PickProject
Interpreter=lua
<<LUA
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    if Vml("GetSetting", "bob_run_" .. i) == "1" then
        Vml("SetProperty", "StatusBar", "Text", "Finish (or stop) the builds going before switching project")
        return
    end
end
Vml("RunScript", "ShowProject", tostring((...)))
LUA

@Script NewProject
Interpreter=lua
<<LUA
-- A recipe for a project or app that hasn't one: made with sensible builds, then shown (and opened to edit)
local json = require("dkjson")
local c = (json.decode(Vml("GetSetting", "bob_cands")) or {})[tonumber((...)) or 0]
if not c then return end
local made = (Vml("Shell", Vml("RunScript", "Bob", '--new "' .. c.path .. '"') .. " 2>&1") or ""):gsub("%s+$", "")
if not made:find("%.vml$") then
    Vml("SetProperty", "StatusBar", "Text", "Couldn't make a recipe: " .. made)
    return
end
Vml("SetPreference", "bob_project", made)
Vml("RunScript", "Opened")
Vml("SetProperty", "StatusBar", "Text", "Made " .. (made:gsub("^" .. (Vml("RunScript", "Repo"):gsub("%p", "%%%0")) .. "/", "")) ..
    ": Linux here, Windows on your Windows machine, and a quick export. Project ▾ > Edit this recipe… to change it")
LUA

@Script EditRecipe
Interpreter=lua
<<LUA
local f = Vml("GetSetting", "bob_config")
if f == "" then return end
Vml("RunScript", "EditText", f)
Vml("SetProperty", "StatusBar", "Text", "Editing " .. (f:gsub("^" .. (os.getenv("HOME") or "~"), "~")) .. ": save it, then pick the project again (Project ▾)")
LUA

@Script ShowProject
Interpreter=lua
<<LUA
-- A project's builds: a card each (in a row), and a log tab each after GitHub's
local json = require("dkjson")
local which = tonumber((...)) or 1
local project = (json.decode(Vml("GetSetting", "bob_projects")) or {})[which]
if not project then return end
Vml("SetPreference", "bob_project", project.config)
Vml("SetSetting", "bob_config", project.config)
local info = json.decode(Vml("Shell", Vml("RunScript", "Bob", '--config "' .. project.config .. '" --list') .. " 2>&1") or "") or {}
-- what was there for the last project goes
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    if Vml("ControlExists", "card" .. i) == "true" then Vml("DeleteControl", "card" .. i) end
    if Vml("ControlExists", "pg" .. i) == "true" then Vml("DeleteControl", "pg" .. i) end
    Vml("SetSetting", "bob_run_" .. i, "")
end
local builds = info.builds or {}
Vml("SetSetting", "bob_n", tostring(#builds))
Vml("SetSetting", "bob_name", info.name or project.name)
Vml("SetProperty", "btnProject", "Content", (info.name or project.name) .. "  ▾")
Vml("SetProperty", "lblWhat", "Text", (info.name or project.name) .. " " .. (info.version or "") .. "  ·  " ..
    (#builds == 0 and "no builds in its recipe" or (#builds .. " build" .. (#builds == 1 and "" or "s"))) .. "  ·  " ..
    (Vml("RunScript", "Repo"):gsub("^" .. (os.getenv("HOME") or "~"), "~")))
local gap, total = 16, 740
local w = math.floor((total - gap * (#builds - 1)) / math.max(1, #builds))
local install = false
local narrow = w < 220                               -- (four cards in a row: a little smaller inside)
local bw, nx = narrow and 84 or 110, narrow and 48 or 56
local function make(kind, name, parent, props)
    Vml("CreateControl", kind, name, parent)
    for _, kv in ipairs(props) do Vml("SetProperty", name, kv[1], kv[2]) end
end
for i, b in ipairs(builds) do
    local card = "card" .. i
    make("Canvas", card, "cards", { {"Canvas.Left", tostring((i - 1) * (w + gap))}, {"Canvas.Top", "0"}, {"Width", tostring(w)},
        {"Height", "150"}, {"Background", "#FFFFFF"}, {"BorderBrush", "#E5E7EB"}, {"BorderThickness", "1"}, {"CornerRadius", "10"} })
    make("TextBlock", "light" .. i, card, { {"Canvas.Left", "14"}, {"Canvas.Top", "2"}, {"Width", "40"}, {"Height", "50"},
        {"FontSize", "34"}, {"Foreground", "#9CA3AF"}, {"Text", "●"} })
    make("TextBlock", "name" .. i, card, { {"Canvas.Left", tostring(nx)}, {"Canvas.Top", "12"}, {"Width", tostring(w - nx - 8)}, {"Height", "24"},
        {"FontSize", narrow and "14" or "16"}, {"FontWeight", "Bold"}, {"Text", b.name} })
    local where = b.kind == "github" and "on GitHub Actions" or b.host == "" and "on this computer" or
        ("on " .. b.machine .. (b.os ~= "" and (", " .. b.os) or "") .. ": asking…")
    make("TextBlock", "host" .. i, card, { {"Canvas.Left", tostring(nx)}, {"Canvas.Top", "36"}, {"Width", tostring(w - nx - 8)}, {"Height", "20"},
        {"Foreground", "#6B7280"}, {"Text", where} })
    make("TextBlock", "stage" .. i, card, { {"Canvas.Left", "16"}, {"Canvas.Top", "66"}, {"Width", tostring(w - 30)}, {"Height", "22"},
        {"FontWeight", "Bold"}, {"Text", "Not built yet"} })
    make("TextBlock", "detail" .. i, card, { {"Canvas.Left", "16"}, {"Canvas.Top", "88"}, {"Width", tostring(w - 30)}, {"Height", "20"},
        {"FontSize", "11"}, {"Foreground", "#6B7280"}, {"Text", b.kind == "export" and "quick export" or
            b.kind == "github" and "not part of Build all" or ""} })
    make("TextBlock", "time" .. i, card, { {"Canvas.Left", "16"}, {"Canvas.Top", "116"}, {"Width", "100"}, {"Height", "22"},
        {"Foreground", "#374151"}, {"Text", ""} })
    make("Button", "btn" .. i, card, { {"Canvas.Left", tostring(w - bw - 14)}, {"Canvas.Top", "106"}, {"Width", tostring(bw)}, {"Height", "34"},
        {"Content", b.kind == "github" and "Release" or "Build"} })
    Vml("SetEvent", "btn" .. i, "OnClick", "BuildOne(" .. i .. ")")
    make("TabPage", "pg" .. i, "logs", { {"Header", b.name .. " log"} })
    make("ListBox", "log" .. i, "pg" .. i, { {"Canvas.Left", "8"}, {"Canvas.Top", "8"}, {"Width", "642"}, {"Height", "224"},
        {"FontFamily", "monospace"}, {"FontSize", "11"}, {"Anchor", "Top,Bottom,Left,Right"} })
    for k, act in ipairs({ {"Copy", "CopyLog"}, {"Save…", "SaveLog"}, {"Open", "OpenLog"} }) do     -- the log, to paste or keep
        make("Button", "lb" .. act[2] .. i, "pg" .. i, { {"Canvas.Left", "658"}, {"Canvas.Top", tostring(8 + (k - 1) * 38)},
            {"Width", "72"}, {"Height", "30"}, {"Content", act[1]}, {"Anchor", "Top,Right"} })
        Vml("SetEvent", "lb" .. act[2] .. i, "OnClick", act[2] .. "(" .. i .. ")")
    end
    Vml("SetSetting", "bob_bname_" .. i, b.name)
    Vml("SetSetting", "bob_kind_" .. i, b.kind)
    Vml("SetSetting", "bob_out_" .. i, b.out)
    Vml("SetSetting", "bob_host_" .. i, b.host)
    Vml("SetSetting", "bob_machine_" .. i, b.machine)
    if b.uses_install then install = true end
    -- the last build, if there's one
    local slug = (info.name or "p"):gsub("[^%w]", "")
    local log = "$HOME/.cache/bob/logs/" .. slug .. "-" .. i .. ".log"
    Vml("SetSetting", "bob_log_" .. i, log)
    local when = (Vml("Shell", 'ls -t "' .. b.out .. '" 2>/dev/null | head -1 | xargs -r -I{} date -r "' .. b.out .. '/{}" "+%-d %b, %H:%M"') or ""):gsub("%s+$", "")
    if when ~= "" then Vml("SetProperty", "stage" .. i, "Text", "Last built " .. when) end
end
Vml("SetProperty", "chkInstall", "IsVisible", install and "true" or "false")
Vml("RunScript", "Busy")
Vml("RunScript", "Ping")
Vml("SetProperty", "StatusBar", "Text", (info.name or project.name) .. ": " .. #builds .. " build" .. (#builds == 1 and "" or "s"))
LUA

@Script Ping
Interpreter=lua
<<LUA
-- Are the other machines awake? (asked in the background: an asleep PC takes a few seconds to not answer)
local lines = {}
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    local h = Vml("GetSetting", "bob_host_" .. i)
    if h ~= "" then
        lines[#lines + 1] = "(ssh -o BatchMode=yes -o ConnectTimeout=6 '" .. h .. "' hostname >/dev/null 2>&1 && echo " .. i .. ":up || echo " .. i .. ":down) &"
    end
end
if #lines == 0 then return end
Vml("SetProperty", "txtPing", "Text", "")
Vml("RunProcess", table.concat(lines, " ") .. " wait", "txtPing", "Pinged")
LUA

@Script Pinged
Interpreter=lua
<<LUA
Vml("RunScript", "SplashDone")                          -- (the machines have answered: no need to wait longer)
for i, state in (Vml("GetProperty", "txtPing", "Text") or ""):gmatch("(%d+):(%a+)") do
    if Vml("ControlExists", "host" .. i) == "true" then
        local m = Vml("GetSetting", "bob_machine_" .. i)
        local up = state == "up"
        Vml("SetProperty", "host" .. i, "Text", up and ("on " .. m .. ", over SSH") or ("on " .. m .. ": asleep?"))
        Vml("SetProperty", "host" .. i, "Foreground", up and "#6B7280" or "#DC2626")
    end
end
LUA

@Script Busy
Interpreter=lua
<<LUA
-- The buttons, the timer and the status bar, from which builds are running
local n, running, names = tonumber(Vml("GetSetting", "bob_n")) or 0, 0, {}
for i = 1, n do
    local on = Vml("GetSetting", "bob_run_" .. i) == "1"
    if Vml("ControlExists", "btn" .. i) == "true" then Vml("SetProperty", "btn" .. i, "IsEnabled", on and "false" or "true") end
    if on then running = running + 1; names[#names + 1] = Vml("GetSetting", "bob_bname_" .. i) end
end
Vml("SetProperty", "btnAll", "IsEnabled", (running == 0 and n > 0) and "true" or "false")
Vml("SetProperty", "btnStop", "IsEnabled", running > 0 and "true" or "false")
Vml("SetProperty", "btnProject", "IsEnabled", running == 0 and "true" or "false")
Vml("SetProperty", "tmr", "IsEnabled", running > 0 and "true" or "false")
if running > 0 then Vml("SetProperty", "StatusBar", "Text", "Building " .. table.concat(names, " and ") .. "…") end
LUA

@Script Start
Interpreter=lua
<<LUA
-- Start one build (its card's number)
local i = tostring((...))
if Vml("GetSetting", "bob_run_" .. i) == "1" then return end
local log = Vml("GetSetting", "bob_log_" .. i)
local install = Vml("GetProperty", "chkInstall", "IsChecked") == "true"
Vml("SetProperty", "light" .. i, "Foreground", "#F59E0B")
Vml("SetProperty", "stage" .. i, "Text", "Starting…")
Vml("SetProperty", "detail" .. i, "Text", "")
Vml("SetProperty", "time" .. i, "Text", "0s")
Vml("SetProperty", "log" .. i, "Items", "")
Vml("SetSetting", "bob_start_" .. i, tostring(os.time()))
Vml("SetSetting", "bob_stopping", "")
Vml("SetSetting", "bob_said_" .. i, "")
Vml("SetSetting", "bob_run_" .. i, "1")
local args = '--config "' .. Vml("GetSetting", "bob_config") .. '" --build "' .. Vml("GetSetting", "bob_bname_" .. i) .. '"' .. (install and "" or " --no-install")
local cmd = 'mkdir -p "$HOME/.cache/bob/logs" && set -o pipefail && ' .. Vml("RunScript", "Bob", args) .. ' 2>&1 | tee "' .. log .. '"'
local pid = Vml("RunProcess", cmd, "log" .. i, "Done" .. i)
Vml("SetSetting", "bob_pid_" .. i, pid or "")
Vml("RunScript", "Busy")
LUA

@Script BuildOne
Interpreter=lua
<<LUA
local i = tonumber((...)) or 1
if Vml("GetSetting", "bob_kind_" .. i) == "github" then          -- a release: say what it'll do, and ask
    local info = require("dkjson").decode(Vml("Shell", Vml("RunScript", "Bob", '--config "' .. Vml("GetSetting", "bob_config") .. '" --list') .. " 2>/dev/null") or "") or {}
    local b = (info.builds or {})[i] or {}
    local tag = b.tag or ""
    local out = tag ~= "" and Vml("Shell", 'cd "' .. Vml("RunScript", "Repo") .. '" && git ls-remote --tags origin "refs/tags/' .. tag .. '" 2>/dev/null') or ""
    local yes
    if out ~= nil and out:find(tag, 1, true) then                -- that version's out already: a look at its run, not a release
        yes = Vml("ConfirmDialog", tag .. " is on GitHub already, so this would be no new release: Bob just shows how its run went.\n\n" ..
            "For a new release, raise the version first. Look at " .. tag .. "'s run?", "Released already")
    elseif b.fix then                                           -- a fix: from the builds here, no clean build
        yes = Vml("ConfirmDialog", "Release " .. Vml("GetSetting", "bob_name") .. " " .. (info.version or "") .. " as a fix?\n\n" ..
            "Bob tags it " .. tag .. " and publishes this computer's builds of it as a pre-release: no clean build on GitHub. " ..
            "Apps offer it in About; the website keeps the last clean release.\n\nBuild it here first (Build all).", "Release a fix")
    else
        yes = Vml("ConfirmDialog", "Release " .. Vml("GetSetting", "bob_name") .. " " .. (info.version or "") .. " on GitHub, as " .. tag .. "?\n\n" ..
            "Bob pushes what's committed (if GitHub hasn't got it), tags it, and follows the run it starts.", "Release")
    end
    if yes ~= true and yes ~= "true" and yes ~= "True" then return end
end
Vml("SetProperty", "logs", "SelectedIndex", tostring(i))      -- (GitHub is tab 0)
Vml("RunScript", "Start", tostring(i))
LUA

@Script BuildAll
Interpreter=lua
<<LUA
local n = tonumber(Vml("GetSetting", "bob_n")) or 0
if n > 0 then Vml("SetProperty", "logs", "SelectedIndex", "1") end
for i = 1, n do                                   -- (a GitHub release only when its own button's pressed)
    if Vml("GetSetting", "bob_kind_" .. i) ~= "github" then Vml("RunScript", "Start", tostring(i)) end
end
LUA

@Script Took
Interpreter=lua
<<LUA
-- How long a build has been going (or took): "2m 05s"
local i = tostring((...))
local s = os.time() - (tonumber(Vml("GetSetting", "bob_start_" .. i)) or os.time())
return s >= 60 and string.format("%dm %02ds", math.floor(s / 60), s % 60) or (s .. "s")
LUA

@Script Tick
Interpreter=lua
<<LUA
-- Each running build: the stage it's at (its last "==>" line), the last thing it said, and the time so far
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    if Vml("GetSetting", "bob_run_" .. i) == "1" then
        local out = Vml("Shell", 'f="' .. Vml("GetSetting", "bob_log_" .. i) .. '"; grep "^==>" "$f" 2>/dev/null | tail -1; grep -v "^\\s*$" "$f" 2>/dev/null | tail -1') or ""
        local stage, detail = out:match("^==> ([^\n]*)\n([^\n]*)")
        if stage then
            Vml("SetProperty", "stage" .. i, "Text", stage)
            if detail:sub(1, 4) ~= "==> " then
                detail = detail:gsub("^%s+", "")
                Vml("SetProperty", "detail" .. i, "Text", #detail > 64 and detail:sub(1, 62) .. "…" or detail)
            end
        end
        Vml("SetProperty", "time" .. i, "Text", Vml("RunScript", "Took", tostring(i)))
    end
end
LUA

@Script Finish
Interpreter=lua
<<LUA
-- A build has ended: green with its time, or red with the last thing it said (and its log on show)
local i, code = ...
i = tostring(i)
local good = code == "0"
local took = Vml("RunScript", "Took", i)
local name = Vml("GetSetting", "bob_name") .. " " .. Vml("GetSetting", "bob_bname_" .. i)
Vml("SetSetting", "bob_run_" .. i, "")
Vml("SetSetting", "bob_said_" .. i, good and "green" or code == "stopped" and "stopped" or "failed")
if Vml("ControlExists", "light" .. i) ~= "true" then Vml("RunScript", "Busy") return end
Vml("SetProperty", "light" .. i, "Foreground", good and "#16A34A" or "#DC2626")
Vml("SetProperty", "time" .. i, "Text", took)
local before = good and Vml("Shell", 'grep -m1 "released already" "' .. Vml("GetSetting", "bob_log_" .. i) .. '" 2>/dev/null') or ""
if good and before ~= "" then
    Vml("SetProperty", "stage" .. i, "Text", "Released already")
    Vml("SetProperty", "detail" .. i, "Text", "raise the version for a new one")
elseif good then
    Vml("SetProperty", "stage" .. i, "Text", "Green: built in " .. took)
    Vml("SetProperty", "detail" .. i, "Text", (Vml("GetSetting", "bob_out_" .. i):gsub("^" .. (os.getenv("HOME") or "~"), "~")))
else
    local log = Vml("GetSetting", "bob_log_" .. i)
    local why = (Vml("Shell", 'grep -m1 -E "FAILED|Error|error:|Can.t reach" "' .. log .. '" 2>/dev/null || tail -1 "' .. log .. '"') or ""):gsub("%s+$", "")
    Vml("SetProperty", "stage" .. i, "Text", code == "stopped" and "Stopped" or "Failed")
    Vml("SetProperty", "detail" .. i, "Text", #why > 64 and why:sub(1, 62) .. "…" or why)
    Vml("SetProperty", "logs", "SelectedIndex", i)
end
Vml("RunScript", "Busy")
local any, said = false, {}
for k = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    if Vml("GetSetting", "bob_run_" .. k) == "1" then any = true end
    local r = Vml("GetSetting", "bob_said_" .. k)
    if r ~= "" then said[#said + 1] = Vml("GetSetting", "bob_bname_" .. k) .. " " .. r end
end
if not any then Vml("SetProperty", "StatusBar", "Text", Vml("GetSetting", "bob_name") .. ": " .. table.concat(said, ", ") .. " at " .. os.date("%H:%M")) end
-- a desktop notification, so a build finishing gets noticed with Bob behind other windows
Vml("Shell", 'notify-send -a Bob "Bob" "' .. name .. (good and (" built in " .. took) or " build failed") .. '" >/dev/null 2>&1 &')
LUA

@Script CopyLog
Interpreter=lua
<<LUA
-- A build's whole log on the clipboard, to paste anywhere
local i = tostring((...))
local text = i == "0" and Vml("GetProperty", "txtGitHub", "Text") or Vml("Shell", 'cat "' .. Vml("GetSetting", "bob_log_" .. i) .. '" 2>/dev/null') or ""
if text == "" then Vml("SetProperty", "StatusBar", "Text", "No log yet: build it first") return end
Vml("ClipboardSet", text)
local _, n = text:gsub("\n", "")
Vml("SetProperty", "StatusBar", "Text", (i == "0" and "GitHub" or Vml("GetSetting", "bob_bname_" .. i)) .. " log copied: " .. (n + 1) .. " lines")
LUA

@Script SaveLog
Interpreter=lua
<<LUA
-- Keep a build's log: asks where
local i = tostring((...))
local text = i == "0" and Vml("GetProperty", "txtGitHub", "Text") or Vml("Shell", 'cat "' .. Vml("GetSetting", "bob_log_" .. i) .. '" 2>/dev/null') or ""
if text == "" then Vml("SetProperty", "StatusBar", "Text", "No log yet: build it first") return end
local name = (Vml("GetSetting", "bob_name") .. "-" .. (i == "0" and "GitHub" or Vml("GetSetting", "bob_bname_" .. i))):gsub("[^%w%-]", "") .. "-" .. os.date("%Y%m%d-%H%M") .. ".log"
local where = Vml("SaveFile", name, text) or ""
if where ~= "" then Vml("SetProperty", "StatusBar", "Text", "Log saved: " .. (where:gsub("^" .. (os.getenv("HOME") or "~"), "~"))) end
LUA

@Script OpenLog
Interpreter=lua
<<LUA
-- A build's log in the text editor
local i = tostring((...))
if i == "0" then                                   -- the GitHub tab: the repo's Actions page in the browser
    Vml("Shell", 'cd "' .. Vml("RunScript", "Repo") .. '" && (u=$(gh repo view --json url -q .url 2>/dev/null); [ -n "$u" ] && xdg-open "$u/actions" >/dev/null 2>&1 &)')
    return
end
Vml("Shell", 'f="' .. Vml("GetSetting", "bob_log_" .. i) .. '"; [ -s "$f" ] && (xdg-open "$f" >/dev/null 2>&1 &)')
LUA

