Parent=c
Interval=1000
IsEnabled=false
OnTick=Tick

# --- scripts ------------------------------------------------------------------------

@Script Repo
Interpreter=lua
<<LUA
-- Where the repo is: BOB_REPO, else the preference, else ~/projects/vml-github
local pref = Vml("GetPreference", "bob_repo", "")
local r = Vml("Shell", 'printf %s "${BOB_REPO:-' .. (pref ~= "" and pref or "$HOME/projects/vml-github") .. '}"')
return ((r or ""):gsub("%s+$", ""))
LUA

@Script Host
Interpreter=lua
<<LUA
-- Which PC builds for Windows: BOB_HOST, else the preference, else a8 (a name from ~/.ssh/config)
local pref = Vml("GetPreference", "bob_host", "")
local h = Vml("Shell", 'printf %s "${BOB_HOST:-' .. (pref ~= "" and pref or "a8") .. '}"')
return ((h or ""):gsub("%s+$", ""))
LUA

@Script Opened
Interpreter=lua
<<LUA
for _, k in ipairs({ "bob_l_run", "bob_w_run", "bob_stopping", "bob_l_said", "bob_w_said" }) do Vml("SetSetting", k, "") end   -- (none running yet)
local repo = Vml("RunScript", "Repo")
Vml("SetProperty", "lblRepo", "Text", (repo:gsub("^" .. (os.getenv("HOME") or "~"), "~")))
local v = Vml("Shell", 'grep -m1 __version__ "' .. repo .. '/vml/__init__.py" 2>/dev/null | cut -d\'"\' -f2')
v = (v or ""):gsub("%s+$", "")
if v == "" then
    Vml("SetProperty", "lblVersion", "Text", "no repo here")
    Vml("SetProperty", "sb", "Text", "Can't find the Visualised repo at " .. repo .. ": Repo… to say where it is")
else
    Vml("SetProperty", "lblVersion", "Text", "Visualised " .. v)
end
-- the last builds, if there are any
local function last(file, stage)
    local when = Vml("Shell", 'date -r "' .. file .. '" "+%-d %b, %H:%M" 2>/dev/null')
    when = (when or ""):gsub("%s+$", "")
    if when ~= "" then Vml("SetProperty", stage, "Text", "Last built " .. when) end
end
last("$HOME/.cache/vml-build/vml-linux-x86_64.tar.gz", "stageL")
last("$HOME/.cache/vml-build-windows/Visualised-Setup.exe", "stageW")
Vml("RunScript", "AwayToday")
-- is the Windows PC awake? (asked in the background: an asleep PC takes a few seconds to not answer)
local host = Vml("RunScript", "Host")
Vml("SetProperty", "hostW", "Text", "on " .. host .. ": asking…")
Vml("SetProperty", "hostW", "Foreground", "#6B7280")
Vml("RunProcess", "ssh -o BatchMode=yes -o ConnectTimeout=6 '" .. host .. "' hostname", "", "A8Answered")
LUA

@Script A8Answered
Interpreter=lua
<<LUA
local up = Vml("GetSetting", "exit_code") == "0"
local host = Vml("RunScript", "Host")
Vml("SetProperty", "hostW", "Text", up and ("on " .. host .. ", over SSH") or ("on " .. host .. ": not answering (asleep, or off?)"))
Vml("SetProperty", "hostW", "Foreground", up and "#6B7280" or "#DC2626")
LUA

@Script Busy
Interpreter=lua
<<LUA
-- The buttons, the timer and the status bar, from which builds are running
local l = Vml("GetSetting", "bob_l_run") == "1"
local w = Vml("GetSetting", "bob_w_run") == "1"
Vml("SetProperty", "btnLinux", "IsEnabled", l and "false" or "true")
Vml("SetProperty", "btnWindows", "IsEnabled", w and "false" or "true")
Vml("SetProperty", "btnBoth", "IsEnabled", (l or w) and "false" or "true")
Vml("SetProperty", "btnStop", "IsEnabled", (l or w) and "true" or "false")
Vml("SetProperty", "chkInstall", "IsEnabled", l and "false" or "true")
Vml("SetProperty", "tmr", "IsEnabled", (l or w) and "true" or "false")
local what = (l and w) and "Building Linux and Windows" or l and "Building Linux" or w and "Building Windows" or nil
if what then Vml("SetProperty", "sb", "Text", what .. "…") end
LUA

@Script Start
Interpreter=lua
<<LUA
-- Start one build. side: "L" (Linux) or "W" (Windows)
local side = ...
if Vml("GetSetting", "bob_" .. side:lower() .. "_run") == "1" then return end
local repo = Vml("RunScript", "Repo")
local linux = side == "L"
local log = linux and "$HOME/.cache/bob-linux.log" or "$HOME/.cache/bob-windows.log"
local tool = linux and ("tools/build-local.sh" .. (Vml("GetProperty", "chkInstall", "IsChecked") == "true" and "" or " --no-install"))
                    or ("tools/build-windows.sh '" .. Vml("RunScript", "Host") .. "'")
Vml("SetProperty", "light" .. side, "Foreground", "#F59E0B")
Vml("SetProperty", "stage" .. side, "Text", "Starting…")
Vml("SetProperty", "detail" .. side, "Text", "")
Vml("SetProperty", "time" .. side, "Text", "0s")
Vml("SetProperty", linux and "txtLinux" or "txtWindows", "Text", "")
Vml("SetSetting", "bob_" .. side:lower() .. "_start", tostring(os.time()))
Vml("SetSetting", "bob_stopping", "")
Vml("SetSetting", "bob_" .. side:lower() .. "_said", "")
Vml("SetSetting", "bob_" .. side:lower() .. "_run", "1")
local cmd = 'cd "' .. repo .. '" && set -o pipefail && ' .. tool .. ' 2>&1 | tee "' .. log .. '"'
local pid = Vml("RunProcess", cmd, linux and "txtLinux" or "txtWindows", linux and "LinuxDone" or "WindowsDone")
Vml("SetSetting", "bob_" .. side:lower() .. "_pid", pid or "")
Vml("RunScript", "Busy")
LUA

@Script BuildLinux
Interpreter=lua
<<LUA
Vml("SetProperty", "logs", "SelectedIndex", "0")
Vml("RunScript", "Start", "L")
LUA

@Script BuildWindows
Interpreter=lua
<<LUA
Vml("SetProperty", "logs", "SelectedIndex", "1")
Vml("RunScript", "Start", "W")
LUA

@Script BuildBoth
Interpreter=lua
<<LUA
Vml("RunScript", "Start", "L")
Vml("RunScript", "Start", "W")
LUA

@Script Took
Interpreter=lua
<<LUA
-- How long a build has been going (or took): "2m 05s"
local side = ...
local s = os.time() - (tonumber(Vml("GetSetting", "bob_" .. side:lower() .. "_start")) or os.time())
return s >= 60 and string.format("%dm %02ds", math.floor(s / 60), s % 60) or (s .. "s")
LUA

@Script Tick
Interpreter=lua
<<LUA
-- Each running build: the stage it's at (its last "==>" line), the last thing it said, and the time so far
for _, side in ipairs({ "L", "W" }) do
    if Vml("GetSetting", "bob_" .. side:lower() .. "_run") == "1" then
        local log = side == "L" and "$HOME/.cache/bob-linux.log" or "$HOME/.cache/bob-windows.log"
        local out = Vml("Shell", 'f="' .. log .. '"; grep "^==>" "$f" 2>/dev/null | tail -1; grep -v "^\\s*$" "$f" 2>/dev/null | tail -1') or ""
        local stage, detail = out:match("^==> ([^\n]*)\n([^\n]*)")
        if stage then
            Vml("SetProperty", "stage" .. side, "Text", stage)
            if detail:sub(1, 4) ~= "==> " then
                Vml("SetProperty", "detail" .. side, "Text", #detail > 64 and detail:sub(1, 62) .. "…" or detail)
            end
        end
        Vml("SetProperty", "time" .. side, "Text", Vml("RunScript", "Took", side))
    end
end
LUA

@Script Finish
Interpreter=lua
<<LUA
-- A build has ended: green with its time, or red with the last thing it said (and its log on show)
local side, code = ...
local good = code == "0"
local took = Vml("RunScript", "Took", side)
local name = side == "L" and "Linux" or "Windows"
Vml("SetSetting", "bob_" .. side:lower() .. "_run", "")
Vml("SetSetting", "bob_" .. side:lower() .. "_said", good and "green" or code == "stopped" and "stopped" or "failed")
Vml("SetProperty", "light" .. side, "Foreground", good and "#16A34A" or "#DC2626")
Vml("SetProperty", "time" .. side, "Text", took)
if good then
    Vml("SetProperty", "stage" .. side, "Text", "Green: built in " .. took)
    Vml("SetProperty", "detail" .. side, "Text", side == "L" and "~/.cache/vml-build" or "~/.cache/vml-build-windows")
else
    local log = side == "L" and "$HOME/.cache/bob-linux.log" or "$HOME/.cache/bob-windows.log"
    local why = (Vml("Shell", 'grep -m1 -E "FAILED|Error|error:|Can.t reach" "' .. log .. '" 2>/dev/null || tail -1 "' .. log .. '"') or ""):gsub("%s+$", "")
    Vml("SetProperty", "stage" .. side, "Text", code == "stopped" and "Stopped" or "Failed")
    Vml("SetProperty", "detail" .. side, "Text", #why > 64 and why:sub(1, 62) .. "…" or why)
    Vml("SetProperty", "logs", "SelectedIndex", side == "L" and "0" or "1")
end
Vml("RunScript", "Busy")
if Vml("GetSetting", "bob_l_run") ~= "1" and Vml("GetSetting", "bob_w_run") ~= "1" then
    local said = {}
    for _, k in ipairs({ { "l", "Linux" }, { "w", "Windows" } }) do
        local r = Vml("GetSetting", "bob_" .. k[1] .. "_said")
        if r ~= "" then said[#said + 1] = k[2] .. " " .. r end
    end
    Vml("SetProperty", "sb", "Text", table.concat(said, ", ") .. " at " .. os.date("%H:%M"))
end
-- a desktop notification, so a build finishing gets noticed with Bob behind other windows
Vml("Shell", 'notify-send -a Bob "Bob" "' .. name .. (good and (" built in " .. took) or " build failed") .. '" >/dev/null 2>&1 &')
LUA

@Script LinuxDone
Interpreter=lua
<<LUA
local code = Vml("GetSetting", "exit_code")
Vml("RunScript", "Finish", "L", Vml("GetSetting", "bob_stopping") == "1" and "stopped" or code)
LUA

@Script WindowsDone
Interpreter=lua
<<LUA
local code = Vml("GetSetting", "exit_code")
Vml("RunScript", "Finish", "W", Vml("GetSetting", "bob_stopping") == "1" and "stopped" or code)
LUA

@Script Stop
Interpreter=lua
<<LUA
-- Stop whatever is building: here, and the build on the Windows PC too (stopping the ssh alone would leave it running there)
local yes = Vml("ConfirmDialog", "Stop the build" .. ((Vml("GetSetting", "bob_l_run") == "1" and Vml("GetSetting", "bob_w_run") == "1") and "s" or "") .. "?", "Stop")
if yes ~= true and yes ~= "true" and yes ~= "True" then return end
Vml("SetSetting", "bob_stopping", "1")
if Vml("GetSetting", "bob_w_run") == "1" then
    Vml("Shell", "H='" .. Vml("RunScript", "Host") .. "'; " .. [[PS='Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like "*build-windows.ps1*" } | ForEach-Object { taskkill /F /T /PID $_.ProcessId | Out-Null }'; ssh -o BatchMode=yes -o ConnectTimeout=6 "$H" "powershell -NoProfile -EncodedCommand $(printf %s "$PS" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)" >/dev/null 2>&1; pkill -f "tools/build-windows.sh"; pkill -f "vml-build.build-windows.ps1"; true]])
end
if Vml("GetSetting", "bob_l_run") == "1" then
    Vml("Shell", [[pkill -f "tools/build-local.sh"; pkill -f "vml-build-venv/bin/python -m nuitka"; true]])
end
for _, side in ipairs({ "l", "w" }) do
    local pid = Vml("GetSetting", "bob_" .. side .. "_pid")
    if pid ~= "" then Vml("CancelProcess", pid) end
end
LUA

@Script SetUp
Interpreter=lua
<<LUA
-- The two things that differ from one lab to the next: where the repo is, and which PC builds for Windows
local repo = Vml("RunScript", "Repo")
local r = Vml("PromptDialog", "Set up", "Where's the Visualised repo? (the folder with tools/ in it)", repo)
if r and r ~= "" and r ~= repo then Vml("SetPreference", "bob_repo", r) end
local host = Vml("RunScript", "Host")
local h = Vml("PromptDialog", "Set up", "Which PC builds for Windows? (its name in ~/.ssh/config, or user@address)", host)
if h and h ~= "" and h ~= host then Vml("SetPreference", "bob_host", h) end
Vml("RunScript", "Opened")
LUA

@Script OpenBuilds
Interpreter=lua
<<LUA
Vml("Shell", 'mkdir -p "$HOME/.cache/vml-build-windows"; xdg-open "$HOME/.cache/vml-build-windows" >/dev/null 2>&1 & xdg-open "$HOME/.cache/vml-build" >/dev/null 2>&1 &')
LUA

@Script Minutes
Interpreter=lua
<<LUA
-- 45 -> "45m", 65 -> "1h 05m"
local m = math.floor(tonumber((...)) or 0)
return m < 60 and (m .. "m") or string.format("%dh %02dm", math.floor(m / 60), m % 60)
LUA

@Script AwayToday
Interpreter=lua
<<LUA
-- Today's time away from the desk, from the log, along the foot
local total = Vml("Shell", [[awk -F, -v d="$(date +%F)" '$1 == d { t += $4 } END { print t + 0 }' "$HOME/.local/share/bob/away.csv" 2>/dev/null]])
Vml("SetProperty", "sb", "Panels", "Ready|Away today " .. Vml("RunScript", "Minutes", ((total or "0"):gsub("%s+", ""))) .. "|{time}")
LUA

@Script Away
Interpreter=lua
<<LUA
-- Away from desk: lock the Windows PC and this computer, and time it till the screen is unlocked again
Vml("SetSetting", "bob_away_start", tostring(os.time()))
Vml("SetSetting", "bob_away_seen", "")
Vml("SetProperty", "sb", "Text", "Away from desk since " .. os.date("%H:%M"))
Vml("Shell", "ssh -o BatchMode=yes -o ConnectTimeout=4 '" .. Vml("RunScript", "Host") .. "' 'tsdiscon console' >/dev/null 2>&1 &")
Vml("SetProperty", "tmrDesk", "IsEnabled", "true")
Vml("Shell", "(loginctl lock-session 2>/dev/null || xdg-screensaver lock 2>/dev/null) &")
LUA

@Script DeskCheck
Interpreter=lua
<<LUA
-- Locked still? Once it has been locked and isn't any more, you're back: log it
local out = Vml("Shell", [[gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver --method org.gnome.ScreenSaver.GetActive 2>/dev/null || loginctl show-session "$XDG_SESSION_ID" -p LockedHint --value 2>/dev/null]]) or ""
local locked = out:find("true") ~= nil or out:find("yes") ~= nil
local start = tonumber(Vml("GetSetting", "bob_away_start")) or os.time()
if locked then
    Vml("SetSetting", "bob_away_seen", "1")
    return
end
if Vml("GetSetting", "bob_away_seen") ~= "1" then
    if os.time() - start > 30 then                   -- it never locked: say so, log nothing
        Vml("SetProperty", "tmrDesk", "IsEnabled", "false")
        Vml("SetProperty", "sb", "Text", "Couldn't lock this screen (loginctl lock-session didn't)")
    end
    return
end
Vml("SetProperty", "tmrDesk", "IsEnabled", "false")
local mins = math.floor((os.time() - start) / 60 + 0.5)
Vml("Shell", string.format([[f="$HOME/.local/share/bob/away.csv"; mkdir -p "$(dirname "$f")"; [ -s "$f" ] || echo "date,away,back,minutes" > "$f"; echo "%s,%s,%s,%d" >> "$f"]],
    os.date("%Y-%m-%d", start), os.date("%H:%M", start), os.date("%H:%M"), mins))
Vml("SetProperty", "sb", "Text", "Welcome back: away " .. Vml("RunScript", "Minutes", mins) .. ", " .. os.date("%H:%M", start) .. " to " .. os.date("%H:%M"))
Vml("RunScript", "AwayToday")
LUA
