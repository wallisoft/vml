@Script Stop
Interpreter=lua
<<LUA
-- Stop whatever is building: here, and on the machines the builds run on (stopping the ssh alone would leave them)
local yes = Vml("ConfirmDialog", "Stop the builds going?", "Stop")
if yes ~= true and yes ~= "true" and yes ~= "True" then return end
Vml("SetSetting", "bob_stopping", "1")
for i = 1, tonumber(Vml("GetSetting", "bob_n")) or 0 do
    if Vml("GetSetting", "bob_run_" .. i) == "1" then
        Vml("Shell", Vml("RunScript", "Bob", '--config "' .. Vml("GetSetting", "bob_config") .. '" --build "' .. Vml("GetSetting", "bob_bname_" .. i) .. '" --stop') .. " >/dev/null 2>&1")
        local pid = Vml("GetSetting", "bob_pid_" .. i)
        if pid ~= "" then Vml("CancelProcess", pid) end
    end
end
LUA

@Script SetUp
Interpreter=lua
<<LUA
-- Where the repo is (the folder with tools/bob in it): its projects are the ones with a recipe
local repo = Vml("RunScript", "Repo")
local r = Vml("PromptDialog", "Set up", "Where's the repo? (the folder with tools/bob/ in it)", repo)
if r and r ~= "" and r ~= repo then Vml("SetPreference", "bob_repo", r) end
Vml("RunScript", "Opened")
LUA

@Script Machines
Interpreter=lua
<<LUA
-- The machines Bob builds on: a small JSON file, opened in the text editor. Back here, the cards follow it.
local file = (Vml("Shell", Vml("RunScript", "Bob", "--machines") .. ' >/dev/null 2>&1; printf %s "${BOB_MACHINES:-$HOME/.config/bob/machines.vml}"') or ""):gsub("%s+$", "")
Vml("RunScript", "EditText", file)
Vml("SetProperty", "StatusBar", "Text", "Machines: " .. (file:gsub("^" .. (os.getenv("HOME") or "~"), "~")) ..
    "   add one: @Machine mini, Host=mini, OS=linux; then pick the project again")
LUA

@Script EditText
Interpreter=lua
<<LUA
-- A recipe or the machines, in a text editor (not xdg-open: a .vml would open in Visualised, as a form)
local f = (...)
Vml("Shell", 'f="' .. f .. '"; for e in gnome-text-editor gedit kate mousepad xed pluma code; do ' ..
    'command -v "$e" >/dev/null && { "$e" "$f" >/dev/null 2>&1 & exit 0; }; done; xdg-open "$f" >/dev/null 2>&1 &')
LUA

@Script Help
Interpreter=lua
