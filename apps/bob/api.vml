# Bob's API: what another program (vml mcp, TopCat) may ask of him. See vml/appapi.py for the shape.
@Api Bob
Run=python3 -u tools/bob/run.py
About=Builds Visualised projects here and on other machines over SSH: programs, setup files, Store packages, releases

@Command projects
Level=look
About=Every project with a recipe in the repo (its recipe's path is what the other commands take)
Run=--projects

@Command builds
Level=look
About=A project's builds: their names, kinds and machines
Param=recipe:text:The project's recipe.vml (from projects)
Run=--config {recipe} --list

@Command machines
Level=look
About=The machines Bob builds on
Run=--machines

@Command build
Level=ask
About=Run one of a project's builds, in Bob's window so you can watch it (opens Bob if it's shut). Some builds publish (a GitHub release), so the person's yes first
Param=recipe:text:The project's recipe.vml
Param=build:text:The build's name (from builds)
Run=--config {recipe} --build {build} --queue

@Command edge
Level=ask
About=Publish this computer's builds as the rolling 'build' - a quiet upstream build (no update pill; offered in About on a version-click). Runs in Bob's window. The person's yes first
Param=recipe:text:The project's recipe.vml
Param=build:text:The GitHub build's name (from builds)
Run=--config {recipe} --build {build} --edge --queue

@Command stop
Level=do
About=Stop a build that's going
Param=recipe:text:The project's recipe.vml
Param=build:text:The build's name
Run=--config {recipe} --build {build} --stop
