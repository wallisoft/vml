# Report builder: pick a room, a finding and some advice, and add it to the report.
# The three lists narrow each other through their ItemsSource alone: there is no script behind them.

@Window Report
Title=Report builder
Width=720
Height=520
OnOpened=ReportOpened

@Canvas ReportCanvas
Parent=Report
Background=#ffffff

@TextBlock lblRoom
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=16
Text=Room

@ComboBox cboRoom
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=38
Width=200
ItemsSource=SELECT DISTINCT f1 FROM blocks WHERE tag = 'Findings' ORDER BY f1

@TextBlock lblFinding
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=76
Text=Finding

@ListBox lstFinding
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=98
Width=330
Height=130
ItemsSource=SELECT DISTINCT f2 FROM blocks WHERE tag = 'Findings' AND f1 = {cboRoom} ORDER BY f2

@TextBlock lblAdvice
Parent=ReportCanvas
Canvas.Left=362
Canvas.Top=76
Text=Advice

@ListBox lstAdvice
Parent=ReportCanvas
Canvas.Left=362
Canvas.Top=98
Width=342
Height=130
Anchor=Top,Left,Right
ItemsSource=SELECT f3 FROM blocks WHERE tag = 'Findings' AND f1 = {cboRoom} AND f2 = {lstFinding} ORDER BY id
OnDoubleClick=AddFinding

@Button btnAdd
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=240
Width=140
Height=30
Content=Add to report
OnClick=AddFinding

@ComboBox cboSignoff
Parent=ReportCanvas
Canvas.Left=362
Canvas.Top=243
Width=170
ItemsSource=SELECT f1 FROM blocks WHERE tag = 'Sign-offs' ORDER BY f1

@Button btnSignoff
Parent=ReportCanvas
Canvas.Left=544
Canvas.Top=240
Width=160
Height=30
Anchor=Top,Right
Content=Add sign-off
OnClick=AddSignoff

@TextBox txtReport
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=284
Width=688
Height=176
Anchor=Top,Bottom,Left,Right
AcceptsReturn=true

@Button btnClear
Parent=ReportCanvas
Canvas.Left=16
Canvas.Top=474
Width=100
Height=30
Anchor=Bottom,Left
Content=Clear
OnClick=ClearReport

@Button btnMaintain
Parent=ReportCanvas
Canvas.Left=524
Canvas.Top=474
Width=180
Height=30
Anchor=Bottom,Right
Content=Edit data blocks...
OnClick=Maintain

@Script ReportOpened
Interpreter=lua
<<LUA
-- make the tables (and some content to try) the first time; the lists fill themselves once this has run
Blocks.setup()
LUA

@Script AddFinding
Interpreter=lua
<<LUA
local room = Vml("GetProperty", "cboRoom", "SelectedItem")
local finding = Vml("GetProperty", "lstFinding", "SelectedItem")
local advice = Vml("GetProperty", "lstAdvice", "SelectedItem")
if finding == "" then return Vml("InfoDialog", "Choose a finding first.", "Report builder") end
local line = room .. ": " .. finding .. "."
if advice ~= "" then line = line .. " " .. advice end
local text = Vml("GetProperty", "txtReport", "Text")
Vml("SetProperty", "txtReport", "Text", text .. (text ~= "" and "\n\n" or "") .. line)
LUA

@Script AddSignoff
Interpreter=lua
<<LUA
local name = Vml("GetProperty", "cboSignoff", "SelectedItem")
local found = require("dkjson").decode(Vml("DbQuery", "blocks", "SELECT f2 FROM blocks WHERE tag = 'Sign-offs' AND f1 = ?", name))
if not found[1] then return end
local text = Vml("GetProperty", "txtReport", "Text")
Vml("SetProperty", "txtReport", "Text", text .. (text ~= "" and "\n\n" or "") .. found[1].f2)
LUA

@Script ClearReport
Interpreter=lua
<<LUA
Vml("SetProperty", "txtReport", "Text", "")
LUA

@Script Maintain
Interpreter=lua
<<LUA
-- the maintenance form is another form in the project; when it closes, the lists look at the data again
Vml("FormOpenModal", "maintain")
Vml("Requery")
LUA
