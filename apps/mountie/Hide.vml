# ============================================================================
# Mountie: what a folder drive shows. Tick the usual suspects, or write your
# own rules as a .gitignore has them; the line at the bottom shows what the
# drive would show now. Opened by Mountie.vml (Folders tab, "What it shows").
#   in:  setting hide_edit = {name, path, hide, showonly}
#   out: SetDialogResult {hide, showonly}, or nothing if cancelled
# ============================================================================

@Window Hide
Title=What it shows
Width=460
Height=650
Icon=mountie.png
OnOpened=HideStart

