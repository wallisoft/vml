# ============================================================================

@Script HideStart
Interpreter=lua
<<LUA
json = require("dkjson")
Edit = json.decode(Vml("GetSetting", "hide_edit") or "") or {}
USUAL = json.decode(Vml("IgnoreUsual") or "") or {}
Busy = false

function Lines()                 -- the rules box, line by line (trimmed)
  local out = {}
  for line in ((Vml("GetProperty", "txtHide", "Text") or "") .. "\n"):gmatch("([^\n]*)\n") do
    out[#out + 1] = line:match("^%s*(.-)%s*$")
  end
  while #out > 0 and out[#out] == "" do table.remove(out) end
  return out
end

function Has(lines, l) for i, x in ipairs(lines) do if x == l then return i end end end

function Retick()                -- a box is ticked when its line is in the rules
  local lines = Lines()
  for i, u in ipairs(USUAL) do Vml("SetProperty", "chkU" .. i, "IsChecked", tostring(Has(lines, u.patterns) ~= nil)) end
end

function Preview()
  local only = Vml("GetProperty", "chkShowOnly", "IsChecked") == "true"
  Vml("SetProperty", "lblHideTicks", "Text", only and "Show only" or "Leave out")
  local got = json.decode(Vml("FolderPreview", Edit.path or "", Vml("GetProperty", "txtHide", "Text") or "",
    only and "1" or "0") or "") or {}
  if got.error then
    Vml("SetProperty", "lblHidePreview", "Foreground", "#B91C1C")
    return Vml("SetProperty", "lblHidePreview", "Text", "✕ " .. got.error)
  end
  Vml("SetProperty", "lblHidePreview", "Foreground", "#374151")
  local total = (got.shown or 0) + (got.hidden or 0)
  local names = table.concat(got.names or {}, "   ")
  if (got.shown or 0) > #(got.names or {}) then names = names .. "   ..." end
  local folders = got.folders_out or 0
  Vml("SetProperty", "lblHidePreview", "Text", "Shows " .. (got.shown or 0) .. " of the " .. total .. " things at the top"
    .. ((got.hidden or 0) > 0 and (" (" .. got.hidden .. " left out)") or "") .. ":\n" .. (names ~= "" and names or "(nothing)")
    .. (folders > 0 and ("\n\n⚠ " .. folders .. (folders == 1 and " folder is" or " folders are") .. " left out, and everything in "
        .. (folders == 1 and "it" or "them") .. ". Untick Folders to keep them.") or ""))
  if folders > 0 then Vml("SetProperty", "lblHidePreview", "Foreground", "#92400E") end
end

function SetRules(lines)
  Busy = true
  Vml("SetProperty", "txtHide", "Text", table.concat(lines, "\n"))
  Busy = false
  Retick(); Preview()
end

local name = Edit.name or "this drive"
Vml("SetProperty", "Hide", "Title", "What " .. name .. " shows")
Vml("SetProperty", "lblHideTitle", "Text", "What " .. name .. " shows")
Vml("SetProperty", "lblHideFrom", "Text", "from " .. (Edit.path or ""))
for i = 1, 12 do
  local u = USUAL[i]
  Vml("SetProperty", "chkU" .. i, "IsVisible", tostring(u ~= nil))
  if u then Vml("SetProperty", "chkU" .. i, "Content", u.label) end
end
Vml("SetProperty", "chkShowOnly", "IsChecked", tostring(Edit.showonly == true))
Busy = true
Vml("SetProperty", "txtHide", "Text", Edit.hide or "")
Busy = false
Retick(); Preview()
LUA

@Script HideTicked
Interpreter=lua
<<LUA
local lines = Lines()
for i, u in ipairs(USUAL) do
  local on = Vml("GetProperty", "chkU" .. i, "IsChecked") == "true"
  local at = Has(lines, u.patterns)
  if on and not at then lines[#lines + 1] = u.patterns
  elseif at and not on then table.remove(lines, at) end
end
SetRules(lines)
LUA

@Script HideTyped
Interpreter=lua
<<LUA
if not Busy then Retick(); Preview() end
LUA

@Script HideModeChanged
Interpreter=lua
<<LUA
Preview()
LUA

@Script HideClearAll
Interpreter=lua
<<LUA
SetRules({})
LUA

@Script HideUseThem
Interpreter=lua
<<LUA
Vml("SetDialogResult", json.encode({ hide = table.concat(Lines(), "\n"),
  showonly = Vml("GetProperty", "chkShowOnly", "IsChecked") == "true" }))
Vml("CloseForm", "Hide")
LUA

@Script HideCancelIt
Interpreter=lua
<<LUA
Vml("CloseForm", "Hide")
LUA
