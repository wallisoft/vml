# ============================================================================
# Scripts: Start sets things up; each event calls its handler in ssh.lua or
# disks.lua, the project's modules (see Mountie.vmlproj).
# ============================================================================

@Script Start
Interpreter=lua
<<LUA
json = require("dkjson")
Drives = json.decode(Vml("GetSetting", "drives") or "") or {}
State = {}          -- name -> {state=, detail=}
Editing = nil       -- index of the drive being changed (nil: a new one)
LIST = { "lstDrives", "btnToggle", "btnAdd", "btnEdit", "btnRemove" }
FOOT = { "chkBoot", "lblStatus" }
TABS = { "tabs" }
DISK = { "lstDisk", "btnDiskToggle", "btnDiskAdd", "btnDiskOpen", "btnDiskRename", "btnDiskRemove", "chkDiskRO", "chkDiskAuto", "chkDiskOn" }
Info = {}            -- path -> what the image is (format, size, label, partitions), read once
Images = json.decode(Vml("GetSetting", "images") or "") or {}       -- {name, path, kind, readonly, automount, enabled}
                     -- (kind "folder": + hide, showonly; kind "ram": + size (MB), keep)
Parts = {}           -- the computer's partitions, as last listed
DiskState = {}       -- name -> {state=, detail=}
Tab = "Ssh"
LOG = json.decode(Vml("GetSetting", "log") or "") or {}            -- {t, text, bad}, newest first
Unseen = tonumber(Vml("GetSetting", "log_unseen") or "") or 0      -- problems not looked at yet
FORM = { "pnlEdit", "lblForm", "txtName", "txtMount", "txtHost", "txtPort", "txtUser", "txtRemote", "cmbAuth", "txtSecret",
         "txtKey", "btnBrowse", "txtActAs", "btnAllow", "chkAuto", "chkReadOnly", "btnTest", "btnSave", "btnCancel", "lblTest" }
Tested = nil        -- the last good Test: {host, port, hostkey}, so saving keeps the key it was shown
PickedKey = nil     -- a key picked on a phone: its text (a one-line box can't hold it), shown by name

-- what this device can do
Can = json.decode(Vml("SshMethods") or "") or {}
VERSION = Vml("GetProperty", "Mountie", "Version") or ""
if VERSION == "" then VERSION = "1.3.1" end                 -- (a phone page may not know its window's Version)
Vml("SetProperty", "lblVer", "Text", "v" .. VERSION)
local can = Can
if can.android then
  Vml("SetProperty", "chkBoot", "IsVisible", "false")       -- a phone keeps its drives in Files by itself
  table.remove(LIST, 6)
  for _, gone in ipairs({ "txtMount", "txtActAs" }) do                -- no drive letters on a phone; sudo from a computer
    for i, n in ipairs(FORM) do if n == gone then table.remove(FORM, i) break end end
  end
  Vml("SetProperty", "txtName", "Width", "432")
  Say("Connected drives are in the Files app (under Browse), and in every app's \"open file\".")
  for _, p in ipairs({ "pIso", "pVhd", "pPart", "pFold", "pRam" }) do           -- a phone: SSH drives, and sharing itself
    Vml("SetProperty", p, "IsVisible", "false")
  end
  Vml("SetProperty", "pPhone", "Header", "Share")
  Show({ "lstPhones", "btnPhoneAdd", "btnPhoneFind", "btnPhonePair", "txtPhoneAddr" }, false)
  Show({ "btnShare", "btnSharePair", "lstComputers", "btnForget", "chkAsk" }, true)
  Vml("SetProperty", "lblPhone", "Height", "230")
elseif can.windows and not can.winfsp then
  Say("Drives use Windows' own WebDAV client. For faster drives with no 50 MB file limit, install WinFsp (free, winfsp.dev) and restart this app.")
end
Vml("SetProperty", "chkBoot", "IsChecked", Vml("GetSetting", "at_boot") == "on" and "true" or "false")
LogButton()
Refresh()
for _, d in ipairs(Drives) do if d.automount ~= false then Mount(d) end end
if not can.android then
  for _, im in ipairs(Images) do if im.automount and im.enabled ~= false then DiskMount(im) end end
end
ShowTab("Ssh")
if Vml("LaunchedAtBoot") == "true" then Vml("HideForm", "Mountie") end
LUA

@Script TabPicked
Interpreter=lua
<<LUA
local names = { "Ssh", "Iso", "Vhd", "Part", "Fold", "Ram", "Phone" }
local t = names[(tonumber(Vml("GetProperty", "tabs", "SelectedIndex")) or 0) + 1] or "Ssh"
if t == "Phone" then Phone.Show() else ShowTab(t) end
LUA

