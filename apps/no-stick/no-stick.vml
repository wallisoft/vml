Vml("SetStatusText", "Back up (files only, not the whole disk): coming next")
LUA

@Script RestoreVhd
Interpreter=lua
<<LUA
-- unpacks a backup into a fresh VHD (can be a different size)
Vml("SetStatusText", "Restore into a new VHD: coming next")
LUA

@Script BootNow
Interpreter=lua
<<LUA
Vml("SetStatusText", "Boot now (kexec): coming next")
LUA

@Script BootRestart
Interpreter=lua
<<LUA
-- add the selected VHD to the boot menu so it boots on real hardware at next restart.
-- writes ONE file No-Stick owns (/etc/grub.d/40_nostick) listing every bootable VHD, plus a
-- Windows chainloader entry if Windows is found. Never touches your other GRUB entries.
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item or item.kind ~= "VHD" then return end
if not item.bootable then
    return Vml("ErrorDialog", "'" .. item.name .. "' has no OS installed yet.\n\nUse 'Install to a VHD' first.", "Boot at restart")
end
if Vml("ConfirmDialog", "Add your bootable VHDs to the boot menu?\n\nThis updates GRUB (one file No-Stick owns). " ..
       "Your existing boot entries are not touched. You'll see the new entries at your next restart.", "Boot at restart") ~= "true" then
    return
end
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", "Updating the boot menu")
Vml("SetProperty", "joblog", "Items", "")
CURRENT_JOB = Vml("RunProcess", Vml("RunScript", "BuildGrubScript"), "joblog", "BootRestartDone", "bash")
LUA

@Script BuildGrubScript
Interpreter=lua
<<LUA
-- returns the bash that writes /etc/grub.d/40_nostick. Each bootable VHD becomes a menuentry using
-- the proven vhdfile= + initramfs-hook method; Windows (if found on an EFI System Partition) gets a
-- chainloader entry so it stays bootable.
local json = require("dkjson")
local raw = Vml("Shell", "cat /opt/no-stick/vhds/vhd_config.json 2>/dev/null")
local cfg = (raw ~= "" and json.decode(raw)) or {vhds = {}}
local entries = {}
for name, v in pairs(cfg.vhds or {}) do
    if v.bootable then
        entries[#entries + 1] = "cat >> \"$F\" << 'ENTRY'\n" ..
            "menuentry \"No-Stick: " .. name .. "\" {\n" ..
            "    insmod part_gpt\n    insmod ext2\n" ..
            "    search --no-floppy --file --set=host /opt/no-stick/vhds/" .. name .. ".img\n" ..
            "    loopback loop /opt/no-stick/vhds/" .. name .. ".img\n" ..
            "    linux (loop,gpt2)/boot/vmlinuz root=/dev/loop0p2 vhdfile=/opt/no-stick/vhds/" .. name .. ".img ro\n" ..
            "    initrd (loop,gpt2)/boot/initrd.img\n" ..
            "}\nENTRY\n"
    end
end
local script = "set -e\n" ..
    "F=/tmp/40_nostick\n" ..
    "cat > \"$F\" << 'HEAD'\n#!/bin/sh\nexec tail -n +4 \"$0\"\n# No-Stick boot entries - managed by No-Stick, safe to let No-Stick rewrite\nHEAD\n" ..
    table.concat(entries, "") ..
    -- Windows chainloader if an EFI Windows bootloader is present
    "WIN=$(find /boot/efi/EFI -iname 'bootmgfw.efi' 2>/dev/null | head -1 || true)\n" ..
    "if [ -n \"$WIN\" ]; then\n" ..
    "  echo 'Found Windows - adding a chainloader entry'\n" ..
    "  cat >> \"$F\" << 'WINENTRY'\n" ..
    "menuentry \"Windows Boot Manager\" {\n    insmod part_gpt\n    insmod chain\n    search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi\n    chainloader /EFI/Microsoft/Boot/bootmgfw.efi\n}\nWINENTRY\n" ..
    "fi\n" ..
    "echo 'Installing boot entries...'\n" ..
    "sudo cp \"$F\" /etc/grub.d/40_nostick\n" ..
    "sudo chmod +x /etc/grub.d/40_nostick\n" ..
    "echo 'Updating GRUB...'\n" ..
    "sudo update-grub 2>&1 || sudo grub-mkconfig -o /boot/grub/grub.cfg 2>&1\n" ..
    "echo 'Boot menu updated.'\n"
return script
LUA

@Script BootRestartDone
Interpreter=lua
<<LUA
Vml("SetProperty", "JobBar", "IsVisible", "false")
if Vml("GetSetting", "exit_code") == "0" then
    Vml("InfoDialog", "Your boot menu is updated.\n\nRestart and choose a 'No-Stick:' entry to boot your VHD on real hardware.", "Boot at restart")
    Vml("SetStatusText", "Boot menu updated - restart to use it")
else
    Vml("ErrorDialog", "Couldn't update the boot menu. See the log.\n\nYour existing boot entries are unchanged.", "Boot at restart")
end
LUA

@Script DeleteItem
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item then return end
if Vml("ConfirmDialog", "Delete " .. item.kind .. " '" .. item.name .. "'?\n\n" .. item.file ..
       "\n\nThis removes the file permanently.", "Delete") ~= "true" then return end
if item.kind == "VHD" then
    local json = require("dkjson")
    local raw = Vml("Shell", "cat /opt/no-stick/vhds/vhd_config.json 2>/dev/null")
    local cfg = (raw ~= "" and json.decode(raw)) or {vhds = {}}
    if cfg.vhds then cfg.vhds[item.name] = nil end
    local out = json.encode(cfg, {indent = true})
    Vml("Shell", "cat > /tmp/nostick-cfg.json << 'ENDCFG'\n" .. out .. "\nENDCFG\n" ..
        "sudo cp /tmp/nostick-cfg.json /opt/no-stick/vhds/vhd_config.json\n" ..
        "sudo rm -f '" .. item.file .. "'")
else
    Vml("Shell", "rm -f '" .. item.file .. "'")
end
Vml("SetStatusText", "Deleted " .. item.name)
Vml("RunScript", "Load")
LUA
