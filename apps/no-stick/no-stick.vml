# No-Stick: a bare-metal VirtualBox. Manage a library of ISOs and VHDs, and boot any of them
# directly, with none of the virtualisation overhead.
#
# Layout (0.3):
#   ~/.no-stick/isos/NAME.iso      the ISO library
#   ~/.no-stick/vhds/NAME.img      a virtual disk (sparse file)
#   ~/.no-stick/vhds/NAME.grub     that disk's boot-menu entry; present = in the menu (.grub.off = prepared, hidden)
#   ~/.no-stick/isos/NAME.iso.grub a live-boot entry for that ISO, same idea
#   ~/.no-stick/menu.conf          default=<entry id> and timeout=<seconds> for the No-Stick menu
#   /boot/no-stick/grub.cfg        the No-Stick menu, generated from the .grub files
# The main GRUB menu only ever holds ONE "No-Stick" entry that opens /boot/no-stick/grub.cfg.

# Layout notes: the window is fixed-size and grows by itself to fit the sidebar (the engine expands a window to its
# content before showing it, so Height below is only a floor). The info bar and the Delete button are both docked to
# the bottom with the same height and bottom margin, which is what keeps them level on any font.
@Window NoStick
Title=No-Stick 0.5.2
Width=860
Height=560
Resizable=false
OnOpened=Load

@DockPanel Root
Parent=NoStick

@Border Header
Parent=Root
DockPanel.Dock=Top
Height=58
Background=#1E3A8A
Padding=18,0

@TextBlock Title
Parent=Header
Text=No-Stick
FontSize=22
FontWeight=Bold
Foreground=White
VerticalAlignment=Center

@Border Sidebar
Parent=Root
DockPanel.Dock=Right
Width=205
Background=#F9FAFB
BorderBrush=#E5E7EB
BorderThickness=1,0,0,0

@DockPanel SideDock
Parent=Sidebar
Margin=14,14,14,16

@Button btnDelete
Parent=SideDock
DockPanel.Dock=Bottom
Content=Delete...
Height=32
Margin=0,14,0,0
OnClick=DeleteItem

@StackPanel Buttons
Parent=SideDock
Spacing=7

@TextBlock LibManageLabel
Parent=Buttons
Text=LIBRARY
FontSize=10
FontWeight=Bold
Foreground=#2563EB

@Button btnDownload
Parent=Buttons
Content=Download a distro...
Background=#2563EB
Foreground=White
Padding=10,7
OnClick=Download

@Button btnAddIso
Parent=Buttons
Content=Add an ISO I have...
Padding=10,7
OnClick=AddIso

@Button btnNewVhd
Parent=Buttons
Content=New empty VHD...
Padding=10,7
OnClick=NewVhd

@TextBlock DoLabel
Parent=Buttons
Text=WITH THE SELECTED ISO
FontSize=10
FontWeight=Bold
Foreground=#2563EB
Margin=0,10,0,0

@Button btnTryLive
Parent=Buttons
Content=Try it live
Padding=10,7
OnClick=TryLive

@Button btnInstallVhd
Parent=Buttons
Content=Install to a VHD...
Padding=10,7
OnClick=InstallVhd

@Button btnInstallPart
Parent=Buttons
Content=Install to a partition...
Padding=10,7
OnClick=InstallPartition

@TextBlock VhdLabel
Parent=Buttons
Text=WITH THE SELECTED VHD
FontSize=10
FontWeight=Bold
Foreground=#2563EB
Margin=0,10,0,0

@Button btnBootNow
Parent=Buttons
Content=Boot now
Padding=10,7
OnClick=BootNow

@Button btnBootRestart
Parent=Buttons
Content=Boot at restart
Padding=10,7
OnClick=BootRestart

@Button btnBackup
Parent=Buttons
Content=Back up...
Padding=10,7
OnClick=BackupVhd

@Button btnRestore
Parent=Buttons
Content=Restore...
Padding=10,7
OnClick=RestoreVhd

@TextBlock MenuLabel
Parent=Buttons
Text=BOOT MENU (SELECTED ITEM)
FontSize=10
FontWeight=Bold
Foreground=#2563EB
Margin=0,10,0,0

@CheckBox chkInMenu
Parent=Buttons
Content=Show in boot menu
OnClick=ToggleMenu

@CheckBox chkDefault
Parent=Buttons
Content=Boot this by default
OnClick=ToggleDefault

@Button btnTimeout
Parent=Buttons
Content=Auto-boot: off
Padding=10,7
OnClick=SetTimeout

@Button btnRepair
Parent=Buttons
Content=Repair boot
Padding=10,7
OnClick=RepairBoot

@DockPanel Main
Parent=Root
Margin=16,16,16,16

@TextBlock LibLabel
Parent=Main
DockPanel.Dock=Top
Text=Your library
FontSize=13
FontWeight=Bold
Foreground=#111827
Margin=0,0,0,4

@Border StatusWrap
Parent=Main
DockPanel.Dock=Bottom
Height=32
Background=#F3F4F6
BorderBrush=#E5E7EB
BorderThickness=1,1,1,1
Padding=10,0
Margin=0,6,0,0

@TextBlock statusText
Parent=StatusWrap
Text=Loading...
Foreground=#4B5563
FontSize=11
VerticalAlignment=Center

@Border JobBar
Parent=Main
DockPanel.Dock=Bottom
Height=150
Background=#0F172A
IsVisible=false
Padding=12,8
Margin=0,6,0,0

@StackPanel JobCol
Parent=JobBar
Spacing=4

@StackPanel JobHead
Parent=JobCol
Orientation=Horizontal
Spacing=8

@TextBlock jobTitle
Parent=JobHead
Text=Working...
Foreground=White
FontWeight=Bold
VerticalAlignment=Center

@Button btnJobCancel
Parent=JobHead
Content=Cancel
Padding=10,2
OnClick=JobCancel

@ListBox joblog
Parent=JobCol
Height=110
Background=#0F172A
Foreground=#86EFAC
FontFamily=monospace

@ListBox library
Parent=Main
FontFamily=monospace
SelectionChanged=Selected

@Script Load
Interpreter=lua
<<LUA
local function run(cmd)
    return (Vml("Shell", cmd):gsub("%s+$", ""))        -- trim trailing whitespace/newlines
end

-- every path No-Stick uses lives here, as absolute paths (so they are safe inside quotes)
NS_HOME = run('echo "$HOME"')
NS_DIR  = NS_HOME .. "/.no-stick"
NS_VHDS = NS_DIR .. "/vhds"
NS_ISOS = NS_DIR .. "/isos"
run("mkdir -p '" .. NS_VHDS .. "' '" .. NS_ISOS .. "'")

-- boot-menu settings: which entry is the default, and the auto-boot timer (0 = wait for a choice)
NS_DEFAULT = run("sed -n 's/^default=//p' '" .. NS_DIR .. "/menu.conf' 2>/dev/null | head -1")
NS_TIMEOUT = tonumber(run("sed -n 's/^timeout=//p' '" .. NS_DIR .. "/menu.conf' 2>/dev/null | head -1")) or 0

-- Root steps: a terminal user with sudo already unlocked keeps using it; everyone else (anyone who
-- started No-Stick from the app menu) gets the desktop's own password dialog via pkexec.
NS_ASROOT = 'as_root() { if sudo -n true 2>/dev/null; then sudo "$@"; ' ..
            'elif command -v pkexec >/dev/null 2>&1; then pkexec "$@"; else sudo "$@"; fi; }\n'

function ns_save_conf()
    Vml("Shell", "printf 'default=%s\\ntimeout=%s\\n' '" .. (NS_DEFAULT or "") .. "' '" ..
        (NS_TIMEOUT or 0) .. "' > '" .. NS_DIR .. "/menu.conf'")
end

-- start a boot-menu job. mode: "menu" (just rewrite the menu), "prepare" (a VHD), "iso" (a live entry)
function ns_job(t)
    Vml("SetSetting", "ns_job_title", t.title or "Updating the boot menu")
    Vml("SetSetting", "ns_job_name", t.name or "")
    Vml("SetSetting", "ns_job_file", t.file or "")
    Vml("SetSetting", "ns_job_id", t.id or "")
    Vml("SetSetting", "ns_job_mode", t.mode or "menu")
    Vml("SetSetting", "ns_job_pre", t.pre or "")
    Vml("SetSetting", "ns_job_reboot", t.reboot and "1" or "0")
    Vml("RunScript", "StartPrepare")
end

Vml("SetProperty", "btnTimeout", "Content",
    "Auto-boot: " .. ((NS_TIMEOUT > 0) and (NS_TIMEOUT .. "s") or "off"))

-- No-Stick needs a Visualised runtime new enough to have RunProcess (0.17+)
local ver = Vml("VmlVersion")
local function too_old(v)
    local maj, min = v:match("^(%d+)%.(%d+)")
    maj, min = tonumber(maj) or 0, tonumber(min) or 0
    return maj == 0 and min < 17
end
if ver == "" or too_old(ver) then
    Vml("ErrorDialog", "No-Stick needs Visualised 0.17 or newer (this is " ..
        (ver == "" and "older" or ver) .. ").\n\nPlease update Visualised, then reopen No-Stick.\n\nhttps://visualised.io", "Update needed")
    Vml("SetStatusText", "Needs Visualised 0.17+ - please update")
    Vml("SetProperty", "library", "Items", "(this Visualised runtime is too old - please update)")
    for _, b in ipairs({"btnDownload", "btnAddIso", "btnNewVhd", "btnTryLive", "btnInstallVhd",
                        "btnInstallPart", "btnBootNow", "btnBootRestart", "btnDelete",
                        "chkInMenu", "chkDefault", "btnTimeout"}) do
        Vml("SetProperty", b, "IsEnabled", "false")
    end
    return
end

-- read the No-Stick library on this machine and list it. Reads only; changes nothing.
local keep = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
LIBRARY = {}

local function human(path)                             -- real disk usage, e.g. "3.1G" (empty if missing)
    return run("du -h '" .. path .. "' 2>/dev/null | head -1 | cut -f1"):gsub("[^%w%.]", "")
end

-- "on" = entry file present (in the menu), "off" = prepared but hidden, "" = never prepared
local function menu_state(side)
    return run("if [ -f '" .. side .. "' ]; then echo on; elif [ -f '" .. side .. ".off' ]; then echo off; fi")
end

-- VHDs: every .img in the vhds folder
local imgs = run("ls -1 '" .. NS_VHDS .. "'/*.img 2>/dev/null")
for path in (imgs .. "\n"):gmatch("([^\n]+)") do
    local name = path:match("([^/]+)%.img$")
    if name then
        local bytes = tonumber(run("stat -c %s '" .. path .. "' 2>/dev/null")) or 0
        local gb = math.floor(bytes / 1073741824 + 0.5)
        local used = human(path)
        local side = NS_VHDS .. "/" .. name .. ".grub"
        local st = menu_state(side)
        LIBRARY[#LIBRARY + 1] = {kind = "VHD", name = name, file = path, side = side, id = "nostick-" .. name,
            inmenu = (st == "on"), prepared = (st ~= ""), bootable = (st == "on"),
            detail = gb .. "GB disk" .. (used ~= "" and ("  -  " .. used .. " used") or "")}
    end
end

-- ISOs in the library folder
local isos = run("ls -1 '" .. NS_ISOS .. "'/*.iso 2>/dev/null")
for path in (isos .. "\n"):gmatch("([^\n]+)") do
    if path ~= "" then
        local base = path:match("([^/]+)$")
        local side = path .. ".grub"
        local st = menu_state(side)
        local id = "nostick-iso-" .. ((base:gsub("%.iso$", "")):gsub("[^%w%._%-]", "-"))
        LIBRARY[#LIBRARY + 1] = {kind = "ISO", name = base, file = path, side = side, id = id,
            inmenu = (st == "on"), prepared = (st ~= ""), detail = human(path)}
    end
end

local lines = {}
for i, item in ipairs(LIBRARY) do
    local mark = "[ ]"
    if item.inmenu then mark = (item.id == NS_DEFAULT) and "[D]" or "[x]" end
    lines[i] = string.format("%s %s  %-28s  %s", mark, item.kind, item.name, (item.detail:gsub(",", ";")))
end
if #lines == 0 then
    lines = {"(nothing yet - add an ISO or create a VHD to begin)"}
end
Vml("SetProperty", "library", "Items", table.concat(lines, ","))
Vml("SetStatusText", #LIBRARY .. " item(s)    [x] in the boot menu    [D] the default")
if keep >= 0 and keep < #LIBRARY then
    Vml("SetProperty", "library", "SelectedIndex", tostring(keep))   -- re-select what was selected
end
Vml("RunScript", "Selected")
LUA

@Script Selected
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
local isVhd = item and item.kind == "VHD"
local isIso = item and item.kind == "ISO"
for _, b in ipairs({"btnTryLive", "btnInstallVhd", "btnInstallPart"}) do
    Vml("SetProperty", b, "IsEnabled", isIso and "true" or "false")
end
for _, b in ipairs({"btnBootNow", "btnBootRestart", "btnBackup"}) do
    Vml("SetProperty", b, "IsEnabled", isVhd and "true" or "false")
end
Vml("SetProperty", "btnRestore", "IsEnabled", "true")   -- restore can make a new VHD any time
Vml("SetProperty", "btnDelete", "IsEnabled", item and "true" or "false")
Vml("SetProperty", "btnRepair", "IsEnabled", item and "true" or "false")
-- the two boot-menu ticks always show the real state of the selected item
local inmenu = item and item.inmenu
Vml("SetProperty", "chkInMenu", "IsEnabled", item and "true" or "false")
Vml("SetProperty", "chkInMenu", "IsChecked", inmenu and "true" or "false")
Vml("SetProperty", "chkDefault", "IsEnabled", inmenu and "true" or "false")
Vml("SetProperty", "chkDefault", "IsChecked", (inmenu and item.id == NS_DEFAULT) and "true" or "false")
if item then Vml("SetStatusText", item.kind .. ":  " .. item.file) end
LUA

@Script Download
Interpreter=lua
<<LUA
-- the pretty front door: browse the catalogue; it hands back a url + filename to fetch
Vml("SetSetting", "nostick_dl_url", "")
Vml("FormOpenModal", "download.vml")
local url = Vml("GetSetting", "nostick_dl_url")
local name = Vml("GetSetting", "nostick_dl_name")
if url == "" then return end
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", "Downloading " .. name)
Vml("SetProperty", "joblog", "Items", "")
-- curl with a progress line every second into the log; lands in the ISO library
local cmd = "mkdir -p '" .. NS_ISOS .. "'\n" ..
    "cd '" .. NS_ISOS .. "'\n" ..
    "echo 'Fetching " .. name .. "...'\n" ..
    "curl -fL --progress-bar -o '" .. name .. ".part' '" .. url .. "' 2>&1 | stdbuf -oL tr '\\r' '\\n' | grep -v '^$'\n" ..
    "mv '" .. name .. ".part' '" .. name .. "'\n" ..
    "echo 'Downloaded.'\n"
CURRENT_JOB = Vml("RunProcess", cmd, "joblog", "DownloadDone", "bash")
LUA

@Script DownloadDone
Interpreter=lua
<<LUA
Vml("SetProperty", "JobBar", "IsVisible", "false")
if Vml("GetSetting", "exit_code") == "0" then
    Vml("SetStatusText", "Download complete")
else
    Vml("ErrorDialog", "Download failed or was cancelled. See the log.", "Download")
end
Vml("RunScript", "Load")
LUA

@Script AddIso
Interpreter=lua
<<LUA
-- The library always owns its ISOs, so tidying up Downloads can never remove one.
-- Same partition: a hard link (instant, no extra space, survives the original being deleted).
-- Different partition: a real copy.
local path = Vml("FileOpenDialog", "Choose an ISO you've already downloaded", "iso")
if path == "" then return end
local base = path:match("([^/]+)$")
local dest = NS_ISOS .. "/" .. base
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", "Adding " .. base)
Vml("SetProperty", "joblog", "Items", "")
local cmd = "set -e\n" ..
    "mkdir -p '" .. NS_ISOS .. "'\n" ..
    "if ln '" .. path .. "' '" .. dest .. "' 2>/dev/null; then\n" ..
    "    echo 'Added instantly (shares disk space with the original; deleting the original will not remove it).'\n" ..
    "else\n" ..
    "    echo 'Copying into the library...'\n" ..
    "    cp -v '" .. path .. "' '" .. dest .. "'\n" ..
    "    echo 'Copied.'\n" ..
    "fi\n"
CURRENT_JOB = Vml("RunProcess", cmd, "joblog", "AddIsoDone", "bash")
LUA

@Script AddIsoDone
Interpreter=lua
<<LUA
Vml("SetProperty", "JobBar", "IsVisible", "false")
if Vml("GetSetting", "exit_code") == "0" then
    Vml("SetStatusText", "Added to your library")
else
    Vml("ErrorDialog", "Couldn't add that ISO. See the log.", "Add ISO")
end
Vml("RunScript", "Load")
LUA

@Script NewVhd
Interpreter=lua
<<LUA
local name = Vml("PromptDialog", "New VHD", "Name for the virtual disk (letters, numbers, dashes):", "")
name = name:gsub("%s+", ""):gsub("[^%w%-_]", "")
if name == "" then return end
local file = NS_VHDS .. "/" .. name .. ".img"
if Vml("Shell", "test -f '" .. file .. "' && echo yes") ~= "" then
    return Vml("ErrorDialog", "A VHD called '" .. name .. "' already exists.", "New VHD")
end
local size = Vml("PromptDialog", "New VHD", "Size in GB (the file only uses what's written):", "30")
size = tonumber(size)
if not size or size < 1 then return end
NEW_VHD_NAME = name
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", "Creating VHD: " .. name .. " (" .. size .. "GB)")
Vml("SetProperty", "joblog", "Items", "")
-- sparse file: instant, uses no space until written. The installer partitions it itself.
local cmd = "set -e\n" ..
    "mkdir -p '" .. NS_VHDS .. "'\n" ..
    "echo 'Allocating " .. size .. "GB sparse disk...'\n" ..
    "truncate -s " .. size .. "G '" .. file .. "'\n" ..
    "echo 'Done.'\n"
CURRENT_JOB = Vml("RunProcess", cmd, "joblog", "NewVhdDone", "bash")
Vml("SetProperty", "btnJobCancel", "IsEnabled", "true")
LUA

@Script NewVhdDone
Interpreter=lua
<<LUA
local code = Vml("GetSetting", "exit_code")
if code == "0" then
    Vml("SetStatusText", "Created VHD: " .. NEW_VHD_NAME)
else
    Vml("ErrorDialog", "VHD creation failed (exit " .. code .. "). See the log.", "New VHD")
end
Vml("SetProperty", "JobBar", "IsVisible", "false")
Vml("RunScript", "Load")
LUA

@Script JobCancel
Interpreter=lua
<<LUA
if CURRENT_JOB then Vml("CancelProcess", CURRENT_JOB) end
Vml("SetProperty", "JobBar", "IsVisible", "false")
Vml("SetStatusText", "Cancelled")
LUA

@Script TryLive
Interpreter=lua
<<LUA
-- boot the selected ISO live at the next restart: nothing is installed, the ISO is not changed
Vml("RunScript", "BootRestart")
LUA

@Script InstallVhd
Interpreter=lua
<<LUA
-- the selected ISO installs into a VHD. Guided = the distro's own installer in a quick VM (safe:
-- it only ever sees the VHD, never your real disks). The VHD then boots on real hardware.
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local iso = LIBRARY and LIBRARY[i + 1]
if not iso or iso.kind ~= "ISO" then return end

if Vml("Shell", "command -v qemu-system-x86_64 >/dev/null 2>&1 && echo ok") ~= "ok" then
    if Vml("ConfirmDialog", "Guided install needs QEMU (a quick VM used only to run the installer).\n\n" ..
           "Install it now? (sudo apt install qemu-system-x86 qemu-utils)", "Install to a VHD") ~= "true" then return end
    Vml("SetProperty", "JobBar", "IsVisible", "true")
    Vml("SetProperty", "jobTitle", "Text", "Installing QEMU")
    Vml("SetProperty", "joblog", "Items", "")
    CURRENT_JOB = Vml("RunProcess", NS_ASROOT .. "as_root apt-get install -y qemu-system-x86 qemu-utils < /dev/null",
                      "joblog", "QemuInstalled", "bash")
    return
end
Vml("RunScript", "DoGuidedInstall")
LUA

@Script QemuInstalled
Interpreter=lua
<<LUA
Vml("SetProperty", "JobBar", "IsVisible", "false")
if Vml("GetSetting", "exit_code") == "0" then
    Vml("RunScript", "DoGuidedInstall")
else
    Vml("ErrorDialog", "Couldn't install QEMU. See the log.", "Install to a VHD")
end
LUA

@Script DoGuidedInstall
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local iso = LIBRARY and LIBRARY[i + 1]
if not iso then return end
-- choose a VHD to install into: an existing one, or make a new one
local vhds = {}
for _, it in ipairs(LIBRARY) do if it.kind == "VHD" then vhds[#vhds + 1] = it.name end end
local target = Vml("PromptDialog", "Install " .. iso.name,
    "Install into which VHD? Type an existing name, or a new name to create one:\n\nExisting: " ..
    (table.concat(vhds, ", ") == "" and "(none yet)" or table.concat(vhds, ", ")), "")
target = target:gsub("%s+", ""):gsub("[^%w%-_]", "")
if target == "" then return end
local vhdfile = NS_VHDS .. "/" .. target .. ".img"
-- never install over an existing disk without saying so
for _, it in ipairs(LIBRARY) do
    if it.kind == "VHD" and it.name == target then
        if Vml("ConfirmDialog", "'" .. target .. "' already exists (" .. it.detail .. ").\n\n" ..
               "Installing into it ERASES whatever is on it now.\n\nCarry on and overwrite it?", "Overwrite " .. target .. "?") ~= "true" then
            return
        end
    end
end
-- make it if it doesn't exist (sparse)
if Vml("Shell", "test -f '" .. vhdfile .. "' && echo yes") ~= "yes" then
    local gb = Vml("PromptDialog", "New VHD", "'" .. target .. "' doesn't exist yet. Size in GB:", "30")
    gb = tonumber(gb)
    if not gb then return end
    Vml("Shell", "mkdir -p '" .. NS_VHDS .. "' && truncate -s " .. gb .. "G '" .. vhdfile .. "'")
end
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", "Guided install: " .. iso.name .. " -> " .. target .. "  (installer opens in a window)")
Vml("SetProperty", "joblog", "Items", "")
Vml("SetSetting", "ns_install_vhd", target)
-- boot the ISO in a VM with the VHD as its only disk; KVM if available
local accel = Vml("Shell", "test -e /dev/kvm && echo '-enable-kvm' || echo ''")
local cmd = "echo 'Starting the installer in a VM. Install to the disk it shows (that is your VHD),'\n" ..
    "echo 'then shut down or close the window when the install finishes.'\n" ..
    "qemu-system-x86_64 " .. accel .. " -m 4096 -smp 2 " ..
    "-drive file='" .. iso.file .. "',media=cdrom " ..
    "-drive file='" .. vhdfile .. "',format=raw,if=virtio " ..
    "-boot d -vga virtio 2>&1\n" ..
    "echo 'Installer VM closed.'\n"
CURRENT_JOB = Vml("RunProcess", cmd, "joblog", "GuidedInstallDone", "bash")
LUA

@Script GuidedInstallDone
Interpreter=lua
<<LUA
-- the installer VM has closed: prepare the VHD for real hardware and add it to the boot menu
local target = Vml("GetSetting", "ns_install_vhd")
if Vml("GetSetting", "exit_code") == "0" then
    ns_job{title = "Preparing " .. target, name = target, file = NS_VHDS .. "/" .. target .. ".img",
           id = "nostick-" .. target, mode = "prepare"}
else
    Vml("SetProperty", "JobBar", "IsVisible", "false")
    Vml("ErrorDialog", "The installer VM reported a problem. See the log.", "Install to a VHD")
    Vml("RunScript", "Load")
end
LUA

@Script InstallPartition
Interpreter=lua
<<LUA
-- advanced: make room (reuse swap, or shrink a partition) and install to a new partition
Vml("ConfirmDialog", "Installing to a partition changes your real disk and can leave your PC unbootable if interrupted.\n\nHave a recovery USB ready before you do this.\n\n(Coming soon - not yet enabled.)", "Advanced: install to a partition")
Vml("SetStatusText", "Install to a partition: coming later (advanced)")
LUA

@Script BackupVhd
Interpreter=lua
<<LUA
-- backs up only the FILES inside the VHD (not the empty space), so it's small and portable
Vml("SetStatusText", "Back up (files only, not the whole disk): coming next")
LUA

@Script RestoreVhd
Interpreter=lua
<<LUA
-- unpacks a backup into a fresh VHD (can be a different size)
Vml("SetStatusText", "Restore into a new VHD: coming next")
LUA

@Script BootNow
Interpreter=lua
<<LUA
-- restart straight into the selected VHD, skipping the firmware and the boot menu (kexec).
-- Experimental: it is fast, but it skips the hardware reset a normal restart does.
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item or item.kind ~= "VHD" then return end
if not item.prepared then
    return Vml("InfoDialog", "'" .. item.name .. "' hasn't been set up for booting yet.\n\n" ..
        "Tick 'Show in boot menu' first, then try again.", "Boot now")
end
if Vml("Shell", "command -v kexec >/dev/null 2>&1 || [ -x /usr/sbin/kexec ] || [ -x /sbin/kexec ]; echo $?"):gsub("%s+", "") ~= "0" then
    if Vml("ConfirmDialog", "Boot now needs a small system tool called kexec.\n\nInstall it now? (kexec-tools)", "Boot now") ~= "true" then return end
    Vml("SetProperty", "JobBar", "IsVisible", "true")
    Vml("SetProperty", "jobTitle", "Text", "Installing kexec-tools - click Boot now again when it finishes")
    Vml("SetProperty", "joblog", "Items", "")
    CURRENT_JOB = Vml("RunProcess", NS_ASROOT .. "as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y kexec-tools < /dev/null",
                      "joblog", "KexecInstalled", "bash")
    return
end
if Vml("ConfirmDialog", "Restart straight into '" .. item.name .. "' now?\n\n" ..
       "SAVE YOUR WORK FIRST: this closes everything and restarts within seconds.\n\n" ..
       "This is the experimental fast route. If the screen stays black afterwards, hold the power button " ..
       "and use 'Boot at restart' instead.", "Boot now") ~= "true" then return end
ns_job{title = "Restarting into " .. item.name, name = item.name, file = item.file, id = item.id, mode = "bootnow"}
LUA

@Script KexecInstalled
Interpreter=lua
<<LUA
if Vml("GetSetting", "exit_code") == "0" then
    Vml("SetProperty", "JobBar", "IsVisible", "false")
    Vml("SetStatusText", "kexec is installed - click Boot now again")
else
    Vml("SetProperty", "jobTitle", "Text", "Couldn't install kexec-tools - see the log below (Cancel closes this)")
end
LUA

@Script BootRestart
Interpreter=lua
<<LUA
-- boot the selected VHD (or ISO, live) at the next restart, once. Adds it to the boot menu first if needed.
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item then return end
local mode, pre = "menu", ""
if not item.inmenu then
    if item.prepared then
        pre = "mv -f '" .. item.side .. ".off' '" .. item.side .. "'"
    else
        mode = (item.kind == "VHD") and "prepare" or "iso"
    end
end
local msg = "Boot '" .. item.name .. "'" .. (item.kind == "ISO" and " live" or "") .. " at the next restart?\n\n" ..
    "It boots by itself after a 3 second pause, this once. Restarts after that go back to normal.\n" ..
    "Your normal boot entries are not touched."
if mode == "prepare" then
    msg = msg .. "\n\nIt isn't in the boot menu yet, so No-Stick will first look inside it and add the small boot helper it needs (a minute or two)."
end
if Vml("ConfirmDialog", msg, "Boot at restart") ~= "true" then return end
ns_job{title = "Setting up the next restart: " .. item.name, name = item.name, file = item.file,
       id = item.id, mode = mode, pre = pre, reboot = true}
LUA

@Script StartPrepare
Interpreter=lua
<<LUA
-- runs the root helper: [prepare the image / ISO] -> rewrite the No-Stick menu -> [point next restart at it]
-- driven by the ns_job_* settings (see ns_job in Load)
local title  = Vml("GetSetting", "ns_job_title")
local name   = Vml("GetSetting", "ns_job_name")
local file   = Vml("GetSetting", "ns_job_file")
local id     = Vml("GetSetting", "ns_job_id")
local mode   = Vml("GetSetting", "ns_job_mode")
local pre    = Vml("GetSetting", "ns_job_pre")
local reboot = Vml("GetSetting", "ns_job_reboot") == "1"
Vml("SetProperty", "JobBar", "IsVisible", "true")
Vml("SetProperty", "jobTitle", "Text", title)
Vml("SetProperty", "joblog", "Items", "")
-- everything that needs root goes into ONE small script, so there is one password prompt, not three
local steps = "set -e\n"
if mode == "prepare" then
    steps = steps .. "bash \"$T\" prepare '" .. file .. "' '" .. name .. "' \"$ME\"\n"
elseif mode == "iso" then
    steps = steps .. "bash \"$T\" iso '" .. file .. "' '" .. id .. "' \"$ME\"\n"
end
if mode == "bootnow" then
    steps = steps .. "bash \"$T\" bootnow '" .. file .. "'\n"
else
    steps = steps .. "bash \"$T\" menu '" .. NS_DIR .. "'\n"
end
if reboot then
    steps = steps .. "bash \"$T\" bootnext '" .. id .. "'\n"
end
local cmd = "set -e\n" .. NS_ASROOT ..
    "T=$(mktemp)\nR=$(mktemp)\nME=$(id -un)\n" ..
    "trap 'rm -f \"$T\" \"$R\"' EXIT\n" ..
    "cat > \"$T\" << 'NSROOT'\n" .. Vml("RunScript", "RootScript") .. "\nNSROOT\n" ..
    (pre ~= "" and (pre .. "\n") or "") ..
    "cat > \"$R\" << NSRUN\n" .. steps .. "NSRUN\n" ..
    "as_root bash \"$R\" < /dev/null\n" ..
    "echo 'Done.'\n"
CURRENT_JOB = Vml("RunProcess", cmd, "joblog", "PrepareDone", "bash")
LUA

@Script PrepareDone
Interpreter=lua
<<LUA
local name = Vml("GetSetting", "ns_job_name")
local reboot = Vml("GetSetting", "ns_job_reboot") == "1"
if Vml("GetSetting", "exit_code") == "0" then
    Vml("SetProperty", "JobBar", "IsVisible", "false")
    if reboot then
        Vml("InfoDialog", "Restart when you're ready.\n\nThe next restart boots '" .. name ..
            "' by itself after a 3 second pause. Restarts after that go back to normal.", "Boot at restart")
        Vml("SetStatusText", "Next restart boots " .. name)
    else
        Vml("SetStatusText", "Boot menu updated")
    end
else
    -- leave the log on screen so the reason can be read; Cancel closes it
    Vml("SetProperty", "jobTitle", "Text", "Failed - the reason is in the log below (Cancel closes this)")
    Vml("ErrorDialog", "Couldn't finish that. The log at the bottom of the window says why.\n\nYour normal boot entries are unchanged.", "No-Stick")
end
Vml("RunScript", "Load")
LUA

@Script ToggleMenu
Interpreter=lua
<<LUA
-- the "Show in boot menu" tick. On: prepare if needed, then add. Off: hide (stays prepared, so on again is instant).
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item then return end
if item.inmenu then
    if item.id == NS_DEFAULT then NS_DEFAULT = ""; ns_save_conf() end
    ns_job{title = "Removing " .. item.name .. " from the boot menu", name = item.name,
           pre = "mv -f '" .. item.side .. "' '" .. item.side .. ".off'"}
elseif item.prepared then
    ns_job{title = "Adding " .. item.name .. " to the boot menu", name = item.name,
           pre = "mv -f '" .. item.side .. ".off' '" .. item.side .. "'"}
else
    local what = (item.kind == "VHD")
        and "No-Stick will look inside it, add the small boot helper it needs, and add it to the No-Stick menu. This takes a minute or two."
        or  "No-Stick will add a live-boot entry for this ISO. The ISO itself is not changed."
    if Vml("ConfirmDialog", "Add '" .. item.name .. "' to the boot menu?\n\n" .. what ..
           "\n\nYour normal boot entries are not touched.", "Boot menu") ~= "true" then
        return Vml("RunScript", "Selected")              -- put the tick back how it was
    end
    ns_job{title = "Adding " .. item.name .. " to the boot menu", name = item.name, file = item.file,
           id = item.id, mode = (item.kind == "VHD") and "prepare" or "iso"}
end
LUA

@Script RepairBoot
Interpreter=lua
<<LUA
-- look inside the selected item again and rebuild its boot helper and menu entry from scratch.
-- Use after a No-Stick update, or when something that used to boot no longer does.
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item then return end
if Vml("ConfirmDialog", "Rebuild the boot setup for '" .. item.name .. "'?\n\nNothing inside it is deleted. " ..
       "It ends up shown in the boot menu.", "Repair boot") ~= "true" then return end
ns_job{title = "Repairing boot for " .. item.name, name = item.name, file = item.file, id = item.id,
       mode = (item.kind == "VHD") and "prepare" or "iso", pre = "rm -f '" .. item.side .. ".off'"}
LUA

@Script ToggleDefault
Interpreter=lua
<<LUA
-- the "Boot this by default" tick: the highlighted entry in the No-Stick menu, and the one the timer boots
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item or not item.inmenu then return Vml("RunScript", "Selected") end
if item.id == NS_DEFAULT then NS_DEFAULT = "" else NS_DEFAULT = item.id end
ns_save_conf()
ns_job{title = "Updating the boot menu", name = item.name}
LUA

@Script SetTimeout
Interpreter=lua
<<LUA
-- auto-boot timer for the No-Stick menu: after this many seconds the default entry boots by itself
local s = Vml("PromptDialog", "Auto-boot",
    "Seconds the No-Stick menu waits before booting the default by itself.\n0 = wait until I choose.", tostring(NS_TIMEOUT or 0))
local n = tonumber(s)
if not n or n < 0 then return end
NS_TIMEOUT = math.floor(n)
ns_save_conf()
if NS_TIMEOUT > 0 and (NS_DEFAULT or "") == "" then
    Vml("InfoDialog", "Saved. The timer starts working once you tick 'Boot this by default' on something - " ..
        "with no default, the menu always waits for you.", "Auto-boot")
end
ns_job{title = "Updating the boot menu", name = "boot menu"}
LUA

@Script RootScript
Interpreter=lua
<<LUA
-- Returns the root helper (bash). Run as:  sudo bash FILE prepare IMG NAME OWNER
--                                          sudo bash FILE iso ISOFILE ENTRY_ID OWNER
--                                          sudo bash FILE menu NOSTICK_DIR
--                                          sudo bash FILE bootnext [ENTRY_ID]
--                                          sudo bash FILE bootnow IMG
-- prepare: finds the installed system in the image, installs the boot hook for its initramfs family,
--          rebuilds the initramfs, and writes NAME.grub (the menu entry) beside the image.
-- iso:     looks inside the ISO, works out how its live system boots, and writes ISOFILE.grub.
-- menu:    rebuilds /boot/no-stick/grub.cfg from every .grub file (vhds and isos) plus menu.conf, and
--          makes sure the main GRUB menu has the single "No-Stick" entry.
-- bootnext: the next restart opens No-Stick and boots ENTRY_ID by itself, once.
-- bootnow: loads the image's kernel with kexec, using the same boot line as its menu entry, and restarts into it.
return [==[
set -eu
MODE="${1:-}"

ensure_main_entry() {
    if grep -qs 'no-stick/grub.cfg' /boot/grub/grub.cfg; then return 0; fi
    echo "Adding the single No-Stick entry to your main boot menu..."
    BM=$(findmnt -no TARGET -T /boot/no-stick)
    BU=$(findmnt -no UUID -T /boot/no-stick)
    CP=/boot/no-stick/grub.cfg
    if [ "$BM" != "/" ]; then CP="${CP#"$BM"}"; fi
    cat > /etc/grub.d/40_nostick << NSMAIN
#!/bin/sh
exec tail -n +3 "\$0"
# The single No-Stick entry. Everything else lives in /boot/no-stick/grub.cfg
menuentry "No-Stick" --class gnu-linux --id no-stick {
    search --no-floppy --fs-uuid --set=root $BU
    configfile $CP
}
NSMAIN
    chmod 755 /etc/grub.d/40_nostick
    update-grub 2>&1 || grub-mkconfig -o /boot/grub/grub.cfg 2>&1
}

do_menu() {
    DIR="$1"
    OUT=/boot/no-stick/grub.cfg
    mkdir -p /boot/no-stick
    DEF=""; TMO=""
    if [ -f "$DIR/menu.conf" ]; then
        DEF=$(sed -n 's/^default=//p' "$DIR/menu.conf" | head -1 | tr -cd 'A-Za-z0-9._-')
        TMO=$(sed -n 's/^timeout=//p' "$DIR/menu.conf" | head -1 | tr -cd '0-9')
    fi
    # the timer only runs when there is a default to boot; otherwise the menu waits
    if [ -z "$DEF" ] || [ -z "$TMO" ] || [ "$TMO" -le 0 ]; then TMO=-1; fi
    {
        echo "# No-Stick menu - generated from the .grub files in $DIR/vhds and $DIR/isos"
        echo "# Do not edit: it is rewritten whenever the library or its boot-menu ticks change."
        if [ -n "$DEF" ]; then echo "set default=\"$DEF\""; else echo "set default=0"; fi
        echo "set timeout=$TMO"
        echo '# "Boot at restart": boot one chosen entry by itself, once'
        echo 'if [ -n "${nostick_once}" ]; then'
        echo '    set default="${nostick_once}"'
        echo '    set timeout=3'
        echo '    set nostick_once='
        echo '    save_env nostick_once'
        echo 'fi'
        echo
        for s in "$DIR"/vhds/*.grub "$DIR"/isos/*.grub; do
            [ -f "$s" ] || continue
            [ -f "${s%.grub}.img" ] || [ -f "${s%.grub}" ] || continue
            cat "$s"
            echo
        done
        echo 'menuentry "<- Back to main menu" {'
        echo '    configfile $prefix/grub.cfg'
        echo '}'
    } > "$OUT"
    N=$(grep -c '^menuentry' "$OUT")
    echo "No-Stick menu written: $((N - 1)) entr$( [ "$N" -eq 2 ] && echo y || echo ies )."
    ensure_main_entry
}

do_bootnext() {
    ID=$(printf '%s' "${1:-}" | tr -cd 'A-Za-z0-9._-')
    if ! command -v grub-reboot >/dev/null 2>&1; then
        echo "(grub-reboot not found: choose No-Stick from the boot menu yourself)"; return 0
    fi
    if [ -n "$ID" ] && command -v grub-editenv >/dev/null 2>&1; then
        grub-editenv /boot/grub/grubenv set "nostick_once=$ID"
    fi
    grub-reboot no-stick
    echo "The next restart will open No-Stick${ID:+ and boot $ID}."
}

do_bootnow() {
    IMG="$1"
    SIDE="${IMG%.img}.grub"
    [ -f "$SIDE" ] || SIDE="$SIDE.off"
    [ -f "$SIDE" ] || { echo "No boot setup found for this disk - tick 'Show in boot menu' first."; exit 2; }
    KEXEC=$(command -v kexec || true)
    [ -n "$KEXEC" ] || { echo "kexec is not installed."; exit 2; }

    # the menu entry is the single source of truth: same partition, kernel, initrd and boot line
    LLINE=$(grep -m1 -E '^ *linux \(vhd,[a-z]+[0-9]+\)' "$SIDE" || true)
    ILINE=$(grep -m1 -E '^ *initrd \(vhd,[a-z]+[0-9]+\)' "$SIDE" || true)
    if [ -z "$LLINE" ] || [ -z "$ILINE" ]; then
        echo "This disk's menu entry is the older kind. Click 'Repair boot' once, then try again."; exit 2
    fi
    PART=$(printf '%s\n' "$LLINE" | sed -E 's/^ *linux \(vhd,[a-z]+([0-9]+)\).*/\1/')
    KPATH=$(printf '%s\n' "$LLINE" | sed -E 's/^ *linux \(vhd,[a-z]+[0-9]+\)([^ ]+).*/\1/')
    CMDLINE=$(printf '%s\n' "$LLINE" | sed -E 's/^ *linux \(vhd,[a-z]+[0-9]+\)[^ ]+ *//')
    IPART=$(printf '%s\n' "$ILINE" | sed -E 's/^ *initrd \(vhd,[a-z]+([0-9]+)\).*/\1/')
    IPATH=$(printf '%s\n' "$ILINE" | sed -E 's/^ *initrd \(vhd,[a-z]+[0-9]+\)([^ ]+).*/\1/')
    [ "$PART" = "$IPART" ] || { echo "Kernel and initrd are on different partitions - not supported by Boot now yet."; exit 2; }

    M=$(mktemp -d /tmp/nostick.XXXXXX)
    LOOP=$(losetup --find --show --partscan --read-only "$IMG")
    sleep 1
    cleanup() { umount "$M" 2>/dev/null || true; losetup -d "$LOOP" 2>/dev/null || true; rmdir "$M" 2>/dev/null || true; }
    trap cleanup EXIT
    mount -o ro,noload "${LOOP}p${PART}" "$M" 2>/dev/null || mount -o ro "${LOOP}p${PART}" "$M"
    [ -e "$M$KPATH" ] && [ -e "$M$IPATH" ] || { echo "Kernel or initrd not found inside the disk."; exit 2; }
    echo "Loading $(readlink -f "$M$KPATH" | sed "s|^$M||")"
    echo "Boot line: $CMDLINE"
    # -s uses the signed-kernel route (needed with Secure Boot); fall back to the classic one
    "$KEXEC" -s -l "$M$KPATH" --initrd="$M$IPATH" --command-line="$CMDLINE" 2>/dev/null \
        || "$KEXEC" -l "$M$KPATH" --initrd="$M$IPATH" --command-line="$CMDLINE" \
        || { echo "kexec could not load this kernel on this PC. Use 'Boot at restart' instead."; exit 2; }
    cleanup
    trap - EXIT
    echo "Restarting into it now..."
    systemctl kexec
}

do_iso() {
    ISO="$1"; ID=$(printf '%s' "$2" | tr -cd 'A-Za-z0-9._-'); OWNER="$3"
    SIDE="$ISO.grub"
    [ -f "$ISO" ] || { echo "ISO not found: $ISO"; exit 2; }
    HOSTUUID=$(findmnt -no UUID -T "$ISO")
    HOSTMNT=$(findmnt -no TARGET -T "$ISO")
    if [ "$HOSTMNT" = "/" ]; then REL="$ISO"; else REL="${ISO#"$HOSTMNT"}"; fi
    TITLE=$(basename "$ISO" .iso | tr -cd 'A-Za-z0-9 ._()-')

    M=$(mktemp -d /tmp/nostick.XXXXXX)
    cleanup() { umount "$M" 2>/dev/null || true; rmdir "$M" 2>/dev/null || true; }
    trap cleanup EXIT
    mount -o loop,ro "$ISO" "$M"

    K=""; I=""
    if [ -f "$M/casper/vmlinuz" ]; then
        # Ubuntu, Mint and relatives
        K=/casper/vmlinuz
        for c in initrd initrd.lz initrd.gz initrd.img; do
            if [ -z "$I" ] && [ -f "$M/casper/$c" ]; then I="/casper/$c"; fi
        done
        ARGS="boot=casper iso-scan/filename=$REL noprompt noeject ---"
        KIND="Ubuntu/Mint live"
    elif ls "$M"/live/vmlinuz* >/dev/null 2>&1; then
        # Debian live
        kf=$(ls "$M"/live/vmlinuz* | head -1); inf=$(ls "$M"/live/initrd* 2>/dev/null | head -1)
        K="/live/${kf##*/}"; [ -n "$inf" ] && I="/live/${inf##*/}"
        ARGS="boot=live components findiso=$REL"
        KIND="Debian live"
    elif [ -f "$M/arch/boot/x86_64/vmlinuz-linux" ]; then
        K=/arch/boot/x86_64/vmlinuz-linux
        [ -f "$M/arch/boot/x86_64/initramfs-linux.img" ] && I=/arch/boot/x86_64/initramfs-linux.img
        ARGS="archisobasedir=arch img_dev=/dev/disk/by-uuid/$HOSTUUID img_loop=$REL earlymodules=loop"
        KIND="Arch live"
    fi
    if [ -z "$K" ] || [ -z "$I" ]; then
        echo "No-Stick doesn't know how to live-boot this ISO yet (supported: Ubuntu, Mint, Debian live, Arch)."; exit 4
    fi

    cat > "$SIDE" << NSENTRY
menuentry "Live: $TITLE" --id "$ID" {
    insmod part_gpt
    insmod part_msdos
    insmod ext2
    insmod iso9660
    insmod loopback
    search --no-floppy --fs-uuid --set=isohost $HOSTUUID
    loopback iso (\$isohost)$REL
    linux (iso)$K $ARGS
    initrd (iso)$I
}
NSENTRY
    chown "$OWNER": "$SIDE"
    echo "$TITLE: $KIND entry written."
}

do_prepare() {
    IMG="$1"; NAME="$2"; OWNER="$3"
    SIDE="${IMG%.img}.grub"
    [ -f "$IMG" ] || { echo "Image not found: $IMG"; exit 2; }

    # where the image lives, as GRUB and the initramfs will see it
    HOSTFS=$(findmnt -no FSTYPE -T "$IMG")
    HOSTUUID=$(findmnt -no UUID -T "$IMG")
    HOSTMNT=$(findmnt -no TARGET -T "$IMG")
    if [ "$HOSTFS" != "ext4" ]; then
        echo "The image is on a $HOSTFS partition. Only ext4 is supported so far."; exit 5
    fi
    if [ "$HOSTMNT" = "/" ]; then REL="$IMG"; else REL="${IMG#"$HOSTMNT"}"; fi

    M=$(mktemp -d /tmp/nostick.XXXXXX)
    LOOP=$(losetup --find --show --partscan "$IMG")
    sleep 1
    cleanup() {
        umount -R "$M" 2>/dev/null || true
        losetup -d "$LOOP" 2>/dev/null || true
        rmdir "$M" 2>/dev/null || true
    }
    trap cleanup EXIT

    case "$(blkid -s PTTYPE -o value "$LOOP" 2>/dev/null || true)" in
        gpt) GP=gpt ;;
        dos) GP=msdos ;;
        *)   echo "No partition table in $NAME - has anything been installed into it yet?"; exit 3 ;;
    esac

    # the root partition is the one holding os-release
    echo "Looking for the installed system in $NAME..."
    ROOTP=""
    for p in "$LOOP"p*; do
        [ -b "$p" ] || continue
        [ "$(blkid -s TYPE -o value "$p" 2>/dev/null || true)" = "ext4" ] || continue
        if mount -o ro "$p" "$M" 2>/dev/null; then
            if [ -e "$M/etc/os-release" ]; then ROOTP="$p"; fi
            umount "$M"
        fi
        [ -n "$ROOTP" ] && break
    done
    if [ -z "$ROOTP" ]; then
        echo "No installed system found in $NAME (was the install finished? only ext4 root is supported so far)."; exit 3
    fi
    ROOTUUID=$(blkid -s UUID -o value "$ROOTP")
    mount "$ROOTP" "$M"
    PRETTY=$(sed -n 's/^PRETTY_NAME=//p' "$M/etc/os-release" | head -1 | tr -cd 'A-Za-z0-9 ._()/-')
    [ -n "$PRETTY" ] || PRETTY="Linux"
    echo "Found $PRETTY on partition ${ROOTP##*p}"

    # a separate /boot partition inside the image (Arch often puts /boot on the EFI partition)
    BOOTP="$ROOTP"
    BUUID=$(awk '$1 ~ /^UUID=/ && $2 == "/boot" { sub(/^UUID=/, "", $1); print $1 }' "$M/etc/fstab" 2>/dev/null | head -1)
    if [ -n "$BUUID" ]; then
        for p in "$LOOP"p*; do
            if [ "$(blkid -s UUID -o value "$p" 2>/dev/null || true)" = "$BUUID" ]; then
                BOOTP="$p"; mount "$p" "$M/boot"
            fi
        done
    fi

    for d in dev dev/pts proc sys run; do mount --bind "/$d" "$M/$d"; done

    if [ -d "$M/etc/initramfs-tools" ]; then
        FAMILY=initramfs-tools
        ARGS="ro noresume"
        echo "Boot system: initramfs-tools (Debian, Ubuntu, Mint). Installing the No-Stick hook..."
        cat > "$M/etc/initramfs-tools/hooks/nostick" << 'NSHOOKA'
#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
# Debian's initrd fills /usr/sbin with busybox applets, and its losetup shadows the real one,
# so the real losetup goes in under a path of its own.
copy_exec /usr/sbin/losetup /usr/lib/nostick/losetup
manual_add_modules loop ext4
NSHOOKA
        cat > "$M/etc/initramfs-tools/scripts/local-top/nostick" << 'NSHOOKB'
#!/bin/sh
# no-stick: attach a disk image file (with its partitions) before root is looked for
#   vhdhost=<fs UUID of host partition>  vhdfile=<path on that partition>
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /scripts/functions

VHD_FILE=""; VHD_HOST=""
for p in $(cat /proc/cmdline); do
    case "$p" in
        vhdfile=*) VHD_FILE="${p#vhdfile=}" ;;
        vhdhost=*) VHD_HOST="${p#vhdhost=}" ;;
    esac
done
[ -z "$VHD_FILE" ] && exit 0
[ -n "$VHD_HOST" ] || panic "nostick: vhdhost= is required"

modprobe -q loop max_part=15 || modprobe -q loop
modprobe -q ext4
i=0
while [ ! -e "/dev/disk/by-uuid/$VHD_HOST" ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
mkdir -p /run/nostick/host
mount -t ext4 -o rw "/dev/disk/by-uuid/$VHD_HOST" /run/nostick/host || panic "nostick: host mount failed ($VHD_HOST)"
REAL="/run/nostick/host${VHD_FILE}"
[ -f "$REAL" ] || panic "nostick: image not found at $REAL"
LOOP=""
if [ -x /usr/lib/nostick/losetup ]; then
    LOOP=$(/usr/lib/nostick/losetup --find --show --partscan "$REAL") || LOOP=""
fi
if [ -z "$LOOP" ]; then
    # busybox losetup: short options only, and it does not print the device
    LOOP=$(losetup -f) && losetup -P "$LOOP" "$REAL" || LOOP=""
fi
[ -n "$LOOP" ] || panic "nostick: could not attach $REAL"
echo "nostick: $VHD_FILE attached as $LOOP"
udevadm settle 2>/dev/null || true
exit 0
NSHOOKB
        chmod 755 "$M/etc/initramfs-tools/hooks/nostick" "$M/etc/initramfs-tools/scripts/local-top/nostick"
        echo "Rebuilding the initramfs (a minute or so)..."
        chroot "$M" update-initramfs -u -k all < /dev/null 2>&1

        # The distro's own /boot/vmlinuz link follows the LAST kernel installed, which is not always the
        # newest (an older-series update can arrive after a newer kernel). No-Stick boots through that
        # link, so keep it on the highest version that has an initrd - now, and after every kernel change.
        mkdir -p "$M/etc/kernel/postinst.d" "$M/etc/kernel/postrm.d"
        cat > "$M/etc/kernel/postinst.d/zz-nostick" << 'NSHOOKK'
#!/bin/sh
# no-stick: keep /boot/vmlinuz and /boot/initrd.img on the newest kernel that has an initrd
cd /boot || exit 0
v=""
for k in $(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | sort -V); do
    [ -e "initrd.img-$k" ] && v="$k"
done
[ -n "$v" ] || exit 0
ln -sfn "vmlinuz-$v" vmlinuz
ln -sfn "initrd.img-$v" initrd.img
exit 0
NSHOOKK
        chmod 755 "$M/etc/kernel/postinst.d/zz-nostick"
        cp -p "$M/etc/kernel/postinst.d/zz-nostick" "$M/etc/kernel/postrm.d/zz-nostick"
        chroot "$M" /bin/sh /etc/kernel/postinst.d/zz-nostick < /dev/null
        echo "Newest kernel in $NAME: $(readlink "$M/boot/vmlinuz" 2>/dev/null || echo unknown)"

    elif [ -f "$M/etc/mkinitcpio.conf" ]; then
        FAMILY=mkinitcpio
        ARGS="rw"
        echo "Boot system: mkinitcpio (Arch). Installing the No-Stick hook..."
        mkdir -p "$M/etc/initcpio/hooks" "$M/etc/initcpio/install"
        cat > "$M/etc/initcpio/hooks/nostickloop" << 'NSHOOKC'
#!/usr/bin/ash
# no-stick: attach a disk image file (with its partitions) before root is looked for
#   vhdhost=<fs UUID of host partition>  vhdfile=<path on that partition>
run_hook() {
    local f="" h="" i=0 p dev
    for p in $(cat /proc/cmdline); do
        case "$p" in
            vhdfile=*) f="${p#vhdfile=}" ;;
            vhdhost=*) h="${p#vhdhost=}" ;;
        esac
    done
    [ -z "$f" ] && return 0
    [ -n "$h" ] || { echo "nostick: vhdhost= is required"; return 1; }
    modprobe -q loop
    modprobe -q ext4
    while [ ! -e "/dev/disk/by-uuid/$h" ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done
    mkdir -p /run/nostick/host
    mount -t ext4 -o rw "/dev/disk/by-uuid/$h" /run/nostick/host || { echo "nostick: host mount failed ($h)"; return 1; }
    [ -f "/run/nostick/host$f" ] || { echo "nostick: image not found at /run/nostick/host$f"; return 1; }
    dev=$(losetup -f)
    losetup -P "$dev" "/run/nostick/host$f" || { echo "nostick: losetup failed"; return 1; }
    echo "nostick: $f attached as $dev"
    udevadm settle 2>/dev/null || true
}
NSHOOKC
        chmod 755 "$M/etc/initcpio/hooks/nostickloop"
        if [ ! -f "$M/etc/initcpio/install/nostickloop" ]; then
            cat > "$M/etc/initcpio/install/nostickloop" << 'NSHOOKD'
#!/bin/bash
build() {
    add_module loop
    add_module ext4
    add_binary losetup
    add_runscript
}
help() {
    echo "no-stick: boot from a disk image file on a host partition (vhdhost= vhdfile=)"
}
NSHOOKD
        fi
        if ! grep -q '^HOOKS=.*nostickloop' "$M/etc/mkinitcpio.conf"; then
            sed -i '/^HOOKS=/ s/ filesystems/ nostickloop filesystems/' "$M/etc/mkinitcpio.conf"
        fi
        echo "Rebuilding the initramfs (a minute or so)..."
        chroot "$M" mkinitcpio -P < /dev/null 2>&1 || echo "(mkinitcpio returned a warning status - usually just missing-firmware notes)"

    else
        echo "$PRETTY uses a boot system No-Stick doesn't support yet (Fedora-style dracut is on the list)."
        exit 4
    fi

    # find the kernel and initrd, preferring the 'latest' symlinks so kernel updates inside the image just work
    K=""; I=""
    if [ -e "$M/boot/vmlinuz" ] && [ -e "$M/boot/initrd.img" ]; then
        K=/boot/vmlinuz; I=/boot/initrd.img
    elif [ -e "$M/vmlinuz" ] && [ -e "$M/initrd.img" ]; then
        K=/vmlinuz; I=/initrd.img
    else
        kf=$(ls -v "$M"/boot/vmlinuz-* 2>/dev/null | tail -1)
        if [ -n "$kf" ]; then
            v="${kf##*/vmlinuz-}"
            for c in "initrd.img-$v" "initramfs-$v.img"; do
                if [ -e "$M/boot/$c" ]; then K="/boot/vmlinuz-$v"; I="/boot/$c"; fi
            done
        fi
    fi
    if [ -z "$K" ]; then echo "Couldn't find a kernel and initrd inside $NAME."; exit 6; fi

    # a path inside the installed system -> where GRUB finds it inside the image file
    gpath() {
        case "$1" in
            /boot/*)
                if [ "$BOOTP" != "$ROOTP" ]; then echo "(vhd,$GP${BOOTP##*p})${1#/boot}"; return 0; fi ;;
        esac
        echo "(vhd,$GP${ROOTP##*p})$1"
    }

    cat > "$SIDE" << NSENTRY
menuentry "$PRETTY ($NAME)" --id "nostick-$NAME" {
    insmod part_gpt
    insmod part_msdos
    insmod ext2
    insmod fat
    insmod loopback
    search --no-floppy --fs-uuid --set=vhdhost $HOSTUUID
    loopback vhd (\$vhdhost)$REL
    linux $(gpath "$K") root=UUID=$ROOTUUID $ARGS vhdhost=$HOSTUUID vhdfile=$REL
    initrd $(gpath "$I")
}
NSENTRY
    chown "$OWNER": "$SIDE"
    echo "$NAME prepared ($FAMILY). Kernel is read straight from the image: $(gpath "$K")"
}

case "$MODE" in
    prepare)  do_prepare "$2" "$3" "$4" ;;
    iso)      do_iso "$2" "$3" "$4" ;;
    menu)     do_menu "$2" ;;
    bootnext) do_bootnext "${2:-}" ;;
    bootnow)  do_bootnow "$2" ;;
    *)        echo "usage: prepare IMG NAME OWNER | iso FILE ID OWNER | menu DIR | bootnext [ID] | bootnow IMG"; exit 1 ;;
esac
]==]
LUA

@Script DeleteItem
Interpreter=lua
<<LUA
local i = tonumber(Vml("GetProperty", "library", "SelectedIndex")) or -1
local item = LIBRARY and LIBRARY[i + 1]
if not item then return end
if Vml("ConfirmDialog", "Delete " .. item.kind .. " '" .. item.name .. "'?\n\n" .. item.file ..
       "\n\nThis removes the file permanently.", "Delete") ~= "true" then return end
Vml("Shell", "rm -f '" .. item.file .. "' '" .. item.side .. "' '" .. item.side .. ".off'")
if item.id == NS_DEFAULT then NS_DEFAULT = ""; ns_save_conf() end
if item.inmenu then
    -- it was in the boot menu: rewrite the menu without it (this reloads the library when it finishes)
    return ns_job{title = "Removing " .. item.name .. " from the boot menu", name = item.name}
end
Vml("SetStatusText", "Deleted " .. item.name)
Vml("RunScript", "Load")
LUA
