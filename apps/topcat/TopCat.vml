#!/usr/bin/env vml
# ============================================================================
#   TopCat, this machine's side. The agent (tools/topcat/agent.py, running in
#   the background) answers TopCat's hub with this machine's apps: Bob, Pat...
#   through their API, never a raw shell. This window shows it at work: on or
#   off, how far a caller may go, who asked what, and a build's lines as they
#   come.
#
#   Made with Visualised.
# ============================================================================

@Window TopCat
Title=TopCat
Version=0.1
AppBar=true
Icon=topcat.png
TitleBar=Own
About=TopCat lets you (and Claude) ask your machines' apps for things from anywhere, safely.
BorderBrush=#374151
BorderThickness=2
Accent=#B45309
Width=760
Height=600
MinWidth=760
MinHeight=600
OnOpened=Opened

@Canvas c
Parent=TopCat
Background=#F3F4F6

@Canvas head
Parent=c
Canvas.Left=0
Canvas.Top=0
Width=760
Height=76
Background=#374151
Anchor=Top,Left,Right

@Image imgHat
Parent=head
Canvas.Left=14
Canvas.Top=8
Width=62
Height=62
Source=topcat.svg

@TextBlock lblName
Parent=head
Canvas.Left=86
Canvas.Top=8
Width=200
Height=36
FontSize=26
FontWeight=Bold
Foreground=#FFFFFF
Text=TopCat

@TextBlock lblWhat
Parent=head
Canvas.Left=86
Canvas.Top=44
Width=420
Height=22
Foreground=#D1D5DB
Text=your machines' apps, asked from anywhere

@CheckBox chkOn
Parent=head
Canvas.Left=500
Canvas.Top=12
Width=240
Height=28
Foreground=#FFFFFF
FontWeight=Bold
Content=Let TopCat in
ToolTip=On: this machine answers TopCat's hub (and starts doing so at login). Off: nobody can ask it anything.
OnClick=Toggle

@CheckBox chkBoot
Parent=head
Canvas.Left=500
Canvas.Top=42
Width=240
Height=26
Foreground=#D1D5DB
Content=Start with the computer, in the tray
OnClick=Boot

@Border dot
Parent=c
Canvas.Left=20
Canvas.Top=96
Width=14
Height=14
CornerRadius=7
Background=#9CA3AF

@TextBlock lblState
Parent=c
Canvas.Left=42
Canvas.Top=93
Width=278
Height=22
Foreground=#374151
Text=…

@Button btnLevel
Parent=c
Canvas.Left=330
Canvas.Top=88
Width=200
Height=30
FontWeight=Bold
Foreground=#FFFFFF
Background=#16A34A
Content=…
OnClick=LevelNext
ToolTip=Click to change. look: read only; look and do: change things here without asking; do and ask: anything, but what goes out or can't be undone needs your yes

@Button btnShell
Parent=c
Canvas.Left=540
Canvas.Top=88
Width=200
Height=30
FontWeight=Bold
Foreground=#FFFFFF
Background=#16A34A
Content=…
OnClick=ShellToggle
ToolTip=Click to change. Off; on for this session (until this computer restarts); always on. Even when on, every command needs your yes

@TextBlock lblAsked
Parent=c
Canvas.Left=20
Canvas.Top=128
Width=300
Height=22
FontWeight=Bold
Text=Who asked what

@DataGrid grdLog
Parent=c
Canvas.Left=20
Canvas.Top=152
Width=720
Height=190
Columns=Time,Who,Asked,Level,Answer
SelectionChanged=Picked
ToolTip=Pick a build to watch it
Anchor=Top,Left,Right

@TextBlock lblJob
Parent=c
Canvas.Left=20
Canvas.Top=352
Width=720
Height=22
FontWeight=Bold
Text=A build, as it goes (pick one above)

@ListBox lstJob
Parent=c
Canvas.Left=20
Canvas.Top=376
Width=720
Height=178
FontFamily=monospace
FontSize=12
Anchor=Top,Bottom,Left,Right

@Timer tmr
Parent=c
Interval=1500
IsEnabled=false
OnTick=Tick

@StatusBar StatusBar
Parent=c
Canvas.Left=0
Canvas.Top=566
Width=760
Height=32
Background=#E5E7EB
Anchor=Bottom,Left,Right
Panels=Ready

@Script Opened
Interpreter=lua
<<LUA
TopCat.Opened()
LUA

@Script Tick
Interpreter=lua
<<LUA
TopCat.Tick()
LUA

@Script Picked
Interpreter=lua
<<LUA
TopCat.Picked()
LUA

@Script Toggle
Interpreter=lua
<<LUA
TopCat.Toggle()
LUA

@Script LevelNext
Interpreter=lua
<<LUA
TopCat.LevelNext()
LUA

@Script Boot
Interpreter=lua
<<LUA
TopCat.Boot()
LUA

@Script ShellToggle
Interpreter=lua
<<LUA
TopCat.Shell()
LUA

@Script TopCatTray
Interpreter=lua
<<LUA
TopCat.Tray(args)
LUA

@Script TopCatJobDone
Interpreter=lua
<<LUA
TopCat.JobDone()
LUA
