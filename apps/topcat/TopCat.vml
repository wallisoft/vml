#!/usr/bin/env vml
# ============================================================================
#   TopCat, this machine's side. The agent (tools/topcat/agent.py, running in
#   the background) answers TopCat's hub with this machine's apps: Bob, Pat...
#   through their API, never a raw shell. This window shows it at work: on or
#   off, how far a caller may go, who asked what, and a build's lines as they
#   come.
#
#   Made with Visualised.
# ============================================================================

@Window TopCat
Title=TopCat
Version=0.2
AppBar=true
Icon=topcat.png
TitleBar=Own
About=TopCat lets you (and Claude) ask your machines' apps for things from anywhere, safely.
BorderBrush=#374151
BorderThickness=2
Accent=#B45309
Width=760
Height=600
MinWidth=760
MinHeight=600
OnOpened=Opened

@Canvas c
Parent=TopCat
Background=#F3F4F6

@Canvas head
Parent=c
Canvas.Left=0
Canvas.Top=0
Width=760
Height=76
Background=#374151
Anchor=Top,Left,Right

@Image imgHat
Parent=head
Canvas.Left=14
Canvas.Top=8
Width=62
Height=62
Source=topcat.svg

@TextBlock lblName
Parent=head
Canvas.Left=86
Canvas.Top=8
Width=200
Height=36
FontSize=26
FontWeight=Bold
Foreground=#FFFFFF
Text=TopCat

@TextBlock lblWhat
Parent=head
Canvas.Left=86
Canvas.Top=44
Width=420
Height=22
Foreground=#D1D5DB
Text=your machines' apps, asked from anywhere

@CheckBox chkOn
Parent=head
IsVisible=false
Canvas.Left=500
Canvas.Top=12
Width=240
Height=28
Foreground=#FFFFFF
FontWeight=Bold
Content=Let TopCat in
ToolTip=On: this machine answers TopCat's hub (and starts doing so at login). Off: nobody can ask it anything.
OnClick=Toggle

@CheckBox chkBoot
Parent=head
IsVisible=false
Canvas.Left=500
Canvas.Top=42
Width=240
Height=26
Foreground=#D1D5DB
Content=Start with the computer, in the tray
OnClick=Boot

@Button chkOnBtn
Parent=head
Canvas.Left=500
Canvas.Top=8
Width=34
Height=26
FontSize=18
FontWeight=Bold
Background=#374151
Content=✔
ToolTip=On: this machine answers TopCat's hub. Off: nobody can ask it anything.
BorderThickness=3
BorderBrush=#6B7280
OnClick=OnToggle

@TextBlock lblOn
Parent=head
Canvas.Left=542
Canvas.Top=12
Width=210
Height=22
FontWeight=Bold
Foreground=#E8EEF6
Text=Let TopCat in

@Button chkBootBtn
Parent=head
Canvas.Left=500
Canvas.Top=42
Width=34
Height=26
FontSize=18
FontWeight=Bold
Background=#374151
Content=✘
ToolTip=Start TopCat with the computer
BorderThickness=3
BorderBrush=#6B7280
OnClick=OnBoot

@TextBlock lblBoot
Parent=head
Canvas.Left=542
Canvas.Top=46
Width=220
Height=22
FontWeight=Bold
Foreground=#E8EEF6
Text=Start with the computer

@Border dot
Parent=c
Canvas.Left=20
Canvas.Top=96
Width=14
Height=14
CornerRadius=7
Background=#9CA3AF

@TextBlock lblState
Parent=c
Canvas.Left=42
Canvas.Top=93
Width=278
Height=22
Foreground=#374151
Text=…

@Button btnLevel
Parent=c
Canvas.Left=330
Canvas.Top=88
Width=200
Height=30
FontWeight=Bold
Foreground=#FFFFFF
Background=#16A34A
Content=…
OnClick=LevelNext
ToolTip=Click to change. look: read only; look and do: change things here without asking; do and ask: anything, but what goes out or can't be undone needs your yes

@Button btnShell
Parent=c
Canvas.Left=540
Canvas.Top=88
Width=200
Height=30
FontWeight=Bold
Foreground=#FFFFFF
Background=#16A34A
Content=…
OnClick=ShellToggle
ToolTip=Click to change. Off; on for this session (until this computer restarts); always on. Even when on, every command needs your yes

@TextBlock lblAsked
Parent=c
Canvas.Left=20
Canvas.Top=128
Width=300
Height=22
FontWeight=Bold
Text=Who asked what

@DataGrid grdLog
Parent=c
Canvas.Left=20
Canvas.Top=152
Width=720
Height=190
Columns=Time,Who,Asked,Level,Answer
SelectionMode=Extended
SelectionChanged=Picked
OnContextMenu=GridMenuShow
ToolTip=Pick a build to watch it — Ctrl/Shift-click for several; right-click for actions
Anchor=Top,Left,Right

@TextBlock lblJob
Parent=c
Canvas.Left=20
Canvas.Top=352
Width=470
Height=22
FontWeight=Bold
Text=Console output — pick a build above

@Button btnPause
Parent=c
Canvas.Left=502
Canvas.Top=348
Width=74
Height=26
FontWeight=Bold
Foreground=#FFFFFF
Background=#434A54
BorderThickness=2
BorderBrush=#6B7280
Content=Pause
IsEnabled=false
Anchor=Top,Right
OnClick=JobPause
ToolTip=Pause the build being watched; click again to resume

@Button btnKill
Parent=c
Canvas.Left=584
Canvas.Top=348
Width=74
Height=26
FontWeight=Bold
Foreground=#FFFFFF
Background=#434A54
BorderThickness=2
BorderBrush=#6B7280
Content=Kill
IsEnabled=false
Anchor=Top,Right
OnClick=JobKill
ToolTip=Stop the build being watched

@Button btnDel
Parent=c
Canvas.Left=666
Canvas.Top=348
Width=74
Height=26
FontWeight=Bold
Foreground=#FFFFFF
Background=#434A54
BorderThickness=2
BorderBrush=#6B7280
Content=Delete
IsEnabled=false
Anchor=Top,Right
OnClick=JobDel
ToolTip=Stop it if needed, then remove the build and its log

@ListBox lstJob
Parent=c
SelectionChanged=JobScroll
Canvas.Left=20
Canvas.Top=376
Width=720
Height=178
FontFamily=monospace
FontSize=12
Anchor=Top,Bottom,Left,Right

@Timer tmr
Parent=c
Interval=1500
IsEnabled=false
OnTick=Tick

@StatusBar StatusBar
Parent=c
Canvas.Left=0
Canvas.Top=566
Width=760
Height=32
Background=#E5E7EB
Anchor=Bottom,Left,Right
Panels=Ready

@ContextMenu gridMenu

@MenuItem mnuSelAll
Parent=gridMenu
Text=Select all
OnClick=SelAll

@MenuItem mnuSep1
Parent=gridMenu
IsSeparator=true

@MenuItem mnuPause
Parent=gridMenu
Text=Pause / resume
OnClick=JobPause

@MenuItem mnuKill
Parent=gridMenu
Text=Kill
OnClick=JobKill

@MenuItem mnuDel
Parent=gridMenu
Text=Delete
OnClick=JobDel

@Script Opened
Interpreter=lua
<<LUA
TopCat.Opened()
LUA

@Script Tick
Interpreter=lua
<<LUA
TopCat.Tick()
LUA

@Script Picked
Interpreter=lua
<<LUA
TopCat.Picked()
LUA

@Script Toggle
Interpreter=lua
<<LUA
TopCat.Toggle()
LUA

@Script LevelNext
Interpreter=lua
<<LUA
TopCat.LevelNext()
LUA

@Script Boot
Interpreter=lua
<<LUA
TopCat.Boot()
LUA

@Script OnToggle
Interpreter=lua
<<LUA
TopCat.OnToggle()
LUA

@Script OnBoot
Interpreter=lua
<<LUA
TopCat.OnBoot()
LUA


@Script ShellToggle
Interpreter=lua
<<LUA
TopCat.Shell()
LUA

@Script TopCatTray
Interpreter=lua
<<LUA
TopCat.Tray(args)
LUA

@Script TopCatJobDone
Interpreter=lua
<<LUA
TopCat.JobDone()
LUA

@Script TopCatExitDone
Interpreter=lua
<<LUA
TopCat.ExitDone()
LUA

@Script JobScroll
Interpreter=lua
<<LUA
TopCat.JobScroll()
LUA

@Script JobPause
Interpreter=lua
<<LUA
TopCat.JobPause()
LUA

@Script JobKill
Interpreter=lua
<<LUA
TopCat.JobKill()
LUA

@Script JobDel
Interpreter=lua
<<LUA
TopCat.JobDel()
LUA

@Script GridMenuShow
Interpreter=lua
<<LUA
TopCat.GridMenuShow()
LUA

@Script SelAll
Interpreter=lua
<<LUA
TopCat.SelAll()
LUA
