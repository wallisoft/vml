# ============================================================================
# The designer's code is not in this file. The designer is a Visualised project,
# designer/Designer.vmlproj, and what its menus and controls do is in the
# project's modules (designer/modules/*.lua): OnClick=FileSave runs the function
# FileSave in modules/files.lua. Open the project in the designer to see it whole.
# ============================================================================
