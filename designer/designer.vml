# ============================================================================
# VML Designer: the designer, designed in VML.
#
#   Right-click the form to add controls. Drag to move, drag the handles to
#   resize (hold Alt to ignore the grid), arrow keys nudge (Shift = a grid
#   step), Delete removes. The panel on the right edits whatever is selected;
#   click the empty form to edit the form itself.
# ============================================================================

@Window Designer
Title=Visualised
Width=1180
Height=760
OnOpened=DesignerInit
OnClosing=DesignerClosing

@DockPanel Root
Parent=Designer

@TinyMenu Menu
Parent=Root
DockPanel.Dock=Top

@Border StatusBar
Parent=Root
DockPanel.Dock=Bottom
Height=26
Background=#1E3A8A
Padding=10,0

@TextBlock statusText
Parent=StatusBar
Text=Ready
Foreground=#DBEAFE
FontSize=11
VerticalAlignment=Center

@DockPanel RightPane
Parent=Root
DockPanel.Dock=Right
Width=320

# The project: its forms, modules and databases (hidden until a project is open). Double-click to open one.
@DockPanel ProjectPane
Parent=RightPane
DockPanel.Dock=Top
Height=200
IsVisible=false

@Border ProjHeader
Parent=ProjectPane
DockPanel.Dock=Top
Background=#1E3A8A
Padding=10,5

@TextBlock ProjTitle
Parent=ProjHeader
Text=Project
Foreground=White
FontSize=12
FontWeight=Bold

@TreeView ProjTree
Parent=ProjectPane
BorderBrush=#E5E7EB
BorderThickness=1,0,0,1
FontSize=12
OnDoubleClick=ProjOpenItem
OnContextMenu=ProjShowMenu

# Drag the bar between the project tree and the properties to share the height between them.
@Splitter ProjSplit
Parent=RightPane
DockPanel.Dock=Top
Thickness=5
Background=#CBD5E1
MinSize=80
IsVisible=false

@Border PropsPane
Parent=RightPane
Background=#F9FAFB
BorderBrush=#E5E7EB
BorderThickness=1,0,0,0

@PropertyGrid Props
Parent=PropsPane

@DesignSurface Surface
Parent=Root
OnSelectionChanged=SelectionChanged
OnContextMenu=ShowSurfaceMenu
OnChanged=DesignChanged
OnDoubleClick=EditScriptOnClick
OnGeometry=ShowGeometry
OnMenuContextMenu=ShowMenuItemMenu

# ---------------------------------------------------------------- menus

