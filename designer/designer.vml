# ============================================================================
# VML Designer: the designer, designed in VML.
#
#   Right-click the form to add controls. Drag to move, drag the handles to
#   resize (hold Alt to ignore the grid), arrow keys nudge (Shift = a grid
#   step), Delete removes. The panel on the right edits whatever is selected;
#   click the empty form to edit the form itself.
# ============================================================================

@Window Designer
Title=VML Designer
Width=1180
Height=760
OnOpened=DesignerInit

@DockPanel Root
Parent=Designer

@TinyMenu Menu
Parent=Root
DockPanel.Dock=Top

@Border StatusBar
Parent=Root
DockPanel.Dock=Bottom
Height=26
Background=#1E3A8A
Padding=10,0

@TextBlock statusText
Parent=StatusBar
Text=Ready
Foreground=#DBEAFE
FontSize=11
VerticalAlignment=Center

@Border PropsPane
Parent=Root
DockPanel.Dock=Right
Width=320
Background=#F9FAFB
BorderBrush=#E5E7EB
BorderThickness=1,0,0,0

@PropertyGrid Props
Parent=PropsPane

@DesignSurface Surface
Parent=Root
OnSelectionChanged=SelectionChanged
OnContextMenu=ShowSurfaceMenu
OnChanged=DesignChanged
OnDoubleClick=EditScriptOnClick
OnGeometry=ShowGeometry
OnMenuContextMenu=ShowMenuItemMenu

# ---------------------------------------------------------------- menus

@MenuTheme Theme
Background=#1E3A8A
Foreground=White
HoverBackground=#2563EB
HoverForeground=White
PopupBackground=White
PopupBorder=#1E3A8A
Height=28

@MenuItem File
Parent=MenuBar
Text=File

@MenuItem FileNew
Parent=File
Text=New
Shortcut=Ctrl+N
OnClick=FileNew

@MenuItem FileOpen
Parent=File
Text=Open...
Shortcut=Ctrl+O
OnClick=FileOpen

@MenuItem FileSave
Parent=File
Text=Save
Shortcut=Ctrl+S
OnClick=FileSave

@MenuItem FileSaveAs
Parent=File
Text=Save As...
Shortcut=Ctrl+Shift+S
OnClick=FileSaveAs

@MenuItem FileExportHtml
Parent=File
Text=Export to HTML...
OnClick=ExportHtml

@MenuItem FileSep
Parent=File
IsSeparator=true

@MenuItem FileExit
Parent=File
Text=Exit
Shortcut=Ctrl+Q
OnClick=AppExit

@MenuItem Edit
Parent=MenuBar
Text=Edit

@MenuItem EditScript
Parent=Edit
Text=Edit Script...
Shortcut=Ctrl+E
OnClick=EditScript

@MenuItem EditMenus
Parent=Edit
Text=Menu Editor...
Shortcut=Ctrl+M
OnClick=OpenMenuEditor

@MenuItem EditDuplicate
Parent=Edit
Text=Duplicate
Shortcut=Ctrl+D
OnClick=DuplicateSelected

@MenuItem EditDelete
Parent=Edit
Text=Delete
Shortcut=Del
OnClick=DeleteSelected

@MenuItem EditSep
Parent=Edit
IsSeparator=true

@MenuItem EditFront
Parent=Edit
Text=Bring to Front
OnClick=BringSelectedToFront

@MenuItem EditBack
Parent=Edit
Text=Send to Back
OnClick=SendSelectedToBack

@MenuItem View
Parent=MenuBar
Text=View

@MenuItem ViewPreview
Parent=View
Text=Preview
Shortcut=F5
OnClick=Preview

@MenuItem ViewBrowser
Parent=View
Text=Preview in Browser
Shortcut=F6
OnClick=PreviewBrowser

@MenuItem ViewGrid
Parent=View
Text=Show Grid
OnClick=ToggleGrid

@MenuItem Help
Parent=MenuBar
Text=Help

@MenuItem HelpAbout
Parent=Help
Text=About
OnClick=About

# ---------------------------------------------------------------- right-click menu (Add is filled in from the registry)

@ContextMenu SurfaceMenu

@MenuItem CtxAdd
Parent=SurfaceMenu
Text=Add

@MenuItem CtxAddMenu
Parent=SurfaceMenu
Text=Add Menu
OnClick=AddMenu

@MenuItem CtxMenus
Parent=SurfaceMenu
Text=Menu Editor...
OnClick=OpenMenuEditor

@MenuItem CtxSep
Parent=SurfaceMenu
IsSeparator=true

@MenuItem CtxEditScript
Parent=SurfaceMenu
Text=Edit Script...
OnClick=EditScript

@MenuItem CtxDuplicate
Parent=SurfaceMenu
Text=Duplicate
OnClick=DuplicateSelected

@MenuItem CtxFront
Parent=SurfaceMenu
Text=Bring to Front
OnClick=BringSelectedToFront

@MenuItem CtxBack
Parent=SurfaceMenu
Text=Send to Back
OnClick=SendSelectedToBack

@MenuItem CtxDelete
Parent=SurfaceMenu
Text=Delete
OnClick=DeleteSelected

# ---------------------------------------------------------------- right-click on a menu item

@ContextMenu MenuItemMenu

@MenuItem MiAddBefore
Parent=MenuItemMenu
Text=Add Item Before
OnClick=MenuAddBefore

@MenuItem MiAddAfter
Parent=MenuItemMenu
Text=Add Item After
OnClick=MenuAddAfter

@MenuItem MiAddChild
Parent=MenuItemMenu
Text=Add Submenu Item
OnClick=MenuAddChild

@MenuItem MiSep1
Parent=MenuItemMenu
IsSeparator=true

@MenuItem MiScript
Parent=MenuItemMenu
Text=Edit Script...
OnClick=EditScript

@MenuItem MiDelete
Parent=MenuItemMenu
Text=Delete
OnClick=DeleteSelected

@MenuItem MiSep2
Parent=MenuItemMenu
IsSeparator=true

@MenuItem MiEditor
Parent=MenuItemMenu
Text=Menu Editor...
OnClick=OpenMenuEditor

@ContextMenu MenuBarMenu

@MenuItem MbAdd
Parent=MenuBarMenu
Text=Add Menu
OnClick=MenuBarAdd

@MenuItem MbEditor
Parent=MenuBarMenu
Text=Menu Editor...
OnClick=OpenMenuEditor

@MenuItem MbSep
Parent=MenuBarMenu
IsSeparator=true

@MenuItem MbRemove
Parent=MenuBarMenu
Text=Remove Menu Bar
OnClick=MenuBarRemove

# ============================================================================ scripts

@Script DesignerInit
Interpreter=lua
<<LUA
local json = require("dkjson")
local category = ""
for _, t in ipairs(json.decode(Vml("GetControlTypes"))) do
    if t.category ~= category and category ~= "" then
        local sep = "AddSep_" .. t.category
        Vml("CreateControl", "MenuItem", sep, "CtxAdd")
        Vml("SetProperty", sep, "IsSeparator", "true")
    end
    category = t.category
    local item = "Add_" .. t.name
    Vml("CreateControl", "MenuItem", item, "CtxAdd")
    Vml("SetProperty", item, "Text", t.name)
    Vml("SetEvent", item, "OnClick", "AddControl(" .. t.name .. ")")
end
Vml("SetSetting", "current_file", "")
Vml("SetSetting", "dirty", "false")
Vml("SetProperty", "Props", "Target", "Surface")
Vml("SetStatusText", "Right-click the form to add a control")
LUA

@Script AddControl
Interpreter=lua
<<LUA
local name = Vml("AddDesignControl", args[1], Vml("GetSetting", "click_x"), Vml("GetSetting", "click_y"))
if name ~= "" then Vml("SetStatusText", "Added " .. name) end
LUA

@Script ShowSurfaceMenu
Interpreter=lua
<<LUA
local selected = Vml("GetProperty", "Surface", "Selected") ~= ""
for _, item in ipairs({"CtxEditScript", "CtxDuplicate", "CtxFront", "CtxBack", "CtxDelete"}) do
    Vml("SetMenuItemEnabled", item, selected)
end
Vml("SetMenuItemEnabled", "CtxAddMenu", Vml("GetDesignMenu", "Surface") == "[]")
Vml("ShowContextMenu", "SurfaceMenu")
LUA

@Script SelectionChanged
Interpreter=lua
<<LUA
local sel = Vml("GetProperty", "Surface", "Selected")
Vml("SetProperty", "Props", "Target", sel ~= "" and sel or "Surface")
Vml("RunScript", "ShowGeometry")
LUA

@Script DesignChanged
Interpreter=lua
<<LUA
Vml("SetSetting", "dirty", "true")
Vml("RunScript", "UpdateTitle")
Vml("RunScript", "ShowGeometry")
LUA

@Script UpdateTitle
Interpreter=lua
<<LUA
local file = Vml("GetSetting", "current_file")
local name = file ~= "" and file:match("([^/\\]+)$") or "Untitled"
local star = Vml("GetSetting", "dirty") == "true" and " *" or ""
Vml("SetProperty", "Designer", "Title", "VML Designer - " .. name .. star)
LUA

@Script EditScript
Interpreter=lua
<<LUA
-- open the script editor (itself a VML form) for the selected control
local sel = Vml("GetProperty", "Surface", "Selected")
if sel == "" then return Vml("SetStatusText", "Select a control first") end
Vml("SetSetting", "editor_control", sel)
Vml("SetSetting", "editor_event", args[1] or "")
Vml("FormOpenModal", "script-editor.vml")
Vml("RunScript", "SelectionChanged")
LUA

@Script ShowMenuItemMenu
Interpreter=lua
<<LUA
-- the bar's empty space has its own menu; items have theirs
if Vml("GetProperty", "Surface", "Selected") == "menubar" then
    Vml("ShowContextMenu", "MenuBarMenu")
else
    Vml("ShowContextMenu", "MenuItemMenu")
end
LUA

@Script MenuBarAdd
Interpreter=lua
<<LUA
Vml("MenuAddItem", "menubar", "end")
LUA

@Script MenuBarRemove
Interpreter=lua
<<LUA
if Vml("ConfirmDialog", "Remove the whole menu bar and its scripts?", "Menu") == "true" then
    Vml("SetDesignMenu", "Surface", "[]")
    Vml("SetProperty", "Surface", "Selected", "")
    Vml("RunScript", "SelectionChanged")
end
LUA

@Script AddMenu
Interpreter=lua
<<LUA
Vml("MenuAddItem", "", "first")
LUA

@Script MenuAddBefore
Interpreter=lua
<<LUA
Vml("MenuAddItem", Vml("GetProperty", "Surface", "Selected"), "before")
LUA

@Script MenuAddAfter
Interpreter=lua
<<LUA
Vml("MenuAddItem", Vml("GetProperty", "Surface", "Selected"), "after")
LUA

@Script MenuAddChild
Interpreter=lua
<<LUA
Vml("MenuAddItem", Vml("GetProperty", "Surface", "Selected"), "child")
LUA

@Script OpenMenuEditor
Interpreter=lua
<<LUA
-- the Menu Editor is a VML form too
Vml("FormOpenModal", "menu-editor.vml")
Vml("RunScript", "SelectionChanged")
LUA

@Script EditScriptOnClick
Interpreter=lua
<<LUA
-- double-click: straight to the control's click script, as in VB
Vml("RunScript", "EditScript", "OnClick")
LUA

@Script ShowGeometry
Interpreter=lua
<<LUA
-- live position and size on the status bar (runs while dragging, resizing and nudging)
local sel = Vml("GetProperty", "Surface", "Selected")
if sel == "menubar" then
    Vml("SetStatusText", "Menu bar    right-click for Add Menu / Remove Menu Bar")
elseif sel:sub(1, 5) == "menu:" then
    Vml("SetStatusText", "Menu item " .. sel:sub(6) .. "    right-click for Add / Delete / Edit Script")
elseif sel == "" then
    Vml("SetStatusText", string.format("Form    %s x %s", Vml("GetProperty", "Surface", "FormWidth"),
        Vml("GetProperty", "Surface", "FormHeight")))
else
    Vml("SetStatusText", string.format("%s  (%s)    X %s   Y %s    W %s   H %s", sel, Vml("GetControlType", sel),
        Vml("GetControlX", sel), Vml("GetControlY", sel), Vml("GetControlWidth", sel), Vml("GetControlHeight", sel)))
end
LUA

@Script DeleteSelected
Interpreter=lua
<<LUA
local sel = Vml("GetProperty", "Surface", "Selected")
if sel == "" then return end
if sel == "menubar" then return Vml("RunScript", "MenuBarRemove") end
if sel:sub(1, 5) == "menu:" then
    Vml("MenuDeleteItem", sel)
    Vml("SetStatusText", "Deleted " .. sel:sub(6))
    return
end
Vml("DeleteControl", sel)
Vml("SetProperty", "Surface", "Selected", "")
Vml("RunScript", "SelectionChanged")
Vml("RunScript", "DesignChanged")
Vml("SetStatusText", "Deleted " .. sel)
LUA

@Script DuplicateSelected
Interpreter=lua
<<LUA
local sel = Vml("GetProperty", "Surface", "Selected")
if sel ~= "" then Vml("DuplicateControl", sel) end
LUA

@Script BringSelectedToFront
Interpreter=lua
<<LUA
local sel = Vml("GetProperty", "Surface", "Selected")
if sel ~= "" then Vml("BringToFront", sel) end
LUA

@Script SendSelectedToBack
Interpreter=lua
<<LUA
local sel = Vml("GetProperty", "Surface", "Selected")
if sel ~= "" then Vml("SendToBack", sel) end
LUA

@Script FileNew
Interpreter=lua
<<LUA
if Vml("GetSetting", "dirty") == "true" and Vml("ConfirmDialog", "Discard the current form?") ~= "true" then return end
Vml("ClearDesign", "Surface")
Vml("SetSetting", "current_file", "")
Vml("SetSetting", "dirty", "false")
Vml("RunScript", "SelectionChanged")
Vml("RunScript", "UpdateTitle")
LUA

@Script FileOpen
Interpreter=lua
<<LUA
local path = Vml("FileOpenDialog", "Open a VML form", "vml")
if path == "" then return end
if Vml("ImportVml", path, "Surface") == "true" then
    Vml("SetSetting", "current_file", path)
    Vml("SetSetting", "dirty", "false")
    Vml("RunScript", "SelectionChanged")
    Vml("RunScript", "UpdateTitle")
    Vml("SetStatusText", "Opened " .. path)
else
    Vml("InfoDialog", "That form is laid out with panels rather than on a canvas, so it can't be edited here yet.")
end
LUA

@Script FileSave
Interpreter=lua
<<LUA
local path = Vml("GetSetting", "current_file")
if path == "" then return Vml("RunScript", "FileSaveAs") end
Vml("ExportVml", "Surface", path)
Vml("SetSetting", "dirty", "false")
Vml("RunScript", "UpdateTitle")
Vml("SetStatusText", "Saved " .. path)
LUA

@Script FileSaveAs
Interpreter=lua
<<LUA
local path = Vml("FileSaveDialog", "Save the form as", Vml("GetProperty", "Surface", "FormName"), "vml")
if path == "" then return end
Vml("SetSetting", "current_file", path)
Vml("RunScript", "FileSave")
LUA

@Script Preview
Interpreter=lua
<<LUA
Vml("PreviewDesign", "Surface")
Vml("SetStatusText", "Previewing " .. Vml("GetProperty", "Surface", "FormName"))
LUA

@Script PreviewBrowser
Interpreter=lua
<<LUA
-- the same form, as a web page, in your browser
local path = Vml("PreviewInBrowser", "Surface")
Vml("SetStatusText", "Opened in your browser: " .. path)
LUA

@Script ExportHtml
Interpreter=lua
<<LUA
local path = Vml("FileSaveDialog", "Export as a web page", Vml("GetProperty", "Surface", "FormName"), "html")
if path == "" then return end
Vml("ExportHtml", "Surface", path)
Vml("SetStatusText", "Web page written: " .. path)
LUA

@Script ToggleGrid
Interpreter=lua
<<LUA
local on = Vml("GetProperty", "Surface", "ShowGrid") ~= "false"
Vml("SetProperty", "Surface", "ShowGrid", on and "false" or "true")
LUA

@Script About
Interpreter=lua
<<LUA
Vml("InfoDialog", "VML Designer\n\nThe designer is itself a VML form: designer.vml.\nEngine: VML for Qt.", "About")
LUA
