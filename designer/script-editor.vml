# ============================================================================
# Script editor: opened by the designer (double-click a control, or
# right-click > Edit Script...). Pick an event, pick Lua or the OS shell,
# write the script. Switching event keeps what you wrote for the last one.
# The code is a CodeEditor (vml/codeedit.py): line numbers, colours, and a
# click in the margin for a breakpoint (the debugger's Stepping tab).
# ============================================================================

@Window ScriptEditor
Title=Edit Script
BorderBrush=#1E3A8A
Width=900
Height=620
OnOpened=EditorLoad

@DockPanel EdRoot
Parent=ScriptEditor

@Border EdHeader
Parent=EdRoot
DockPanel.Dock=Top
Background=#1E3A8A
Padding=12,8

@Grid EdHeaderGrid
Parent=EdHeader
ColumnDefinitions=Auto,*,Auto,140,Auto,180

@TextBlock lblControl
Parent=EdHeaderGrid
Grid.Column=0
Text=Control
FontSize=14
FontWeight=Bold
Foreground=White
VerticalAlignment=Center

@TextBlock lblEvent
Parent=EdHeaderGrid
Grid.Column=2
Text=Event
Foreground=#DBEAFE
VerticalAlignment=Center
Margin=0,0,8,0

@ComboBox cboEvent
Parent=EdHeaderGrid
Grid.Column=3
SelectionChanged=EditorEventChanged

@TextBlock lblLang
Parent=EdHeaderGrid
Grid.Column=4
Text=Language
Foreground=#DBEAFE
VerticalAlignment=Center
Margin=16,0,8,0

@ComboBox cboLang
Parent=EdHeaderGrid
Grid.Column=5
SelectionChanged=EditorLangChanged

@Border EdFooter
Parent=EdRoot
DockPanel.Dock=Bottom
Background=#F3F4F6
BorderBrush=#E5E7EB
BorderThickness=0,1,0,0
Padding=12,8

@StackPanel EdButtons
Parent=EdFooter
Orientation=Horizontal
Spacing=8

@TextBlock lblHint
Parent=EdButtons
Text=Click the margin for a breakpoint. Tab indents, Ctrl+/ comments, Ctrl+F finds.
Foreground=#6B7280
FontSize=11
VerticalAlignment=Center

@Button btnRemove
Parent=EdButtons
Content=Remove Script
Padding=10,5
OnClick=EditorRemove

@Button btnCancel
Parent=EdButtons
Content=Cancel
Padding=14,5
OnClick=CloseSelf

@Button btnSave
Parent=EdButtons
Content=Save
Background=#2563EB
Foreground=White
Padding=18,5
OnClick=EditorSave

@CodeEditor txtCode
Parent=EdRoot
Language=Lua
BreakpointsChanged=EditorBreaks

# ============================================================================ scripts

@Script EditorLoad
Interpreter=lua
<<LUA
local json = require("dkjson")
local ctrl = Vml("GetSetting", "editor_control")
local shown = ctrl == "Surface" and "Form" or ctrl
Vml("SetProperty", "ScriptEditor", "Title", "Edit Script - " .. shown)
Vml("SetProperty", "lblControl", "Text", ctrl == "Surface" and "Form  (the window itself)" or (ctrl .. "  (" .. Vml("GetControlType", ctrl) .. ")"))
local names = {}
for _, e in ipairs(json.decode(Vml("GetControlEvents", ctrl))) do
    names[#names + 1] = e.name
end
Vml("SetProperty", "cboEvent", "Items", table.concat(names, ","))
Vml("SetProperty", "cboLang", "Items", table.concat(json.decode(Vml("GetLanguages")), ","))   -- all five: one not ready says what it needs
local wanted, chosen = Vml("GetSetting", "editor_event"), names[1]
for _, n in ipairs(names) do if n == wanted then chosen = n end end
Vml("SetProperty", "cboEvent", "SelectedItem", chosen)
Vml("SetProperty", "txtCode", "ObjectModel", Vml("ObjectModel", "Surface"))   -- the form's controls, for member completion
Vml("SetSetting", "editor_loaded_event", "")
Vml("RunScript", "EditorEventChanged")
LUA

@Script EditorEventChanged
Interpreter=lua
<<LUA
local json = require("dkjson")
local ctrl = Vml("GetSetting", "editor_control")
-- keep what was typed for the event we're leaving
local previous = Vml("GetSetting", "editor_loaded_event")
if previous ~= "" then Vml("RunScript", "EditorStore", previous) end
local event = Vml("GetProperty", "cboEvent", "SelectedItem")
local s = json.decode(Vml("GetDesignScript", ctrl, event))
local langs = json.decode(Vml("GetLanguages"))
local chosen = langs[1]
for _, l in ipairs(langs) do if l:sub(1, #s.language) == s.language then chosen = l end end
Vml("SetSetting", "editor_lang_quiet", "1")              -- (choosing it here isn't asking to set it up)
Vml("SetProperty", "cboLang", "SelectedItem", chosen)
Vml("SetSetting", "editor_lang_quiet", "")
local code = s.code
if code == "" then code = Vml("RunScript", "EditorStarter", chosen, ctrl, event) end
Vml("SetProperty", "txtCode", "Text", code)
Vml("SetProperty", "txtCode", "Language", ((chosen:match("^(%S+)") or "Lua"):gsub("#", "Sharp")))
Vml("SetSetting", "editor_code_lang", (chosen:match("^(%S+)") or "Lua"))
-- the breakpoints this script has (by the name it runs under: Form_OnOpened, btnGo_OnClick...)
local script = s.script ~= "" and s.script or (ctrl == "Surface" and ("Form_" .. event) or (ctrl .. "_" .. event))
Vml("SetSetting", "editor_script", script)
local marks = (json.decode(Vml("DebugBreaks")) or {})[script] or {}
local shown = {}
for _, n in ipairs(marks) do shown[#shown + 1] = tostring(n) end
Vml("SetProperty", "txtCode", "Breakpoints", table.concat(shown, ", "))
Vml("SetProperty", "btnRemove", "IsEnabled", s.code ~= "" and "true" or "false")
Vml("SetSetting", "editor_loaded_event", event)
Vml("SetSetting", "editor_original", code)
LUA

@Script EditorBreaks
Interpreter=lua
<<LUA
-- a click in the margin: the engine's breakpoints for this script follow (the debugger's Stepping tab shows them too)
local json = require("dkjson")
local all = json.decode(Vml("DebugBreaks")) or {}
local lines = {}
for n in (Vml("GetProperty", "txtCode", "Breakpoints") or ""):gmatch("%d+") do lines[#lines + 1] = tonumber(n) end
all[Vml("GetSetting", "editor_script")] = #lines > 0 and lines or nil
Vml("DebugBreaks", json.encode(all))
Vml("SetProperty", "lblHint", "Text", #lines > 0 and (#lines .. " breakpoint" .. (#lines == 1 and "" or "s") ..
    " here: run the form (F5) and it stops there, with the debugger showing where") or
    "Click the margin for a breakpoint. Tab indents, Ctrl+/ comments, Ctrl+F finds.")
LUA

@Script EditorLangChanged
Interpreter=lua
<<LUA
-- a language that isn't there yet, chosen: offer to set it up (it says so in the list when it's ready)
local chosen = Vml("GetProperty", "cboLang", "SelectedItem") or ""
if chosen:find("(needs", 1, true) and Vml("GetSetting", "editor_lang_quiet") ~= "1" then
    Vml("SetUpLanguage", chosen)
end
local newlang = chosen:match("^(%S+)") or "Lua"
local oldlang = Vml("GetSetting", "editor_code_lang")
if oldlang == "" then oldlang = "Lua" end
local code = Vml("GetProperty", "txtCode", "Text")
local ctrl, event = Vml("GetSetting", "editor_control"), Vml("GetProperty", "cboEvent", "SelectedItem")
if code == Vml("GetSetting", "editor_original") then
    -- nothing written yet: just swap the starter comment to the new language
    code = Vml("RunScript", "EditorStarter", chosen, ctrl, event)
    Vml("SetProperty", "txtCode", "Text", code)
    Vml("SetSetting", "editor_original", code)
elseif newlang ~= oldlang then
    -- real code: translate it from the old language to the new one
    local translated = Vml("TranslateScript", code, oldlang, newlang)
    if translated ~= "" then
        Vml("SetProperty", "txtCode", "Text", translated)
        Vml("SetProperty", "lblHint", "Text", "Translated " .. oldlang .. " to " .. newlang .. ": funcs and Vml() calls carry cleanly; check any fancy logic")
    else
        Vml("SetProperty", "lblHint", "Text", oldlang .. " and " .. newlang .. " don't translate between each other (a shell is its own thing) - the script is unchanged")
    end
end
Vml("SetProperty", "txtCode", "Language", (newlang:gsub("#", "Sharp")))
Vml("SetSetting", "editor_code_lang", newlang)
LUA

@Script EditorStarter
Interpreter=lua
<<LUA
-- a first line for a new script, in the chosen language
local lang, ctrl, event = args[1], args[2], args[3]
if lang:sub(1, 2) == "C#" then
    return "// " .. ctrl .. " " .. event .. "  (Vml(...), args and State are available)\n\n"
elseif lang:sub(1, 6) == "Python" then
    return "# " .. ctrl .. " " .. event .. "  (Vml(...) and args are available)\n\n"
elseif lang:sub(1, 10) == "PowerShell" then
    return "# " .. ctrl .. " " .. event .. "  (vml Command ... calls back; $args are the arguments)\n\n"
elseif lang:sub(1, 4) == "Bash" or lang:sub(1, 5) == "Shell" then
    return "# " .. ctrl .. " " .. event .. "  (vml Command ... calls back; $1, $2 are the arguments)\n\n"
end
return "-- " .. ctrl .. " " .. event .. "\n\n"
LUA

@Script EditorStore
Interpreter=lua
<<LUA
-- save the editor's text as the script for one event, unless it's still just the starter comment
local event = args[1]
local code = Vml("GetProperty", "txtCode", "Text")
if code == Vml("GetSetting", "editor_original") then return end
local lang = Vml("GetProperty", "cboLang", "SelectedItem"):match("^(%S+)")      -- "Lua", "Shell" or "C#"
Vml("SetDesignScript", Vml("GetSetting", "editor_control"), event, lang, code)
LUA

@Script EditorSave
Interpreter=lua
<<LUA
Vml("RunScript", "EditorStore", Vml("GetProperty", "cboEvent", "SelectedItem"))
Vml("CloseSelf")
LUA

@Script EditorRemove
Interpreter=lua
<<LUA
local ctrl, event = Vml("GetSetting", "editor_control"), Vml("GetProperty", "cboEvent", "SelectedItem")
if Vml("ConfirmDialog", "Remove the " .. event .. " script from " .. ctrl .. "?") == "true" then
    Vml("SetDesignScript", ctrl, event, "Lua", "")
    Vml("SetSetting", "editor_loaded_event", "")
    Vml("RunScript", "EditorEventChanged")
end
LUA
