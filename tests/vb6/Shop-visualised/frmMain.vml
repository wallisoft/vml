# frmMain: imported from frmMain.frm (Visual Basic 5/6)

@Window frmMain
Title=Corner Shop - Orders
Width=600
Height=439
OnOpened=frmMain_OnOpened
OnClosing=frmMain_OnClosing

@DockPanel frmMainRoot
Parent=frmMain

@TinyMenu frmMainMenu
Parent=frmMainRoot
DockPanel.Dock=Top

@Canvas frmMainCanvas
Parent=frmMainRoot
Background=#ffe0c0

@MenuItem mnuFile
Parent=MenuBar
Text=File

@MenuItem mnuFileNew
Parent=mnuFile
Text=New Order
Shortcut=Ctrl+N
OnClick=mnuFileNew_OnClick

@MenuItem mnuFileRecent
Parent=mnuFile
Text=Recent

@MenuItem mnuRecent_0
Parent=mnuFileRecent
Text=Smith & Sons
OnClick=mnuRecent_OnClick

@MenuItem mnuRecent_1
Parent=mnuFileRecent
Text=Patel's
OnClick=mnuRecent_OnClick

@MenuItem mnuFileSep
Parent=mnuFile
IsSeparator=true

@MenuItem mnuFileExit
Parent=mnuFile
Text=Exit
Shortcut=Ctrl+F4
OnClick=mnuFileExit_OnClick

@MenuItem mnuEdit
Parent=MenuBar
Text=Edit

@MenuItem mnuEditDelete
Parent=mnuEdit
Text=Delete Line
Shortcut=Del
IsEnabled=false

@MenuItem mnuHelp
Parent=MenuBar
Text=Help

@MenuItem mnuHelpContents
Parent=mnuHelp
Text=Contents
Shortcut=F1

@MenuItem mnuHelpTips
Parent=mnuHelp
Text=Show Tips
Shortcut=Shift+F1

@MenuItem mnuHelpAbout
Parent=mnuHelp
Text=About "Corner Shop"...
OnClick=mnuHelpAbout_OnClick

@TextBlock lblCustomer
Parent=frmMainCanvas
Canvas.Left=56
Canvas.Top=42
Width=45
Height=17
Text=Customer:
TextWrapping=Wrap
FontSize=11

@TextBlock lblTotal
Parent=frmMainCanvas
Canvas.Left=200
Canvas.Top=186
Width=81
Height=17
Text=Total (£):
TextWrapping=Wrap
Background=#ffffe1
Foreground=#000080
FontFamily=Arial
FontSize=16
FontWeight=Bold
TextAlignment=Right

@TextBlock lblStatus
Parent=frmMainCanvas
Canvas.Left=16
Canvas.Top=380
Width=200
Height=17
Text=Saved
TextWrapping=Wrap
FontSize=11
TextAlignment=Center
IsVisible=false

@Image imgLogo
Parent=frmMainCanvas
Canvas.Left=16
Canvas.Top=40
Width=32
Height=32
Stretch=Fill
OnPointerPressed=imgLogo_OnPointerPressed

@Rectangle linRule
Parent=frmMainCanvas
Canvas.Left=16
Canvas.Top=248
Width=568
Height=1
Fill=#808080

@Frame fraDelivery
Parent=frmMainCanvas
Canvas.Left=104
Canvas.Top=68
Width=273
Height=41
Text=Delivery
FontSize=11

@RadioButton optStandard
Parent=fraDelivery
Canvas.Left=8
Canvas.Top=16
Width=81
Height=17
Content=Standard
IsChecked=true
FontSize=11

@RadioButton optExpress
Parent=fraDelivery
Canvas.Left=96
Canvas.Top=16
Width=81
Height=17
Content=Express
FontSize=11

@CheckBox chkGift
Parent=fraDelivery
Canvas.Left=184
Canvas.Top=16
Width=81
Height=17
Content=Gift wrap
IsChecked=true
FontSize=11
OnClick=chkGift_OnClick

@TextBox txtCustomer
Parent=frmMainCanvas
Canvas.Left=104
Canvas.Top=40
Width=273
Height=21
FontSize=11
ToolTip=Who the order is for ('Mr' or "Mrs" too)
TextChanged=txtCustomer_TextChanged
OnKeyDown=txtCustomer_OnKeyDown

@TextBox txtNotes
Parent=frmMainCanvas
Canvas.Left=104
Canvas.Top=112
Width=273
Height=65
AcceptsReturn=true
FontSize=11

@TextBox txtTotal
Parent=frmMainCanvas
Canvas.Left=288
Canvas.Top=184
Width=89
Height=21
Text=0.00
IsReadOnly=true
FontSize=11

@TextBox txtPin
Parent=frmMainCanvas
Canvas.Left=104
Canvas.Top=184
Width=80
Height=21
IsPassword=true
FontSize=11
OnKeyDown=txtPin_OnKeyDown

@ComboBox cboCategory
Parent=frmMainCanvas
Canvas.Left=400
Canvas.Top=40
Width=184
Height=21
FontSize=11
SelectionChanged=cboCategory_SelectionChanged

@ListBox lstProducts
Parent=frmMainCanvas
Canvas.Left=400
Canvas.Top=64
Width=184
Height=134
FontSize=11
SelectionChanged=lstProducts_SelectionChanged
OnDoubleClick=lstProducts_OnDoubleClick

@Button cmdDelete
Parent=frmMainCanvas
Canvas.Left=504
Canvas.Top=216
Width=80
Height=25
Content=Delete
Background=#ff8080
FontSize=11
IsEnabled=false

@Button cmdQty_0
Parent=frmMainCanvas
Canvas.Left=16
Canvas.Top=216
Width=65
Height=25
Content=+1
FontSize=11
OnClick=cmdQty_OnClick

@Button cmdQty_1
Parent=frmMainCanvas
Canvas.Left=88
Canvas.Top=216
Width=65
Height=25
Content=+5
FontSize=11
OnClick=cmdQty_OnClick

@Button cmdQty_2
Parent=frmMainCanvas
Canvas.Left=160
Canvas.Top=216
Width=65
Height=25
Content=+10
FontSize=11
OnClick=cmdQty_OnClick

@Frame picToolbar
Parent=frmMainCanvas
Canvas.Left=0
Canvas.Top=0
Width=600
Height=32
FontSize=11

@Button cmdRefresh
Parent=picToolbar
Canvas.Left=8
Canvas.Top=4
Width=80
Height=24
Content=Refresh
FontSize=11
OnClick=cmdRefresh_OnClick

@DataGrid grdOrders
Parent=frmMainCanvas
Canvas.Left=16
Canvas.Top=256
Width=568
Height=108
Columns=Product,Qty,Price
FontSize=11
OnDoubleClick=grdOrders_OnDoubleClick

@Frame sldDiscount
Parent=frmMainCanvas
Canvas.Left=400
Canvas.Top=376
Width=184
Height=26
Text=Slider: sldDiscount
Background=#fafafa
BorderBrush=#9ca3af
BorderThickness=1
FontSize=11

